FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY src/presence/package.json src/presence/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund --fetch-retries=1
COPY src/presence/ ./src/presence/
ARG TOWN_REHEARSAL_BUILD=off
RUN set -eu; \
    entry=src/presence/index.ts; \
    if [ "$TOWN_REHEARSAL_BUILD" = on ]; then entry=src/presence/index-rehearsal.ts; fi; \
    ./node_modules/.bin/tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --rootDir src --outDir dist/server "$entry"; \
    if [ "$TOWN_REHEARSAL_BUILD" = on ]; then mv dist/server/presence/index-rehearsal.js dist/server/presence/index.js; fi

FROM node:22-bookworm-slim
ARG TOWN_RELEASE=local
LABEL org.opencontainers.image.revision=${TOWN_RELEASE}
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules/ws/ ./node_modules/ws/
COPY --from=build /app/dist/server/presence/ ./dist/server/presence/
USER node
EXPOSE 8090
CMD ["node", "dist/server/presence/index.js"]
