FROM node:22-bookworm-slim AS build
WORKDIR /app/tools/voxel-tavern
COPY tools/voxel-tavern/package.json tools/voxel-tavern/package-lock.json ./
RUN npm ci
COPY docs/p0-layout-draft.json /app/docs/p0-layout-draft.json
COPY tools/voxel-tavern/ ./
RUN npm run build -- --mode town-preview

FROM caddy:2-alpine
ARG TOWN_RELEASE=local
ENV TOWN_RELEASE=${TOWN_RELEASE}
LABEL org.opencontainers.image.revision=${TOWN_RELEASE}
COPY --from=build /app/tools/voxel-tavern/dist/ /srv/
COPY tools/Caddyfile.town-preview /etc/caddy/Caddyfile
