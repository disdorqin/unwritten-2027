FROM node:22-bookworm-slim AS build
WORKDIR /app/tools/voxel-tavern
COPY tools/voxel-tavern/package.json tools/voxel-tavern/package-lock.json ./
# The preview uses published builds; the upstream protocol's installer requires pnpm in its own source repo.
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY docs/p0-layout-draft.json /app/docs/p0-layout-draft.json
COPY tools/voxel-tavern/ ./
COPY src/presence/ /app/src/presence/
COPY src/shared/ /app/src/shared/
ARG TOWN_REHEARSAL_BUILD=off
RUN if [ "$TOWN_REHEARSAL_BUILD" = on ]; then npm run build -- --mode town-rehearsal; \
    else npm run build -- --mode town-preview; fi

FROM caddy:2-alpine
ARG TOWN_RELEASE=local
ENV TOWN_RELEASE=${TOWN_RELEASE}
LABEL org.opencontainers.image.revision=${TOWN_RELEASE}
COPY --from=build /app/tools/voxel-tavern/dist/ /srv/
COPY public/models/post-office.glb public/models/clocktower.glb public/models/tavern.glb /srv/models/
COPY tools/Caddyfile.town-preview /etc/caddy/Caddyfile
