{$TOWN_PREVIEW_SITE:town.disdorqin.cn} {
    encode zstd gzip
    root * /srv
    respond /healthz "town-preview {$TOWN_RELEASE:local}" 200
    @mountain path /presence-mountain /presence-mountain/*
    handle @mountain {
        uri replace /presence-mountain /presence
        reverse_proxy presence:8091
    }
    @western path /presence-west /presence-west/*
    handle @western {
        uri replace /presence-west /presence
        reverse_proxy presence:8092
    }
    @townPresence path /presence /presence/*
    reverse_proxy @townPresence presence:8090
    @entry path / /town-blockout.html
    header @entry Cache-Control "no-cache"
    rewrite / /town-blockout.html
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    file_server
}
