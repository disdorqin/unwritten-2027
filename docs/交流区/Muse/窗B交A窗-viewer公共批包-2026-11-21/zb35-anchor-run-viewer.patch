+function anchorRunAction() {
+  const phase = presence.getTownNightWindow()?.phase;
+  if (phase !== 'night-window') return undefined;
+  for (const site of anchorRing) {
+    if (Math.hypot(x - site.east, n - site.north) <= 1.6) {
+      return { label: '点亮锚点', run: () => {
+        const outcome = anchorRun.touch(site.id, phase);
+        if (outcome === 'finished') announceActivity('五环齐亮——今夜的跑图完赛了。', true);
+        else if (outcome === 'stepped-back') announceActivity('摸错了环，上一站熄了。');
