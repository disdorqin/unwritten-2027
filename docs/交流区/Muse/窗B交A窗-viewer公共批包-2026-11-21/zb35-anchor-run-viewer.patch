+function syncAnchorRun() {
+  const night = anchorNightIndex(Date.now(), townWeatherEpoch);
+  if (night !== anchorRunNight) { anchorRunNight = night; anchorRun = createAnchorRun(night); }
+  // By day the rings are plain stone circles: every lamp dark.
