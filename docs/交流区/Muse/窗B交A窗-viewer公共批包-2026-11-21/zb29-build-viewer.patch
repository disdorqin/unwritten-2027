+      return { label: '堆成雪人', run: () => {
+        const id = `built-${++builtSnowmanCount}`;
+        snowmanScene.addSnowman({ id, clan: 'player', tag: presence.playerName(),
+          at: { east: centroid.east, north: centroid.north }, headYaw: yaw });
+        for (const ball of parkedBalls.splice(0)) landscape.remove(ball.mesh);
+        announceActivity('雪人堆好了——今晚它也会看向你。');
+      } };
+    }
+    return { label: '推倒雪球重滚', run: () => {
