+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { isMirrorLakeIce, mirrorLake } from '../src/shared/mirror-lake';
+import { mirrorEastEntries, mirrorFishingSites, mirrorFishingOccupancyRadius } from '../tools/voxel-tavern/town-blockout/mirror-lake-site';
+import {
+  buildMirrorLakeZoneSample, eastOpportunity, ellipseLoop, mirrorIslandNominalRadius,
+  mirrorScoreCenterSpacing, northSouthIceChord, signedIceClearance,
+  surveyMirrorShoreLanterns, surveyMirrorZoneLayout, type MirrorZoneLayout,
+} from '../tools/voxel-tavern/town-blockout/mirror-lake-zone-sample';
+import { canEnter, createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain';
+
+const grid = createTerrainGrid();
+const [east, north] = mirrorLake.center;
+const halfInterval = mirrorScoreCenterSpacing / 2;
+const skating: MirrorZoneLayout['skateLines'] = [
+  ellipseLoop(mirrorLake.center, [12, 40], 96),
+  ellipseLoop(mirrorLake.center, [10, 40], 96),
+];
+
+// Geometry probes only. These measurements do not register positions in the game.
+const plane: MirrorZoneLayout = {
+  fishing: [[27, 185], [30, 160], [30, 210]],
+  westShorePavilionProbe: [22, 207],
+  skateLines: skating,
+  scoreCenters: [[68, north - halfInterval], [68, north + halfInterval]],
+  prize: [68, north],
+  island: { center: [east, north + halfInterval], radius: mirrorIslandNominalRadius },
+};
+
+test('a 44 m pair fits east-facing longitudinal ice, while whole-east transverse placement cannot', t => {
+  const eastCapacity = eastOpportunity();
+  assert.ok(eastCapacity.eastHalfWidth < mirrorScoreCenterSpacing);
+  assert.ok(eastCapacity.eastHalfWidth * 2 > mirrorScoreCenterSpacing);
+  assert.ok(Math.abs(northSouthIceChord(eastCapacity.furthestEast) - 44) < 1e-6);
+  const sweep = Array.from({ length: 7 }, (_, i) => 62 + 2 * i).map(x => ({
+    x, chord: northSouthIceChord(x), circleRadiusToIce: signedIceClearance([x, north + halfInterval]),
+  }));
+  const offset = mirrorIslandNominalRadius;
+  const shifted: MirrorZoneLayout = {
+    ...plane,
+    scoreCenters: [[68, north - halfInterval + offset], [68, north + halfInterval + offset]],
+    prize: [68, north + offset],
+  };
+  for (const layout of [plane, shifted]) {
+    const survey = surveyMirrorZoneLayout(layout);
+    assert.equal(survey.scoreSpacing, mirrorScoreCenterSpacing);
+    for (const [x, n] of [...layout.scoreCenters, layout.prize]) {
+      assert.ok(x > east && isMirrorLakeIce(x, n));
+      assert.equal(grid.groundHeightAt(x, n), mirrorLake.height);
+      assert.equal(grid.surfaces[n * grid.gridWidth + x], 4);
+    }
+    assert.ok(survey.scoreCenterGaps.every(gap => gap.iceEdge > 0 && gap.skateLine > 0 && gap.islandEdge > 0));
+    t.diagnostic(JSON.stringify({ scoreCenters: layout.scoreCenters, prize: layout.prize,
+      prizeCrossingLineGap: Math.abs(layout.prize[1] - north), circleClearances: survey.scoreCenterGaps }));
+  }
+  t.diagnostic(JSON.stringify({ eastCapacity, sweep }));
+});
+
+test('the three western fishing probes fit the ice and the nominal island clears both skating lines', t => {
+  const legacy = mirrorFishingSites.map(({ id, x, n }) => ({ id, point: [x, n], westOfCenter: x < east }));
+  assert.deepEqual(legacy.filter(site => site.westOfCenter).map(site => site.id), ['F6']);
+  const lake = surveyMirrorZoneLayout(plane);
+  assert.ok(lake.islandIceGap > 0);
+  assert.ok(lake.islandSkateGaps.every(gap => gap > 0));
+  assert.ok(lake.skateIceGaps.every(gap => gap > 0));
+  for (const site of plane.fishing) {
+    assert.ok(signedIceClearance(site) > mirrorFishingOccupancyRadius);
+    assert.equal(grid.groundHeightAt(...site), mirrorLake.height);
+  }
+  const westBeforeAdjustment = [
+    [mirrorFishingSites[5].x, mirrorFishingSites[5].n],
+    [2 * east - mirrorFishingSites[2].x, mirrorFishingSites[2].n],
+    [2 * east - mirrorFishingSites[1].x, mirrorFishingSites[1].n],
+  ] as const;
+  t.diagnostic(JSON.stringify({ legacy, trialWest: plane.fishing, beforeAdjustment: westBeforeAdjustment.map(site =>
+    ({ site, radiusMargin: signedIceClearance(site) - mirrorFishingOccupancyRadius })),
+  afterAdjustment: lake.fishing.map(site => ({ radiusMargin: site.iceEdge - mirrorFishingOccupancyRadius,
+    skateMargin: site.skateLine - mirrorFishingOccupancyRadius })), island: plane.island, islandIceGap: lake.islandIceGap,
+  islandSkateGaps: lake.islandSkateGaps, skateIceGaps: lake.skateIceGaps }));
+});
+
+test('the independent sample batches four-zone overlays while all three east approaches remain open', t => {
+  const shore = surveyMirrorShoreLanterns();
+  const sample = buildMirrorLakeZoneSample(plane, grid.groundHeightAt);
+  assert.equal(sample.group.children.length, 1);
+  assert.equal(sample.triangles, 12 * sample.instances);
+  for (const { roadX, iceX, north: n } of mirrorEastEntries) {
+    for (let x = iceX; x <= roadX; x += .1) assert.ok(canEnter(x, n));
+  }
+  sample.dispose();
+  assert.equal(sample.group.children.length, 0);
+  t.diagnostic(JSON.stringify({ meshBatches: 1, boxes: sample.instances, tris: sample.triangles, shoreMetres: shore.length,
+    lanterns: shore.lanterns.length, seamGap: shore.closingGap, pavilionProbe: plane.westShorePavilionProbe,
+    pavilionProbeY: grid.groundHeightAt(...plane.westShorePavilionProbe) }));
+});
