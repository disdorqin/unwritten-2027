+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, Raycaster, Vector3 } from 'three';
+import { isMirrorLakeIce, mirrorLake } from '../src/shared/mirror-lake';
+import { readWalkGeometry } from '../tools/voxel-tavern/town-blockout/landmark-kit';
+import { createMirrorF2Slope, mirrorF2RoadAt } from '../tools/voxel-tavern/town-blockout/mirror-lake-f2-slope';
+import { createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain';
+import { createTownRailway } from '../tools/voxel-tavern/town-blockout/town-railway';
+
+// This is a review fixture and never a selected alignment or a frozen design.
+const profile = { halfWidth: 1, rowStep: 1, stages: [
+  { runFraction: .4, riseFraction: .5 },
+  { runFraction: .6, riseFraction: .5 },
+] };
+const terrain = createTerrainGrid();
+
+test('the staged F2 review surface meets the legacy shoulder without sampling road or strict ice', () => {
+  const candidate = createMirrorF2Slope(terrain.heightAt, profile);
+  try {
+    const north = 210;
+    const { centerEast, shoulderEast } = mirrorF2RoadAt(north);
+    const roadHeight = terrain.heightAt(centerEast, north);
+    const shoulderHeight = terrain.heightAt(shoulderEast, north);
+    const start = 73.7736380844118;
+    assert.ok(Math.abs(roadHeight - 16.509804) < 1e-6);
+    assert.equal(candidate.heightAt(centerEast, north), undefined);
+    assert.equal(candidate.heightAt(shoulderEast + .001, north), undefined);
+    assert.equal(candidate.heightAt(shoulderEast, north), shoulderHeight);
+    assert.equal(candidate.heightAt(start, north), mirrorLake.height);
+    assert.ok(isMirrorLakeIce(start - .001, north));
+    assert.equal(candidate.heightAt(start - .001, north), undefined);
+    assert.ok(terrain.heightAt(start, north) - mirrorLake.height > 10);
+    assert.equal(candidate.heightAt(shoulderEast - 1, 212), undefined);
+
+    const count = Math.ceil((shoulderEast - start) / .08);
+    const values = Array.from({ length: count + 1 }, (_, index) =>
+      candidate.heightAt(start + (shoulderEast - start) * index / count, north)!);
+    const maxRise = Math.max(...values.slice(1).map((value, index) => value - values[index]));
+    assert.ok(values.slice(1).every((value, index) => value >= values[index]));
+    assert.ok(maxRise < .43);
+    assert.ok(values.filter(value => Math.abs(value - (shoulderHeight + mirrorLake.height) / 2) < 1e-12).length > 1);
+    console.log(JSON.stringify({ north, centerEast, roadHeight, shoulderEast, shoulderHeight,
+      start, originalIceRimTerrain: terrain.heightAt(start, north), samples: values.length, maxRise }));
+  } finally {
+    candidate.dispose();
+  }
+});
+
+test('F2 mesh and local collision sampler coincide, clear existing rail and release independently', () => {
+  const railway = createTownRailway(terrain, () => Date.UTC(2026, 10, 19));
+  const rail = readWalkGeometry(railway.group);
+  const candidate = createMirrorF2Slope(terrain.heightAt, profile);
+  const scene = new Group();
+  scene.add(candidate.mesh);
+  candidate.mesh.updateMatrixWorld(true);
+  const ray = new Raycaster(new Vector3(), new Vector3(0, -1, 0));
+  const points = candidate.mesh.geometry.attributes.position;
+  const triangles = candidate.mesh.geometry.index!;
+  let maximumHeightDifference = 0, railContacts = 0, nearestRailPoint = Infinity;
+  const vertex = (index: number) => new Vector3().fromBufferAttribute(points, triangles.getX(index));
+  for (let i = 0; i < triangles.count; i += 3) {
+    const a = vertex(i), b = vertex(i + 1), c = vertex(i + 2);
+    // Include interior points on every rendered triangle.
+    for (let u = 1; u <= 7; u++) for (let v = 1; v <= 8 - u; v++) {
+      const point = a.clone().addScaledVector(b.clone().sub(a), u / 9).addScaledVector(c.clone().sub(a), v / 9);
+      const height = candidate.heightAt(point.x, -point.z);
+      assert.ok(height !== undefined);
+      ray.ray.origin.set(point.x, 35, point.z);
+      const hit = ray.intersectObject(candidate.mesh)[0];
+      assert.ok(hit);
+      maximumHeightDifference = Math.max(maximumHeightDifference, Math.abs(hit.point.y - height));
+      for (const { min, max } of [...rail.colliders, ...rail.floors]) {
+        const radius = Math.hypot(Math.max(min[0] - point.x, point.x - max[0], 0),
+          Math.max(min[2] - point.z, point.z - max[2], 0));
+        if (radius < .27 && height + .025 < max[1] && height + 1.95 > min[1]) railContacts++;
+      }
+      for (const p of railway.route.points) nearestRailPoint = Math.min(nearestRailPoint,
+        Math.hypot(p.x - point.x, p.z - point.z));
+    }
+  }
+  assert.equal(railContacts, 0);
+  assert.ok(maximumHeightDifference < .00001);
+  let disposed = 0;
+  candidate.mesh.geometry.addEventListener('dispose', () => disposed++);
+  candidate.mesh.material.addEventListener('dispose', () => disposed++);
+  candidate.dispose();
+  candidate.dispose();
+  assert.equal(scene.children.length, 0);
+  assert.equal(disposed, 2);
+  assert.equal(candidate.heightAt(78, 210), undefined);
+  console.log(JSON.stringify({ vertices: points.count, triangles: triangles.count / 3,
+    faceSamples: triangles.count / 3 * 28, maximumHeightDifference, railContacts, nearestRailPoint, disposed }));
+});
diff --git a/tools/voxel-tavern/town-blockout/mirror-lake-f2-slope.ts b/tools/voxel-tavern/town-blockout/mirror-lake-f2-slope.ts
