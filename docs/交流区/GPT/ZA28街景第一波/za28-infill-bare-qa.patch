From 10bdbdfc85de1f9e91f613a00613ce8eb83f6365 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 20 Nov 2026 01:54:41 -0800
Subject: [PATCH] test(town): walk bare ZA-28 infill with the native drag
 fallback

---
 tools/verify-za22-live.mjs  | 81 ++++++++++++++++++++++++++++---------
 tools/verify-za22-local.mjs |  2 +-
 2 files changed, 64 insertions(+), 19 deletions(-)

diff --git a/tools/verify-za22-live.mjs b/tools/verify-za22-live.mjs
index 0537de54..87e638c5 100644
--- a/tools/verify-za22-live.mjs
+++ b/tools/verify-za22-live.mjs
@@ -6,12 +6,13 @@ import { observeBareTown } from './verify-za30-bare-observer.mjs';
 
 const [origin, output, segment = 'all'] = process.argv.slice(2);
 assert.ok(origin && output, 'Use the production-preview loopback URL and an evidence directory');
-const bare = ['bare', 'north', 'mountain-bare', 'crater-bare'].includes(segment);
-const mountainDragFallback = segment === 'mountain-bare';
+const infill = segment === 'infill-bare';
+const bare = infill || ['bare', 'north', 'mountain-bare', 'crater-bare'].includes(segment);
+const bareDragFallback = infill || segment === 'mountain-bare';
 const url = bare ? new URL(origin) : new URL('/?profile', origin);
 assert.equal(url.protocol, 'http:');
 assert.equal(url.hostname, '127.0.0.1');
-if (bare) assert.equal(url.href, `${url.origin}/`, 'ZA-30 requires the bare production root, with no query or hash');
+if (bare) assert.equal(url.href, `${url.origin}/`, 'Use the bare production root, with no query or hash');
 assert.ok(bare || ['station', 'cloud', 'gate', 'crater', 'all'].includes(segment), segment);
 
 const spawn = [223, 180];
@@ -45,7 +46,7 @@ const graphicsArgs = hardware ? (process.platform === 'win32' ? ['--use-gl=angle
   : ['--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader'];
 const report = { url: url.href, segment, viewport, deviceScaleFactor, headless, quality: bare ? 'fresh default' : 'smooth',
   gpu: null, paths: [], pageErrors: [], consoleErrors: [], requestFailures: [], httpErrors: [], stageFailures: [] };
-if (bare) report.input = mountainDragFallback ? 'native mouse, production drag fallback (Pointer Lock unavailable in this context)'
+if (bare) report.input = bareDragFallback ? 'native mouse, production drag fallback (Pointer Lock unavailable in this context)'
   : 'native mouse, standard browser Pointer Lock';
 if (bare && process.env.ZA30_LOCAL_TEST_NIGHT) report.localTestNight = JSON.parse(process.env.ZA30_LOCAL_TEST_NIGHT);
 
@@ -57,8 +58,8 @@ let measuring = true;
 async function openTown(name) {
   const context = await browser.newContext({ viewport, deviceScaleFactor, locale: 'zh-CN' });
   if (bare) await context.addInitScript(observeBareTown);
-  if (mountainDragFallback) await context.addInitScript(() => {
-    // The standalone mountain route selects the viewer's ordinary fallback.
+  if (bareDragFallback) await context.addInitScript(() => {
+    // These routes select the viewer's ordinary fallback while keeping the bare entry.
     Object.defineProperty(Element.prototype, 'requestPointerLock', { value: undefined });
   });
   const page = await context.newPage();
@@ -194,7 +195,7 @@ async function faceBare(page, desired, pitch) {
     await page.mouse.move(anchor.x, anchor.y);
     await page.mouse.down();
     try {
-      const steps = mountainDragFallback ? Math.max(2, Math.ceil(Math.hypot(dx, yMove) / 55)) : 1;
+      const steps = bareDragFallback ? Math.max(2, Math.ceil(Math.hypot(dx, yMove) / 55)) : 1;
       await page.mouse.move(anchor.x + dx, anchor.y + yMove, { steps });
     }
     finally { await page.mouse.up(); }
@@ -204,7 +205,7 @@ async function faceBare(page, desired, pitch) {
 }
 
 async function face(page, evidence, desired, pitch) {
-  if (bare) return faceBare(page, desired, pitch);
+  if (bare && !bareDragFallback) return faceBare(page, desired, pitch);
   for (let attempt = 0; attempt < 16; ++attempt) {
     const before = await waitForWire(page, evidence);
     const delta = yawDistance(before.yaw, desired);
@@ -300,6 +301,38 @@ async function snapshot(page, evidence, label) {
   evidence.checkpoints.push({ label, ...await readPose(page), wire: evidence.poses.at(-1) });
 }
 
+async function walkStreetInfill(page, evidence) {
+  async function sample(label, east, north) {
+    const here = await readPose(page);
+    const facing = Math.atan2(east - here.east, north - here.north);
+    await face(page, evidence, facing);
+    await waitForWire(page, evidence, wire => wire?.area === 'town' &&
+      Math.hypot(wire.east - here.east, wire.north - here.north) < .6 &&
+      Math.abs(yawDistance(wire.yaw, facing)) < .022);
+    await snapshot(page, evidence, label);
+  }
+
+  await snapshot(page, evidence, 'ordinary-spawn-smoke');
+  await follow(page, evidence, [...westShore.slice(0, 3), [155, 156.6], [157.6, 156.8]], 'plaza-verge');
+  await sample('southwest-plaza', 159.5, 161);
+  await follow(page, evidence, [[155, 156.6], ...westShore.slice(2, 5), [129, 86], [176, 74],
+    [199, 80.024], [198.5, 86], [200, 87]], 'market');
+  await sample('market-south-loop', 200, 90);
+  await follow(page, evidence, [[198.5, 86], [199, 80.024], [176, 74], [129, 86],
+    ...westShore.slice(0, 5).reverse(), spawn], 'market-return');
+  await follow(page, evidence, [...station.slice(0, 5), [317.25, 216]], 'northeast');
+  await sample('northeast-approach', 323, 212.5);
+  await follow(page, evidence, station.slice(5, 17), 'station');
+  await sample('station-approach-west', 501, 294);
+  await follow(page, evidence, station.slice(17, 20), 'station-entry');
+  await walkTo(page, evidence, station[17], 'station-forecourt-return');
+  await sample('station-approach-east', 518.5, 310);
+  await follow(page, evidence, [...station.slice(0, 17).reverse(), spawn], 'station-return');
+  await waitForWire(page, evidence, wire => wire?.area === 'town' &&
+    Math.hypot(wire.east - spawn[0], wire.north - spawn[1]) < .55 && Math.abs(wire.height - 12) < .3);
+  await snapshot(page, evidence, 'spawn-return');
+}
+
 async function captureMainSummit(page, evidence) {
   await snapshot(page, evidence, 'spawn');
   await walkTo(page, evidence, northLook, 'north-look-position');
@@ -362,11 +395,15 @@ try {
     args: graphicsArgs,
   });
   report.browser = browser.version();
+  if (infill) await collectStage('street-infill', async () => {
+    const { page, evidence } = await openTown('street-infill');
+    await walkStreetInfill(page, evidence);
+  });
   if (segment === 'bare' || segment === 'north') await collectStage('north', async () => {
     const { page, evidence } = await openTown('north');
     await captureMainSummit(page, evidence);
   });
-  if (!['crater', 'crater-bare', 'north'].includes(segment)) await collectStage('mountain', async () => {
+  if (!infill && !['crater', 'crater-bare', 'north'].includes(segment)) await collectStage('mountain', async () => {
     const { page, evidence } = await openTown('cable');
     await follow(page, evidence, station, 'station');
     if (segment === 'station') {
@@ -378,19 +415,26 @@ try {
       await page.waitForFunction(() => document.querySelector('#position')?.textContent?.includes('缆车一线'),
         null, { timeout: 135_000 });
       await snapshot(page, evidence, 'cable-boarding');
-      await page.waitForFunction(bare => {
-        const riding = document.querySelector('#position')?.textContent?.includes('缆车一线');
+      const cableProgress = await page.waitForFunction(({ bare, bareDragFallback, pattern, destination }) => {
+        const hud = document.querySelector('#position')?.textContent ?? '';
         const height = bare ? window.__za30Bare?.camera?.cameraY : window.__za22Frame?.cameraY;
-        return riding && height > 80 && height < 300;
-      }, bare, { timeout: 90_000 });
-      await snapshot(page, evidence, 'cable-moving');
+        if (hud.includes('缆车一线') && height > 80 && height < 300) return 'moving';
+        if (!bareDragFallback) return false;
+        const pose = new RegExp(pattern).exec(hud);
+        return pose && Math.hypot(Number(pose[1]) - destination[0], Number(pose[2]) - destination[1]) < 1
+          ? 'hud-arrival' : false;
+      }, { bare, bareDragFallback, pattern: positionPattern.source, destination: cloudStop },
+      { timeout: bareDragFallback ? 210_000 : 90_000 });
+      evidence.cableProgress = await cableProgress.jsonValue();
+      await cableProgress.dispose();
+      if (evidence.cableProgress === 'moving') await snapshot(page, evidence, 'cable-moving');
 
-      await page.waitForFunction(({ pattern, destination, bare }) => {
+      await page.waitForFunction(({ pattern, destination, bare, bareDragFallback }) => {
         const pose = new RegExp(pattern).exec(document.querySelector('#position')?.textContent ?? '');
         const cameraY = bare ? window.__za30Bare?.camera?.cameraY : window.__za22Frame?.cameraY;
         return pose && Math.hypot(Number(pose[1]) - destination[0], Number(pose[2]) - destination[1]) < 1
-          && Math.abs(cameraY - 348.65) < .55;
-      }, { pattern: positionPattern.source, destination: cloudStop, bare }, { timeout: 210_000 });
+          && (bareDragFallback || Math.abs(cameraY - 348.65) < .55);
+      }, { pattern: positionPattern.source, destination: cloudStop, bare, bareDragFallback }, { timeout: 210_000 });
       await waitForWire(page, evidence, pose => pose?.area === 'mountain' && Math.abs(pose.height - 347) < .7);
       await snapshot(page, evidence, 'cloud-cable-arrival');
       if (segment === 'cloud' || segment === 'all') {
@@ -462,7 +506,8 @@ try {
 } finally {
   measuring = false;
   report.errors = report.pageErrors.length + report.consoleErrors.length + report.requestFailures.length + report.httpErrors.length;
-  await writeFile(join(output, bare ? 'za30-bare-walk.json' : 'za22-live-walk.json'), `${JSON.stringify(report, null, 2)}\n`);
+  const reportFile = infill ? 'za28-infill-bare-walk.json' : bare ? 'za30-bare-walk.json' : 'za22-live-walk.json';
+  await writeFile(join(output, reportFile), `${JSON.stringify(report, null, 2)}\n`);
   console.log(JSON.stringify({ segment, paths: report.paths.map(path => ({ name: path.name, checkpoints: path.checkpoints.length,
     frames: path.poses.length, last: path.checkpoints.at(-1) })), errors: report.errors, failure: report.failure }));
   await browser?.close();
diff --git a/tools/verify-za22-local.mjs b/tools/verify-za22-local.mjs
index 4dae1fe0..27ceca25 100644
--- a/tools/verify-za22-local.mjs
+++ b/tools/verify-za22-local.mjs
@@ -10,7 +10,7 @@ import { fileURLToPath } from 'node:url';
 import { promisify } from 'node:util';
 
 const [segment, evidencePath] = process.argv.slice(2);
-const bareRoute = ['bare', 'mountain-bare', 'crater-bare'].includes(segment);
+const bareRoute = ['bare', 'mountain-bare', 'crater-bare', 'infill-bare'].includes(segment);
 assert.ok((bareRoute || ['station', 'cloud', 'gate', 'crater', 'all', 'clock', 'clock-books', 'north'].includes(segment)) && evidencePath,
   'Usage: node tools/verify-za22-local.mjs <segment> <evidence directory>');
 const run = promisify(execFile);
