+          block(0, height + .33, 0, [width * .91, .10, width * .76], snow);
+        }
+        if (kind === 'lanternFir') {
+          lantern(x - dx * .82, y + 1.36, n - dn * .82, .34);
+          lantern(x + dx * .65, y + 1.85, n + dn * .65, .31);
