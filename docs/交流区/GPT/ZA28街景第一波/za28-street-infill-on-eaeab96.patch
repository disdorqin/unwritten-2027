+  const legacyFootprints = footprints.length;
+  const infillPlaced = new Map<string, StreetInfillKind[]>();
+  const infillSize = {
+    fir: [1.65, .36], lanternFir: [1.65, .36], lantern: [.55, .22],
+    fence: [1.4, .58], firewood: [.8, .55], stall: [1.65, .92],
