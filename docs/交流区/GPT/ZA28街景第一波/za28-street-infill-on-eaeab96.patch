+      || n < 2 + radius || n > bounds.depth - 2 - radius || isWater(x, n)
+      || (infill ? infillProtectedArea(x, n, radius) : protectedArea(x, n, radius))
       || grid.surfaces[Math.round(n) * grid.gridWidth + Math.round(x)] === 4
