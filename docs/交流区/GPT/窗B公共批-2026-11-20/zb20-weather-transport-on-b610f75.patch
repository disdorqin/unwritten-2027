diff --git a/tests/server/town-outdoor-weather-transport.test.ts b/tests/server/town-outdoor-weather-transport.test.ts
new file mode 100644
index 0000000..adf95b9
--- /dev/null
+++ b/tests/server/town-outdoor-weather-transport.test.ts
@@ -0,0 +1,90 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { test, type TestContext } from 'node:test';
+import { setTimeout as delay } from 'node:timers/promises';
+import { WebSocket } from 'ws';
+import { createPresenceServer } from '../../src/presence/server.js';
+import { PRESENCE_PATH } from '../../src/presence/protocol.js';
+import { isOrdinaryTownNight } from '../../src/shared/town-night-window.js';
+import {
+  readTownOutdoorWeatherCue, readTownOutdoorWeatherFrame, readTownOutdoorWeatherState,
+} from '../../src/shared/town-outdoor-weather.js';
+
+async function join(t: TestContext, port: number, name: string) {
+  const socket = new WebSocket(`ws://127.0.0.1:${port}${PRESENCE_PATH}`);
+  t.after(() => socket.terminate());
+  const states: NonNullable<ReturnType<typeof readTownOutdoorWeatherFrame>>[] = [];
+  const cues: NonNullable<ReturnType<typeof readTownOutdoorWeatherCue>>[] = [];
+  let epochMs = NaN, dawnEpoch = NaN;
+  let resolveJoined!: (state: ReturnType<typeof readTownOutdoorWeatherState>) => void;
+  const joined = new Promise<ReturnType<typeof readTownOutdoorWeatherState>>(resolve => { resolveJoined = resolve; });
+  socket.on('message', (raw, binary) => {
+    if (binary) return;
+    const frame = JSON.parse(raw.toString());
+    if (frame.type === 'join' && frame.self) {
+      epochMs = frame.epochMs;
+      dawnEpoch = frame.townCalendarDawnEpoch;
+      resolveJoined(readTownOutdoorWeatherState(frame.townOutdoorWeather));
+    }
+    const state = readTownOutdoorWeatherFrame(frame);
+    if (state) states.push(state);
+    const cue = readTownOutdoorWeatherCue(frame);
+    if (cue) cues.push(cue);
+  });
+  await once(socket, 'open');
+  socket.send(JSON.stringify({ type: 'join', name }));
+  const snapshot = await joined;
+  return { snapshot, states, cues, epochMs, dawnEpoch };
+}
+
+async function until(condition: () => boolean) {
+  for (let i = 0; i < 200; i++) {
+    if (condition()) return;
+    await delay(10);
+  }
+  assert.fail('Presence weather update timed out');
+}
+
+test('normal presence shares one forecast and phase, and reconnects with current state', { timeout: 8000 }, async t => {
+  const dawnEpoch = Date.parse('2026-11-20T00:00:00+08:00');
+  const windAt = dawnEpoch + 30 * 60_000;
+  let now = dawnEpoch;
+  const warnings: number[] = [];
+  const town = await createPresenceServer({
+    host: '127.0.0.1',
+    port: 0,
+    connectionLog() {},
+    outdoorWeather: { dawnEpoch, nowEpochMs: () => now, saveWarning: at => warnings.push(at) },
+  });
+  t.after(() => town.close());
+  const port = town.address().port;
+  const left = await join(t, port, '左侧测试');
+  const right = await join(t, port, '右侧测试');
+  assert.equal(left.snapshot?.weather, 'clear-snow');
+  assert.equal(left.epochMs, dawnEpoch);
+  assert.equal(left.dawnEpoch, dawnEpoch);
+  assert.equal(isOrdinaryTownNight(left.epochMs, left.dawnEpoch), false);
+  assert.equal(isOrdinaryTownNight(left.epochMs + 6 * 60_000, left.dawnEpoch), true);
+  assert.equal(isOrdinaryTownNight(left.epochMs + 10 * 60_000, left.dawnEpoch), false);
+  assert.deepEqual(left.snapshot, right.snapshot);
+
+  now = windAt - 30_000;
+  await until(() => left.cues.length === 1 && right.cues.length === 1);
+  assert.deepEqual(left.cues, right.cues);
+  assert.deepEqual(warnings, [now]);
+  assert.equal(left.cues[0]?.expiresAt, windAt);
+  const returning = await join(t, port, '重新入镇');
+  assert.deepEqual(returning.snapshot, left.snapshot);
+
+  now = windAt;
+  await until(() => [left, right, returning].every(peer => peer.states.length === 1));
+  assert.deepEqual(left.states, right.states);
+  assert.deepEqual(left.states, returning.states);
+  assert.equal(left.states[0]?.state.weather, 'wind');
+  const late = await join(t, port, '换态后入镇');
+  assert.deepEqual(late.snapshot, left.states[0]?.state);
+  await delay(150);
+  assert.deepEqual([left, right, returning, late].map(peer => [peer.cues.length, peer.states.length]), [
+    [1, 1], [1, 1], [0, 1], [0, 0],
+  ]);
+});
