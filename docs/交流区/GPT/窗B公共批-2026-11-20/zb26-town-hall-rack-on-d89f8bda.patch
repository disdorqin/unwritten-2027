+test('the town hall rack leaves its front steps and roadway clear, with room to use either flank', () => {
+  const terrain = createTerrainGrid();
+  const [doorEast, doorNorth] = layout.plots.find(plot => plot.id === 'town-office')!.door;
+  const dryGround = (east: number, north: number) => {
+    if (canEnter(east, north) && !isWater(east, north)) return terrain.heightAt(east, north);
+  };
+  const findRack = (sample: typeof dryGround) => resolveTownSledRacks('town', sample)
+    .find(({ id }) => id === 'town-hall');
+  const first = findRack(dryGround);
+  assert.ok(first);
+  const fallback = findRack((east, north) => east === first.x && north === first.n ? undefined : dryGround(east, north));
+  assert.ok(fallback);
+  assert.ok(first.x > doorEast && fallback.x < doorEast);
+  for (const rack of [first, fallback]) {
+    assert.ok(rack.n + 1.05 < doorNorth);
+    assert.ok(Math.abs(rack.x - doorEast) > 2.35 + 1.05);
+    assert.equal(roadCorridorKeepClear(rack.x, rack.n, 1.05), false);
+    assert.equal(rack.yaw, Math.PI);
+  }
 });

