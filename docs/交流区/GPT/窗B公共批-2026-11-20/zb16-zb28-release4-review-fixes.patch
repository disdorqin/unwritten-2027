+    guardPresent: false, showNightSigns: false, showEmptyPost: true,
+  });
+
+  now = handoffSchedule.beaconAt;
+  assert.ok(host.recordBeacon(now));
+  presence.tick();
+  presence.acceptBeacon(handoffCue);
+  assert.equal(presence.guardPhase(), 'awaiting-beacon');
+  assert.deepEqual(played, []);
+
+  now++;
+  presence.join(now, host.snapshot());
+  assert.equal(presence.state()?.phase, 'night-window');
+  assert.deepEqual(za29GuardDutyForPhase(presence.guardPhase()), {
+    guardPresent: false, showNightSigns: true, showEmptyPost: true,
+  });
