+  assert.ok(host.recordBeacon(now));
+  const snapshot = host.snapshot();
+  const presence = createTownPresenceNight(() => now, () => elapsed);
+
+  presence.join(now, snapshot);
+  presence.disconnect('room-handoff');
+  assert.equal(presence.state(), undefined);
+  assert.equal(presence.guardPhase(), 'night-window');
+  now = handoffSchedule.morningBellAt + 3_600_000;
+  elapsed = handoffSchedule.morningBellAt - handoffSchedule.beaconAt - 1;
+  presence.disconnect('room-handoff');
+  assert.equal(za29GuardDutyForPhase(presence.guardPhase()).guardPresent, false);
+
+  now = handoffSchedule.beaconAt - 100;
+  elapsed++;
+  assert.equal(presence.guardPhase(), undefined);
+  assert.equal(za29GuardDutyForPhase(presence.guardPhase()).guardPresent, true);
+  assert.equal(presence.state(), undefined);
