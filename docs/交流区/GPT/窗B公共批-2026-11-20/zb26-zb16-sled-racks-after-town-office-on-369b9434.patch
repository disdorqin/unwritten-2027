+test('the parked sled wins over a closer full rack and can only be selected while remountable', () => {
+  let blocked = false;
+  const ride = createSledRide({
+    height: () => 12, surface: () => ({ surface: 0, deepSnow: false }), blocked: () => blocked,
+    snow() {}, stopped() {},
+  });
+  assert.equal(ride.mount(101.2, 80, 12, Math.PI / 2), true);
+  assert.equal(ride.leave(), true);
+  const original = ride.parked();
+  assert.ok(original);
+  const full: TownSledRackAction = { x: 100.1, n: 80, ground: 12, range: 2.4, parked: false, label: '乘雪橇', run() {} };
+  const parked: TownSledRackAction = {
+    x: original.x, n: original.n, ground: original.y, range: 2.4, parked: true, label: '重新上橇',
+    available: () => ride.canRemount(100, 80, 12),
+    run() { assert.equal(ride.remount(100, 80, 12), true); },
+  };
+  const racks = [full, parked];
+  blocked = true;
+  assert.equal(nearestParkedTownSledAction(racks, 100, 80, 12), undefined);
+  blocked = false;
+  assert.equal(nearestParkedTownSledAction(racks, 100, 80, 13), undefined);
+  assert.equal(nearestParkedTownSledAction(racks, 104, 80, 12), undefined);
+  const picked = nearestParkedTownSledAction(racks, 100, 80, 12);
+  assert.equal(picked, parked);
+  picked?.run();
+  assert.deepEqual(ride.spot, original);
+  assert.equal(ride.active(), true);
+});
