index 0000000..83aabcd
--- /dev/null
+++ b/tests/server/soul-mayor-transport.test.ts
@@ -0,0 +1,161 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { test, type TestContext } from 'node:test';
+import { setTimeout as delay } from 'node:timers/promises';
+import { WebSocket } from 'ws';
+import { createPresenceServer } from '../../src/presence/server.js';
+import { sharedHomeOrigin } from '../../src/presence/shared-home-space.js';
+import { createZodiacStarStoneAuthority } from '../../src/presence/zodiac-star-stone-authority.js';
+import type { SoulMayorView } from '../../src/shared/soul-mayor.js';
+
+type Frame = {
+  type?: string;
+  kind?: string;
+  self?: boolean;
+  id?: number;
+  requestId?: number;
+  outcome?: string;
+  view?: SoulMayorView | null;
+};
+
+const actor = { layer: 'test-platform', east: 220, north: 188, height: 12 };
+const talk = { ...actor, north: 187.1 };
+const packet = (requestId: number) => ({ type: 'event', kind: 'soul-mayor-accept-invitation', requestId });
+const isMayor = (frame: Frame) => typeof frame.kind === 'string' && frame.kind.startsWith('soul-mayor');
+const isView = (frame: Frame) => frame.kind === 'soul-mayor-view';
+const isResult = (requestId: number) => (frame: Frame) =>
+  frame.kind === 'soul-mayor-invitation-result' && frame.requestId === requestId;
+
+async function waitForFrame(frames: Frame[], predicate: (frame: Frame) => boolean) {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const frame = frames.find(predicate);
+    if (frame) return frame;
+    await delay(10);
+  }
+  assert.fail('Presence frame timed out');
+}
+
+async function connect(t: TestContext, port: number) {
+  const ws = new WebSocket(`ws://127.0.0.1:${port}/presence`);
+  t.after(() => ws.terminate());
+  const frames: Frame[] = [];
+  ws.on('message', (raw, binary) => { if (!binary) frames.push(JSON.parse(raw.toString())); });
+  await once(ws, 'open');
+  const send = (value: unknown) => ws.send(JSON.stringify(value));
+  send({ type: 'join', name: '同昵称游客' });
+  const self = await waitForFrame(frames, frame => frame.type === 'join' && frame.self === true);
+  assert.ok(self.id);
+  let seq = 0;
+  return {
+    id: self.id,
+    frames,
+    send,
+    close: () => ws.terminate(),
+    pose(position: { east: number; north: number; height: number }) {
+      const data = Buffer.alloc(12);
+      const words = [0, Math.round(position.east * 100), Math.round(position.north * 100), Math.round(position.height * 100), 0, ++seq];
+      words.forEach((word, index) => data.writeUInt16LE(word, index * 2));
+      ws.send(data);
+    },
+  };
+}
+
+test('production presence keeps the mayor private and reattaches an invitation only to the same trusted profile', { timeout: 8000 }, async t => {
+  const profiles = new Map<number, { key: string; protagonist: boolean }>();
+  const receipts = new Set<string>();
+  const keysSeen: string[] = [];
+  const positions: Array<{ east: number; north: number; height: number }> = [];
+  let failSave = false;
+  let encounter = { actor, talk };
+  const stars = createZodiacStarStoneAuthority({
+    nowMs: () => 0, origin: () => undefined, playerPosition: () => undefined,
+    canPickup: () => false, canDeposit: () => false,
+    xiaoweiScene: () => ({ atRingPassage: false, atNewYearsEveWitness: false, bellHandoffConfirmed: false }),
+  }, { load() {}, save() {} });
+  const server = await createPresenceServer({
+    connectionLog() {},
+    soulMayorHost: {
+      profile: id => profiles.get(id),
+      acceptedLayer(_id, position) { positions.push(position); return actor.layer; },
+      encounterSite: () => encounter,
+      canTalk: () => true,
+      stars,
+      invitations: {
+        received: key => receipts.has(key),
+        grantOnce(key) {
+          if (receipts.has(key)) return 'already-received';
+          if (failSave) return 'retry';
+          keysSeen.push(key);
+          receipts.add(key);
+          return 'received';
+        },
+      },
+    },
+  });
+  t.after(() => server.close());
+  const port = server.address().port;
+  const hero = await connect(t, port);
+  const guest = await connect(t, port);
+  const trustedKey = 'private-stable-protagonist';
+  profiles.set(hero.id, { key: trustedKey, protagonist: true });
+  profiles.set(guest.id, { key: 'ordinary-visitor', protagonist: false });
+
+  guest.pose(talk);
+  guest.send({ ...packet(1), profileKey: trustedKey, east: talk.east, actor });
+  guest.send(packet(2));
+  hero.send(packet(1));
+  hero.pose({ ...talk, east: 222 });
+  const offer = await waitForFrame(hero.frames, isView);
+  assert.deepEqual(offer, {
+    type: 'event', kind: 'soul-mayor-view', view: { site: { actor, talk }, invited: false, ringCount: 0 },
+  });
+  assert.ok(!hero.frames.some(isResult(1)), 'an accepted presence position is required');
+  hero.send(packet(2));
+  assert.equal((await waitForFrame(hero.frames, isResult(2))).outcome, 'denied');
+  assert.ok(!guest.frames.some(isMayor), 'matching nicknames and spoofed profile details reveal nothing');
+
+  hero.pose(talk);
+  failSave = true;
+  hero.send(packet(3));
+  assert.equal((await waitForFrame(hero.frames, isResult(3))).outcome, 'retry');
+  assert.deepEqual(keysSeen, []);
+  failSave = false;
+  hero.send(packet(4));
+  const accepted = await waitForFrame(hero.frames, isResult(4));
+  const updated = hero.frames.find(frame => isView(frame) && frame.view?.invited);
+  assert.equal(accepted.outcome, 'received');
+  assert.ok(updated && hero.frames.indexOf(updated) < hero.frames.indexOf(accepted));
+  assert.deepEqual(keysSeen, [trustedKey]);
+  assert.ok(!JSON.stringify(hero.frames.filter(isMayor)).includes(trustedKey));
+  hero.send(packet(5));
+  assert.equal((await waitForFrame(hero.frames, isResult(5))).outcome, 'already-received');
+
+  // Reserve enough time for the same accepted movement token budget as normal clients.
+  await delay(220);
+  hero.pose(sharedHomeOrigin);
+  const revokedAtHome = await waitForFrame(hero.frames, frame => isView(frame) && frame.view === null);
+  assert.deepEqual(revokedAtHome, { type: 'event', kind: 'soul-mayor-view', view: null });
+  assert.ok(!positions.some(position => position.height === sharedHomeOrigin.height));
+  hero.close();
+
+  const resumed = await connect(t, port);
+  profiles.set(resumed.id, { key: trustedKey, protagonist: true });
+  resumed.pose(talk);
+  const restored = await waitForFrame(resumed.frames, isView);
+  assert.deepEqual(restored.view, updated.view);
+  encounter = { actor: { ...actor, layer: 'test-plaza' }, talk: { ...talk, layer: 'test-plaza' } };
+  assert.equal((await waitForFrame(resumed.frames, frame => isView(frame) && frame.view === null)).view, null);
+  assert.ok(!guest.frames.some(isMayor));
+  assert.deepEqual(keysSeen, [trustedKey]);
+});
+
+test('default production presence ignores mayor commands until an encounter authority is configured', { timeout: 3000 }, async t => {
+  const server = await createPresenceServer({ connectionLog() {} });
+  t.after(() => server.close());
+  const guest = await connect(t, server.address().port);
+  guest.pose(talk);
+  guest.send(packet(1));
+  guest.send({ type: 'clock', sentAt: 1 });
+  await waitForFrame(guest.frames, frame => frame.type === 'clock');
+  assert.ok(!guest.frames.some(isMayor));
+});
