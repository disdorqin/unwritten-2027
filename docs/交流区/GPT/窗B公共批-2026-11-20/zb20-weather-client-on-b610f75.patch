@@ -0,0 +1,53 @@
+.town-temperature {
+  width: max-content;
+  max-width: 100%;
+  padding: .35rem .6rem;
+  border-radius: .5rem;
+  color: #edf5fd;
+  background: #141e32e8;
+  font-size: .8rem;
+}
+
+body > .town-temperature {
+  position: fixed;
+  z-index: 4;
+  top: max(14px, env(safe-area-inset-top));
+  left: 50%;
+  translate: -50% 0;
+  pointer-events: none;
+}
+
+body:has(:is(#museum-guide, #snowfight-panel):not([hidden])) > .town-temperature {
+  top: calc(max(14px, env(safe-area-inset-top)) + 3.5rem);
+}
+
+.town-temperature label {
+  display: flex;
+  align-items: center;
+  gap: .45rem;
+}
+
+.town-temperature progress {
+  width: 4.75rem;
+  height: .5rem;
+  accent-color: #84c6e7;
+}
+
+.town-temperature-warning {
+  color: #ffdeb2;
+}
+
+.town-temperature.is-freezing .town-temperature-icon {
+  color: #ffdeb2;
+  animation: town-temperature-pulse 1.8s ease-in-out infinite;
+}
+
+@keyframes town-temperature-pulse {
+  50% { opacity: .62; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .town-temperature.is-freezing .town-temperature-icon {
+    animation: none;
+  }
+}
diff --git a/tools/voxel-tavern/town-blockout/town-temperature.ts b/tools/voxel-tavern/town-blockout/town-temperature.ts
