diff --git a/tests/town-blockout-first-beacon-staging.test.ts b/tests/town-blockout-first-beacon-staging.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/town-blockout-first-beacon-staging.test.ts
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Matrix4, Scene, Vector3, type InstancedMesh } from 'three';
+import type { SoulMayorView } from '../src/shared/soul-mayor';
+import { buildTowerLandmark } from '../tools/voxel-tavern/town-blockout/landmark-tower';
+import { createTownFirstBeacon } from '../tools/voxel-tavern/town-blockout/town-first-beacon';
+import { townMascotParts } from '../tools/voxel-tavern/town-blockout/town-mascot';
+import { createTownNpcActivity } from '../tools/voxel-tavern/town-blockout/town-npc';
+import { soulMayorCapacity } from '../tools/voxel-tavern/town-blockout/town-soul-mayor';
+import { layout } from '../tools/voxel-tavern/town-blockout/terrain';
+
+test('the first hearing freezes living pose and station updates while turning only the local mascot head', () => {
+  const plot = layout.plots.find(({ id }) => id === 'clocktower')!;
+  const tower = buildTowerLandmark(plot);
+  tower.position.set(plot.origin[0], plot.origin[2], -plot.origin[1]);
+  const [bellX, bellY, bellZ] = tower.userData.stops.bell;
+  const towerBell = tower.localToWorld(new Vector3(bellX, bellY + 1.8, bellZ));
+  let now = 900_000;
+  let saved: string | null = null;
+  let stationEast = 225;
+  let mayor: SoulMayorView | undefined = {
+    invited: false,
+    ringCount: 11,
+    site: {
+      actor: { layer: 'town', east: 220, north: 188, height: 12 },
+      talk: { layer: 'town', east: 220, north: 187.1, height: 12 },
+    },
+  };
+  const scene = new Scene();
+  const npc = createTownNpcActivity({
+    scene, face() {}, sit() {}, announce() { assert.fail('staging is silent'); },
+    open() { assert.fail('staging never opens a panel'); },
+  }, () => 12, undefined, undefined, undefined, undefined, {
+    now: () => now, groundAt: () => 12, visible: () => true,
+    follow: () => ({ x: 223, n: 180, ground: 12, yaw: -2.6, speed: 0 }),
+  }, {
+    view: () => mayor, async receiveInvitation() { assert.fail('the mayor remains voluntary'); },
+  });
+  const resident = npc.registerResident('樊樵', () => ({
+    actor: [stationEast, 190, 12], talk: [stationEast, 189, 12],
+  }));
+  const batch = scene.children[0] as InstancedMesh;
+  const firstHearing = createTownFirstBeacon({
+    serverNow: () => now,
+    connectedAt: () => 899_900,
+    playAudibleTowerCue: () => true,
+    storage: { getItem: () => saved, setItem: (_key, value) => { saved = value; } },
+  });
+  function update(dt: number) {
+    const sample = firstHearing.sampleScene();
+    npc.update(dt, sample && {
+      livingPaused: sample.livingPaused,
+      mascotLookAt: sample.mascotLooksAtTower ? towerBell : undefined,
+    });
+  }
+  function matrix(index: number) {
+    const value = new Matrix4();
+    batch.getMatrixAt(index, value);
+    return value;
+  }
+  function pose() {
+    const actor = npc.snowballTargets[0];
+    return [actor.x, actor.y, actor.z];
+  }
+
+  update(11);
+  const livingBefore = pose();
+  const population = batch.count;
+  const mascotStart = population - soulMayorCapacity - townMascotParts.length;
+  const mascotEye = mascotStart + townMascotParts.findIndex(part => part.expression === 'eye');
+  const body = matrix(mascotStart);
+  const head = matrix(mascotEye);
+  const mayorMatrix = matrix(population - 1);
+  stationEast = 227;
+  firstHearing.ringTower({ type: 'event', kind: 'town-night-beacon', at: now, expiresAt: now + 2_000 });
+  update(.16);
+  assert.deepEqual(pose(), livingBefore);
+  assert.equal(resident.x, 225);
+  assert.equal(batch.count, population);
+  assert.ok(matrix(mascotStart).equals(body), 'look carries no root-pose or body change on the same sim tick');
+  assert.ok(matrix(population - 1).equals(mayorMatrix));
+  const desired = towerBell.clone().sub(new Vector3().setFromMatrixPosition(head)).normalize();
+  const before = new Vector3(0, 0, 1).transformDirection(head);
+  const turned = new Vector3(0, 0, 1).transformDirection(matrix(mascotEye));
+  assert.ok(turned.y > before.y && turned.dot(desired) > before.dot(desired));
+
+  now += 449;
+  mayor = undefined;
+  update(.29);
+  assert.deepEqual(pose(), livingBefore);
+  assert.equal(resident.x, 225);
+  assert.equal(batch.count, population - soulMayorCapacity, 'private mayor visibility continues updating');
+  now++;
+  update(.05);
+  assert.notDeepEqual(pose(), livingBefore);
+  assert.equal(resident.x, 227);
+
+  now = 901_499;
+  update(0);
+  assert.ok(new Vector3(0, 0, 1).transformDirection(matrix(mascotEye)).y > .25);
+  now++;
+  update(0);
+  assert.ok(Math.abs(new Vector3(0, 0, 1).transformDirection(matrix(mascotEye)).y) < .15);
+  assert.equal(scene.children.length, 1, 'the existing combined render batch is the only draw source');
+});
