diff --git a/tests/server/ice-treasure-presence.test.ts b/tests/server/ice-treasure-presence.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3f7737f2b3923006a8ab96c59838900bb53c5632
--- /dev/null
+++ b/tests/server/ice-treasure-presence.test.ts
@@ -0,0 +1,183 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { test } from 'node:test';
+import { WebSocket } from 'ws';
+import { createPresenceServer } from '../../src/presence/server.js';
+import { PRESENCE_PATH } from '../../src/presence/protocol.js';
+import { decodeSnowballEvents, encodeSnowballHit, encodeSnowballThrow } from '../../src/presence/snowball-events.js';
+import type { IceTreasureRoomUpdate } from '../../src/presence/ice-treasure-room.js';
+
+async function join(town: Awaited<ReturnType<typeof createPresenceServer>>, name: string) {
+  const url = 'ws://127.0.0.1:' + town.address().port + PRESENCE_PATH;
+  const socket = new WebSocket(url);
+  const states: IceTreasureRoomUpdate['state'][] = [];
+  const snowEvents: NonNullable<ReturnType<typeof decodeSnowballEvents>> = [];
+  let resolveId!: (id: number) => void;
+  const joined = new Promise<number>(resolve => { resolveId = resolve; });
+  socket.on('message', (frame, binary) => {
+    if (binary) {
+      if (Buffer.isBuffer(frame) && frame[0] === 0xff) snowEvents.push(...decodeSnowballEvents(frame) ?? []);
+      return;
+    }
+    const event = JSON.parse(frame.toString());
+    if (event.type === 'join' && event.self) resolveId(event.id);
+    if (event.type === 'ice-treasure-state') states.push(event.state);
+  });
+  await once(socket, 'open');
+  socket.send(JSON.stringify({ type: 'join', name }));
+  const id = await joined;
+  let sequence = 0;
+  return {
+    socket, id, states, snowEvents,
+    move(east: number, north: number, height = 10) {
+      const wire = Buffer.alloc(12);
+      [id, Math.round(east * 100), Math.round(north * 100), height * 100, 0, ++sequence]
+        .forEach((value, index) => wire.writeUInt16LE(value, index * 2));
+      socket.send(wire);
+    },
+    pickup(claim?: number) { socket.send(JSON.stringify({ type: 'event', kind: 'ice-treasure-pickup', id: claim })); },
+    async barrier() {
+      const pong = once(socket, 'pong');
+      socket.ping();
+      await pong;
+    },
+  };
+}
+
+const site = {
+  pedestal: { east: 100, north: 100 }, pickupRadius: .75, scoreRingRadius: 3,
+  scoreRings: new Map([['north', { east: 100, north: 122 }], ['south', { east: 100, north: 78 }]]),
+  mode: 'round', resetAfterScoreMs: 100, returnOnCarrierExit: true,
+} as const;
+
+test('configured presence rink broadcasts the existing bell, deduplicates confirmed shots, and updates only its skaters', {
+  timeout: 12_000,
+}, async t => {
+  let time = Date.parse('2026-12-20T20:00:00+08:00');
+  const roster = new Map<number, string>();
+  let iceOpen = true;
+  const town = await createPresenceServer({
+    now: () => time, connectionLog() {},
+    iceTreasure: {
+      site, isIceOpen: () => iceOpen, nowEpochMs: () => time,
+      skaterTeam: (id, foot) => {
+        if (foot.height === 10 && foot.east >= 97 && foot.east <= 103 &&
+            foot.north >= 74 && foot.north <= 126) return roster.get(id);
+      },
+    },
+  });
+  t.after(() => town.close());
+  const [a, b, outsider] = await Promise.all(['北队', '南队', '场外'].map(name => join(town, name)));
+  roster.set(a.id, 'north');
+  roster.set(b.id, 'south');
+  roster.set(outsider.id, 'south');
+
+  async function sync() { await Promise.all([a.barrier(), b.barrier(), outsider.barrier()]); }
+  async function move(client: typeof a, east: number, north: number, height = 10) {
+    time += 150;
+    client.move(east, north, height);
+    await client.barrier();
+    await sync();
+  }
+  await move(a, 100, 100);
+  await move(b, 100, 101);
+  await move(outsider, 100, 100, 20); // Horizontal overlap alone is not rink membership.
+  assert.equal(a.states.at(-1)?.treasure.phase, 'available');
+  assert.deepEqual(a.states.at(-1), b.states.at(-1));
+  outsider.pickup(a.id);
+  await outsider.barrier();
+  await sync();
+  assert.deepEqual(outsider.states, []);
+  assert.equal(a.states.at(-1)?.treasure.phase, 'available');
+
+  a.pickup(b.id);
+  await a.barrier();
+  await sync();
+  assert.deepEqual(a.states.at(-1)?.treasure, { phase: 'carried', player: a.id, snowballHits: 0 });
+  assert.deepEqual(a.states.at(-1), b.states.at(-1));
+  await move(a, 100.12, 100.34);
+
+  async function throwAndHit(ballId: number) {
+    b.socket.send(encodeSnowballThrow({
+      ballId, east: 100, north: 101, height: 11.5, dirX: 0, dirY: 0, dirZ: 1,
+    }));
+    await b.barrier();
+    await sync();
+    assert.ok(a.snowEvents.some(event => event.kind === 'throw' && event.ballId === ballId));
+    const hit = encodeSnowballHit({ ballId, throwerId: b.id, zone: 'torso' });
+    a.socket.send(hit);
+    a.socket.send(hit);
+    await a.barrier();
+    await sync();
+  }
+  await throwAndHit(1);
+  assert.deepEqual(a.states.at(-1)?.treasure, { phase: 'carried', player: a.id, snowballHits: 1 });
+  await throwAndHit(2);
+  const droppedAt = time;
+  assert.deepEqual(b.states.at(-1)?.treasure, {
+    phase: 'dropped', point: { east: 100.12, north: 100.34 }, pickableAt: droppedAt + 3000,
+  });
+  await move(b, 100.12, 100.34);
+  time = droppedAt + 2999;
+  b.pickup();
+  await b.barrier();
+  await sync();
+  assert.equal(b.states.at(-1)?.treasure.phase, 'dropped');
+  time++;
+  b.pickup();
+  await b.barrier();
+  await sync();
+  assert.deepEqual(a.states.at(-1)?.treasure, { phase: 'carried', player: b.id, snowballHits: 0 });
+
+  await move(b, 104, 100);
+  assert.equal(b.states.at(-1), null);
+  assert.equal(a.states.at(-1)?.treasure.phase, 'available');
+  await move(b, 100, 101);
+
+  for (const score of [1, 2, 3]) {
+    await move(a, 100, 100);
+    a.pickup();
+    await a.barrier();
+    await sync();
+    assert.equal(a.states.at(-1)?.treasure.phase, 'carried');
+    await move(a, 100, 78);
+    assert.equal(a.states.at(-1)?.treasure.phase, 'carried', 'another team circle never scores');
+    await move(a, 100, 119);
+    assert.deepEqual(a.states.at(-1), b.states.at(-1));
+    assert.deepEqual(a.states.at(-1)?.scores, [['north', score]]);
+    assert.equal(a.states.at(-1)?.treasure.phase, 'awaiting-reset');
+    assert.equal(a.states.at(-1)?.winner, score === 3 ? 'north' : undefined);
+    time += 100;
+    await move(a, 100, 100);
+    assert.deepEqual(a.states.at(-1)?.scores, [['north', score]]);
+    if (score < 3) {
+      const timeout = Date.now() + 250;
+      while (a.states.at(-1)?.treasure.phase !== 'available' && Date.now() < timeout) {
+        await new Promise(resolve => setTimeout(resolve, 10));
+      }
+      assert.equal(a.states.at(-1)?.treasure.phase, 'available');
+    }
+  }
+  assert.equal(a.states.at(-1)?.winner, 'north');
+  assert.deepEqual(outsider.states, []);
+  iceOpen = false;
+  b.pickup();
+  await b.barrier();
+  await sync();
+  assert.equal(a.states.at(-1), null);
+  assert.equal(b.states.at(-1), null);
+  await move(a, 100, 100);
+  a.pickup();
+  await a.barrier();
+  assert.equal(a.states.at(-1), null);
+});
+
+test('an ordinary listener has no ice treasure action or broadcast without a configured rink', { timeout: 6000 }, async t => {
+  const town = await createPresenceServer({ connectionLog() {} });
+  t.after(() => town.close());
+  const a = await join(town, '普通游客');
+  a.move(100, 100);
+  a.pickup();
+  await a.barrier();
+  assert.deepEqual(a.states, []);
+});
