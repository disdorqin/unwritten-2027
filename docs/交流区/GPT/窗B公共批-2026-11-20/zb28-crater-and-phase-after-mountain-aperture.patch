+test('the mounted crater guard covers both sides of the surveyed fence opening without blocking adjacent terrain', () => {
+  const grid = createTerrainGrid();
+  const road = mountWestCraterRoad(worldBounds.depth, north => grid.groundHeightAt(0, north));
+  const post = mountZa29GuardPost(road.group, 'crater', road.heightAt);
+  const duty = createZa29GuardDuty('crater', post.anchors, () => {});
+  duty.updateDuty(true);
+  try {
+    const fenceEast = road.lip.east + 1;
+    const floor = post.anchors.approach.height;
+    assert.ok(Math.abs(fenceEast - -70.533516397) < .0001);
+    assert.equal(duty.blocksStep(foot(-68.3, 159, floor), foot(-68.5, 159, floor)), false);
+    for (const north of [157.21, 159, 160.79]) {
+      assert.equal(road.fenceBlocks(fenceEast, north, floor, .27), false);
+      for (const height of [floor, floor + 1.26]) {
+        const from = foot(fenceEast + .1, north, height);
+        const to = foot(fenceEast - .1, north, height);
+        assert.equal(duty.blocksStep(from, to), true);
+        assert.equal(duty.blocksStep(to, from), false);
+      }
+    }
+    assert.equal(duty.blocksStep(foot(fenceEast + .1, 153, floor), foot(fenceEast - .1, 153, floor)), false);
+    assert.equal(duty.blocksStep(foot(fenceEast + .1, 159, floor + 3), foot(fenceEast - .1, 159, floor + 3)), false);
+    duty.updateDuty(false);
+    assert.equal(duty.blocksStep(foot(fenceEast + .1, 159, floor), foot(fenceEast - .1, 159, floor)), false);
+  } finally {
+    post.dispose();
+  }
+});
+
+test('a parked sled boards from the open approach but cannot carry a player across a guard or fence', () => {
+  const grid = createTerrainGrid();
+  const road = mountWestCraterRoad(worldBounds.depth, north => grid.groundHeightAt(0, north));
+  const post = mountZa29GuardPost(road.group, 'crater', road.heightAt);
+  const lines: string[] = [];
+  const duty = createZa29GuardDuty('crater', post.anchors, line => lines.push(line));
+  const fenceEast = road.lip.east + 1;
+  const outside = fenceEast + .7, inside = fenceEast - .7;
+  const surveyedHeight = (east: number, north: number) => {
+    const height = road.heightAt(east, north);
+    assert.ok(height !== undefined);
+    return height;
+  };
+  const ride = createSledRide({
+    height: surveyedHeight,
+    surface: () => ({ surface: 0, deepSnow: false }),
+    blocked: (east, north, height) => road.fenceBlocks(east, north, height, .27),
+    canReachParked: (from, to) => !duty.interceptsStep(foot(from.x, from.n, from.y), foot(to.x, to.n, to.y)),
+    snow() {},
+    stopped() {},
+  });
+  try {
+    const level = surveyedHeight(inside, 159);
+    const playerLevel = surveyedHeight(outside, 159);
+    assert.equal(ride.mount(inside, 159, level, 0), true);
+    assert.equal(ride.leave(), true);
+
+    duty.updateDuty(true);
+    assert.equal(ride.canRemount(outside, 159, playerLevel), false);
+    assert.equal(ride.remount(outside, 159, playerLevel), false);
+    assert.deepEqual(lines, []);
+    assert.equal(ride.canRemount(inside - .5, 159, level), true);
+
+    duty.updateDuty(false);
+    assert.equal(ride.remount(outside, 159, playerLevel), true);
+    assert.deepEqual(ride.spot, { x: inside, n: 159, y: level, yaw: 0 });
+
+    const fenceNorth = 155.75;
+    const parkedHeight = surveyedHeight(inside, fenceNorth);
+    const approachHeight = surveyedHeight(outside, fenceNorth);
+    assert.equal(road.fenceBlocks(inside, fenceNorth, parkedHeight, .27), false);
+    assert.equal(road.fenceBlocks(outside, fenceNorth, approachHeight, .27), false);
+    assert.equal(road.fenceBlocks(fenceEast, fenceNorth, (parkedHeight + approachHeight) / 2, .27), true);
+    assert.equal(ride.relocateMounted(inside, fenceNorth, parkedHeight, 0), true);
+    assert.equal(ride.leave(), true);
+    assert.equal(ride.remount(outside, fenceNorth, approachHeight), false);
+    assert.deepEqual(ride.parked(), { x: inside, n: fenceNorth, y: parkedHeight, yaw: 0 });
+  } finally {
+    post.dispose();
+  }
+});
