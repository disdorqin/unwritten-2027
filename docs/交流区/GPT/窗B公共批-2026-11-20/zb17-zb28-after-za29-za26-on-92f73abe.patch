+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Matrix4, Scene, Vector3, type InstancedMesh } from 'three';
+import { buildTowerLandmark } from '../tools/voxel-tavern/town-blockout/landmark-tower';
+import { townMascotParts } from '../tools/voxel-tavern/town-blockout/town-mascot';
+import { createTownNpcActivity } from '../tools/voxel-tavern/town-blockout/town-npc';
+import { layout } from '../tools/voxel-tavern/town-blockout/terrain';
+
+test('a first-hearing sample pauses living updates and turns only the local mascot head toward the actual tower', () => {
+  const plot = layout.plots.find(({ id }) => id === 'clocktower')!;
+  const tower = buildTowerLandmark(plot);
+  tower.position.set(plot.origin[0], plot.origin[2], -plot.origin[1]);
+  const [bellX, bellY, bellZ] = tower.userData.stops.bell;
+  const towerBell = tower.localToWorld(new Vector3(bellX, bellY + 1.8, bellZ));
+  let now = 900_000;
+  let stationEast = 225;
+  const scene = new Scene();
+  const npc = createTownNpcActivity({
+    scene, face() {}, sit() {}, announce() { assert.fail('staging is silent'); },
+    open() { assert.fail('staging opens no panel'); },
+  }, () => 12, undefined, undefined, undefined, undefined, {
+    now: () => now, groundAt: () => 12, visible: () => true,
+    follow: () => ({ x: 223, n: 180, ground: 12, yaw: -2.6, speed: 0 }),
+  });
+  const resident = npc.registerResident('樊樵', () => ({
+    actor: [stationEast, 190, 12], talk: [stationEast, 189, 12],
+  }));
+  const batch = scene.children[0] as InstancedMesh;
+  function matrix(index: number) {
+    const value = new Matrix4();
+    batch.getMatrixAt(index, value);
+    return value;
+  }
+  function pose() {
+    const actor = npc.snowballTargets[0];
+    return [actor.x, actor.y, actor.z];
+  }
+
+  npc.update(11);
+  const population = batch.count;
+  const livingBefore = pose();
+  const mascotStart = population - townMascotParts.length;
+  const mascotEye = mascotStart + townMascotParts.findIndex(part => part.expression === 'eye');
+  const body = matrix(mascotStart);
+  const head = matrix(mascotEye);
+  stationEast = 227;
+
+  npc.update(.45, { livingPaused: true, mascotLookAt: towerBell });
+  assert.deepEqual(pose(), livingBefore);
+  assert.equal(resident.x, 225);
+  assert.equal(batch.count, population);
+  assert.ok(matrix(mascotStart).equals(body));
+  const desired = towerBell.clone().sub(new Vector3().setFromMatrixPosition(head)).normalize();
+  const before = new Vector3(0, 0, 1).transformDirection(head);
+  const turned = new Vector3(0, 0, 1).transformDirection(matrix(mascotEye));
+  assert.ok(turned.y > before.y && turned.dot(desired) > before.dot(desired));
+
+  now += 450;
+  npc.update(.05, { livingPaused: false, mascotLookAt: towerBell });
+  assert.notDeepEqual(pose(), livingBefore);
+  assert.equal(resident.x, 227);
+  now += 1_049;
+  npc.update(0, { livingPaused: false, mascotLookAt: towerBell });
+  assert.ok(new Vector3(0, 0, 1).transformDirection(matrix(mascotEye)).y > .25);
+  now++;
+  npc.update(0);
+  assert.ok(Math.abs(new Vector3(0, 0, 1).transformDirection(matrix(mascotEye)).y) < .15);
+  assert.equal(scene.children.length, 1);
+});
diff --git a/tests/town-blockout-first-beacon.test.ts b/tests/town-blockout-first-beacon.test.ts
new file mode 100644
index 00000000..530b7f82
--- /dev/null
+++ b/tests/town-blockout-first-beacon.test.ts
@@ -0,0 +1,171 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  createTownNightBeaconReceiver,
+  thirteenthBellCatalogueEntry,
+  type TownNightBeaconFrame,
+} from '../src/shared/town-night-beacon.js';
+import { playTowerBell } from '../tools/voxel-tavern/tower-chime.js';
+import { createTownFirstBeacon } from '../tools/voxel-tavern/town-blockout/town-first-beacon.js';
+import { createTownPresenceClock } from '../tools/voxel-tavern/town-blockout/town-presence-clock.js';
+import type { StorageAccess } from '../tools/voxel-tavern/town-blockout/town-text-store.js';
+
+const dayMs = 600_000;
+function beacon(at: number): TownNightBeaconFrame {
+  return { type: 'event', kind: 'town-night-beacon', at, expiresAt: at + 2_000 };
+}
+function browserStorage() {
+  const items = new Map<string, string>();
+  return {
+    getItem: key => items.get(key) ?? null,
+    setItem: (key, value) => { items.set(key, value); },
+  } satisfies StorageAccess;
+}
+
+test('an audible first cue pauses the living together, holds the mascot look briefly and adds one silent row', () => {
+  const cue = beacon(dayMs);
+  const storage = browserStorage();
+  let now = cue.at + 13;
+  const joinedAt = cue.at - 1_000;
+  let sounds = 0;
+  const make = () => createTownFirstBeacon({
+    storage, connectedAt: () => joinedAt, serverNow: () => now,
+    monotonicNow: () => now,
+    playAudibleTowerCue() { sounds++; return true; },
+  });
+  const first = make();
+  const receive = createTownNightBeaconReceiver({ ringTower: first.ringTower });
+  assert.equal(first.catalogueEntry(), undefined);
+  assert.equal(first.sampleScene(), undefined);
+  receive(cue, now);
+  receive(cue, now);
+  assert.equal(sounds, 1);
+  assert.deepEqual(first.sampleScene(), { livingPaused: true, mascotLooksAtTower: true });
+  assert.equal(first.catalogueEntry(), thirteenthBellCatalogueEntry);
+  now += 450;
+  assert.deepEqual(first.sampleScene(), { livingPaused: false, mascotLooksAtTower: true });
+  now += 1_050;
+  assert.equal(first.sampleScene(), undefined);
+
+  const reopened = make();
+  assert.equal(reopened.catalogueEntry(), thirteenthBellCatalogueEntry);
+  assert.equal(reopened.sampleScene(), undefined);
+  now = cue.at + dayMs + 20;
+  createTownNightBeaconReceiver({ ringTower: reopened.ringTower })(beacon(cue.at + dayMs), now);
+  assert.equal(sounds, 2);
+  assert.equal(reopened.sampleScene(), undefined);
+  assert.equal(reopened.catalogueEntry(), thirteenthBellCatalogueEntry);
+});
+
+test('server clock re-anchors cannot restart an actor reaction after its local elapsed time', () => {
+  const cue = beacon(dayMs);
+  let elapsed = 0;
+  const presenceClock = createTownPresenceClock(() => cue.at, () => elapsed);
+  presenceClock.accept(cue.at);
+  const first = createTownFirstBeacon({
+    storage: browserStorage(), connectedAt: () => cue.at - 1_000,
+    serverNow: presenceClock.now, monotonicNow: () => elapsed,
+    playAudibleTowerCue: () => true,
+  });
+  first.ringTower(cue);
+  assert.deepEqual(first.sampleScene(), { livingPaused: true, mascotLooksAtTower: true });
+
+  elapsed = 450;
+  presenceClock.accept(cue.at + 250);
+  assert.equal(presenceClock.now(), cue.at + 250);
+  assert.deepEqual(first.sampleScene(), { livingPaused: false, mascotLooksAtTower: true });
+
+  elapsed = 1_500;
+  presenceClock.accept(cue.at + 750);
+  assert.equal(presenceClock.now(), cue.at + 750);
+  assert.equal(first.sampleScene(), undefined);
+});
+
+test('a suspended audio page leaves the first hearing to a future live cue', () => {
+  let now = dayMs;
+  let context: AudioContext = { state: 'suspended' } as AudioContext;
+  let strikes = 0;
+  const first = createTownFirstBeacon({
+    storage: browserStorage(), connectedAt: () => 10, serverNow: () => now,
+    playAudibleTowerCue: () => playTowerBell(context, 'grand', 20),
+  });
+  const receive = createTownNightBeaconReceiver({ ringTower: first.ringTower });
+  receive(beacon(now), now);
+  assert.equal(first.sampleScene(), undefined);
+  assert.equal(first.catalogueEntry(), undefined);
+
+  const gain = {
+    gain: { value: 0, setValueAtTime() {}, exponentialRampToValueAtTime() {} },
+    connect() { return this; }, disconnect() {},
+  };
+  const filter = { frequency: { value: 0 }, type: '', connect: () => gain };
+  context = {
+    state: 'running', currentTime: 0, destination: {},
+    createBiquadFilter: () => filter, createGain: () => gain,
+    createOscillator: () => ({ frequency: { value: 0 }, connect: () => gain, start() { strikes++; }, stop() {} }),
+  } as unknown as AudioContext;
+  receive(beacon(now), now);
+  assert.equal(strikes, 0);
+  now += dayMs;
+  receive(beacon(now), now);
+  assert.ok(strikes > 0);
+  assert.equal(first.catalogueEntry(), thirteenthBellCatalogueEntry);
+});
+
+test('welcome snapshots, expired cues and a connection established after the live edge consume nothing', () => {
+  const firstNight = beacon(dayMs);
+  const storage = browserStorage();
+  let now = firstNight.at + 100;
+  let connectedAt: number | undefined = now;
+  let plays = 0;
+  function freshScene() {
+    const first = createTownFirstBeacon({
+      storage, serverNow: () => now, connectedAt: () => connectedAt,
+      playAudibleTowerCue() { plays++; return true; },
+    });
+    return { first, receive: createTownNightBeaconReceiver({ ringTower: first.ringTower }) };
+  }
+  const { first, receive } = freshScene();
+  receive({ type: 'welcome', phase: 'night-window', beaconAt: firstNight.at }, now);
+  receive(firstNight, now);
+  now = firstNight.expiresAt;
+  connectedAt = firstNight.at - 1;
+  receive(firstNight, now);
+  assert.equal(plays, 0);
+  assert.equal(first.sampleScene(), undefined);
+  assert.equal(first.catalogueEntry(), undefined);
+
+  const secondNight = beacon(firstNight.at + dayMs);
+  now = secondNight.at + 1;
+  connectedAt = undefined;
+  const disconnected = freshScene();
+  disconnected.receive(secondNight, now);
+  assert.equal(disconnected.first.catalogueEntry(), undefined);
+  assert.equal(plays, 0);
+  connectedAt = secondNight.at - 5_000;
+  const observing = freshScene();
+  observing.receive(secondNight, now);
+  assert.equal(plays, 1);
+  assert.equal(observing.first.catalogueEntry(), thirteenthBellCatalogueEntry);
+});
+
+test('a throwing audio effect preserves other beacon effects and leaves the first hearing open', () => {
+  let now = dayMs;
+  const fakeAudioFailure = new Error('codec unavailable');
+  const first = createTownFirstBeacon({
+    storage: browserStorage(), connectedAt: () => 10, serverNow: () => now,
+    playAudibleTowerCue() { if (now === dayMs) throw fakeAudioFailure; return true; },
+  });
+  let stations = 0;
+  const receive = createTownNightBeaconReceiver({
+    ringTower: first.ringTower,
+    stationBroadcast() { stations++; },
+  });
+  assert.deepEqual(receive(beacon(now), now)?.failures, [fakeAudioFailure]);
+  assert.equal(stations, 1);
+  assert.equal(first.catalogueEntry(), undefined);
+  now += dayMs;
+  receive(beacon(now), now);
+  assert.equal(stations, 2);
+  assert.equal(first.catalogueEntry(), thirteenthBellCatalogueEntry);
+});
