diff --git a/tests/town-blockout-mascot-beacon.test.ts b/tests/town-blockout-mascot-beacon.test.ts
new file mode 100644
index 00000000..1c6097b6
--- /dev/null
+++ b/tests/town-blockout-mascot-beacon.test.ts
@@ -0,0 +1,132 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { BoxGeometry, InstancedMesh, MeshLambertMaterial, Scene } from 'three';
+import { sharedHomeOrigin } from '../src/presence/shared-home-space.js';
+import { createTownNightBeaconReceiver, type TownNightBeaconFrame } from '../src/shared/town-night-beacon.js';
+import { addMascotToNpcBatch, mascotHome } from '../tools/voxel-tavern/town-blockout/town-mascot';
+import { createTownNpcActivity } from '../tools/voxel-tavern/town-blockout/town-npc';
+
+function audioRecorder() {
+  const tones: { frequency: number; start: number; stop: number }[] = [];
+  const ramps: [level: number, time: number][] = [];
+  let state: AudioContextState = 'running';
+  const context = {
+    get state() { return state; },
+    currentTime: 3,
+    destination: {},
+    createOscillator() {
+      const tone = { frequency: 0, start: 0, stop: 0 };
+      tones.push(tone);
+      return {
+        frequency: { setValueAtTime(value: number) { tone.frequency = value; } },
+        start(at: number) { tone.start = at; },
+        stop(at: number) { tone.stop = at; },
+        connect() {},
+        disconnect() {},
+      };
+    },
+    createGain() {
+      return {
+        gain: {
+          setValueAtTime() {},
+          linearRampToValueAtTime(level: number, at: number) { ramps.push([level, at]); },
+        },
+        connect() {},
+        disconnect() {},
+      };
+    },
+    resume() { assert.fail('a bell never unlocks audio'); },
+  } as unknown as AudioContext;
+  return { context, tones, ramps, setState(value: AudioContextState) { state = value; } };
+}
+
+function liveBell(at: number): TownNightBeaconFrame {
+  return { type: 'event', kind: 'town-night-beacon', at, expiresAt: at + 2_000 };
+}
+
+test('the native live beacon rings the existing mascot voice once at its stationary patrol position', () => {
+  const now = 900_000;
+  const audio = audioRecorder();
+  const origins: [east: number, north: number, ground: number][] = [];
+  const npc = createTownNpcActivity({
+    scene: new Scene(),
+    face() {},
+    sit() {},
+    announce() { assert.fail('the cue adds no announcement'); },
+    open() { assert.fail('the cue adds no panel'); },
+  }, () => 12, undefined, undefined, undefined, undefined, {
+    now: () => now,
+    groundAt: () => 12,
+    visible: () => false,
+    bell: {
+      runningAudio: () => audio.context,
+      listenerDistance(...origin) { origins.push(origin); return 8; },
+    },
+  });
+  const receive = createTownNightBeaconReceiver({ ringMascotBell: npc.ringMascotBell });
+  const bell = liveBell(now);
+  assert.equal(receive({ ...bell, type: 'snapshot' }, now), undefined);
+  assert.equal(audio.tones.length, 0);
+  assert.deepEqual(receive(bell, now)?.failures, []);
+  assert.equal(receive(bell, now), undefined);
+  assert.equal(npc.ringMascotBell(bell), false);
+  assert.deepEqual(origins, [[...mascotHome, 12]]);
+  assert.deepEqual(audio.tones, [
+    { frequency: 920, start: 3, stop: 3 + .15 },
+    { frequency: 1470, start: 3, stop: 3 + .082 },
+  ]);
+  assert.deepEqual(audio.ramps, [
+    [.030 * .25, 3 + .006], [0, 3 + .15],
+    [.014 * .25, 3 + .006], [0, 3 + .082],
+  ]);
+});
+
+test('missed cues cannot replay after audio unlock, range changes, or leaving the shared home', () => {
+  let now = 900_000;
+  let distance: number | undefined = 16;
+  const audio = audioRecorder();
+  const origins: [east: number, north: number, ground: number][] = [];
+  const outdoors = { x: 232, n: 190, ground: 12, yaw: 0, speed: 0 };
+  let follow = outdoors;
+  const batch = new InstancedMesh(new BoxGeometry(), new MeshLambertMaterial(), 100);
+  const mascot = addMascotToNpcBatch(batch, 0, {
+    now: () => now,
+    groundAt: () => 12,
+    visible: () => true,
+    follow: () => follow,
+    bell: {
+      runningAudio: () => audio.context,
+      listenerDistance(...origin) { origins.push(origin); return distance; },
+    },
+  });
+  const outOfRange = liveBell(now);
+  assert.equal(mascot.ringBeacon(outOfRange), false);
+  distance = 0;
+  assert.equal(mascot.ringBeacon(outOfRange), false);
+
+  const suspended = liveBell(++now);
+  audio.setState('suspended');
+  assert.equal(mascot.ringBeacon(suspended), false);
+  audio.setState('running');
+  assert.equal(mascot.ringBeacon(suspended), false);
+
+  const privateHome = liveBell(++now);
+  follow = {
+    ...outdoors, x: sharedHomeOrigin.east, n: sharedHomeOrigin.north, ground: sharedHomeOrigin.height,
+  };
+  assert.equal(mascot.ringBeacon(privateHome), false);
+  follow = outdoors;
+  assert.equal(mascot.ringBeacon(privateHome), false);
+
+  now += 3_000;
+  assert.equal(mascot.ringBeacon(liveBell(now - 2_000)), false);
+  assert.equal(mascot.ringBeacon(liveBell(now + 1)), false);
+  distance = undefined;
+  assert.equal(mascot.ringBeacon(liveBell(now)), false);
+  assert.equal(audio.tones.length, 0);
+
+  distance = 4;
+  assert.equal(mascot.ringBeacon(liveBell(++now)), true);
+  assert.equal(audio.tones.length, 2);
+  assert.deepEqual(origins, Array.from({ length: 4 }, () => [outdoors.x, outdoors.n, outdoors.ground]));
+});
