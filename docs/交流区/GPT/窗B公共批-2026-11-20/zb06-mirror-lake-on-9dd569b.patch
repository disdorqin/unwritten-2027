@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, type Mesh } from 'three';
+import { addTerrainMeshes } from '../tools/voxel-tavern/town-blockout/terrain-mesh';
+import { createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain';
+
+test('regional terrain refresh reuses GPU attributes and restores the old tile', () => {
+  const grid = createTerrainGrid();
+  const scene = new Group();
+  const prepare = addTerrainMeshes(scene, grid);
+  const target = scene.getObjectByName('Terrain 0,128') as Mesh | undefined;
+  const remote = scene.getObjectByName('Terrain 128,128') as Mesh | undefined;
+  assert.ok(target?.isMesh);
+  assert.ok(remote?.isMesh);
+  const shared = target.geometry.getAttribute('position');
+  assert.equal(remote.geometry.getAttribute('position'), shared);
+  const start = target.geometry.drawRange.start;
+  const end = start + target.geometry.drawRange.count;
+  let vertex = start;
+  for (; vertex < end; vertex++) {
+    if (shared.getX(vertex) === 50 && shared.getZ(vertex) === -185) break;
+  }
+  assert.ok(vertex < end);
+  const index = 185 * grid.gridWidth + 50;
+  const original = grid.elevation[index];
+  const remoteVertex = remote.geometry.drawRange.start;
+  const remoteY = shared.getY(remoteVertex);
+  const bounds = { west: 50, east: 50, south: 185, north: 185 };
+  grid.elevation[index] = 10;
+  prepare.refreshRegion(bounds);
+  assert.equal(target.geometry.getAttribute('position'), shared);
+  assert.equal(shared.getY(vertex), 10);
+  assert.equal(shared.getY(remoteVertex), remoteY);
+  grid.elevation[index] = original;
+  prepare.refreshRegion(bounds);
+  assert.equal(shared.getY(vertex), original);
+  assert.equal(scene.getObjectByName('Terrain 0,128'), target);
+});
