+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group } from 'three';
+import { addScenery } from '../tools/voxel-tavern/town-blockout/scenery';
+import { addDistrictHousing } from '../tools/voxel-tavern/town-blockout/district-layout';
+import { addForestDensity } from '../tools/voxel-tavern/town-blockout/forest-density';
+import { addStreetscape } from '../tools/voxel-tavern/town-blockout/streetscape';
+import { createTownRailway } from '../tools/voxel-tavern/town-blockout/town-railway';
+import { buildPineCamp } from '../tools/voxel-tavern/town-blockout/town-pine-camp';
+import { extensionRoadClearance, extensionStreetClearance } from '../tools/voxel-tavern/town-blockout/town-extension';
+import { canEnter, createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain';
+import { readWalkGeometry, type Box } from '../tools/voxel-tavern/town-blockout/landmark-kit';
+import { createMirrorLakeHost } from '../tools/voxel-tavern/town-blockout/mirror-lake-host';
+import { mirrorF2RoadAt } from '../tools/voxel-tavern/town-blockout/mirror-lake-f2-slope';
+
+type Point = readonly [east: number, north: number];
+const gradient = { addColorStop() {} };
+const surfaceContext = { createRadialGradient: () => gradient, fillRect() {}, strokeRect() {}, fillText() {}, drawImage() {} };
+function drawFixture<T>(run: () => T) {
+  const original = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: {
+    createElement: () => ({ getContext: () => surfaceContext }),
+  } });
+  try { return run(); }
+  finally {
+    if (original) Object.defineProperty(globalThis, 'document', original);
+    else Reflect.deleteProperty(globalThis, 'document');
+  }
+}
+
+const west = [[21.5, 177.1], [22.5, 177.1], [26.5, 177.1], [27.8, 175.8], [29.85, 176.1], [30.45, 177.3], [29.8, 178.65], [27.5, 179.6], [26.5, 179.8], [25.2, 180.5], [24.5, 181.5], [24.5, 182], [25.15, 181.55], [26.5, 181.4], [28.7, 181.4], [31.6, 181.3], [33.2, 179.6], [33.4, 176.8], [33.4, 173], [33.9, 170], [36.3, 168.8], [37.3, 168.3]] as const;
+const east: readonly Point[] = [
+  [mirrorF2RoadAt(210).centerEast, 210], [mirrorF2RoadAt(210.85).centerEast, 210.85],
+  [72.8, 210.85], [70.70, 209.65],
+];
+const island: readonly Point[] = [
+  [50, 195], [50, 202.1], [47.5, 203.1], [47.7, 204.6], [50, 204.9], [51.8, 205.1], [51.9, 210.9], [50, 212.4],
+];
+
+test('surveyed station, F2 road and tiger island support both directions in the town geometry', () => {
+  const grid = createTerrainGrid();
+  const roadY = grid.heightAt(mirrorF2RoadAt(210).centerEast, 210);
+  const host = createMirrorLakeHost(grid);
+  drawFixture(() => host.setMounted(true));
+  const root = new Group();
+  const railway = createTownRailway(grid, () => 0);
+  const pine = buildPineCamp(grid);
+  const scenery = drawFixture(() => addScenery(root, grid, pine.keepClear));
+  const districts = addDistrictHousing(root, grid, scenery.blocked, railway.keepClear);
+  const streets = addStreetscape(root, grid, (e, n, r) => districts.keepClear(e, n, r) ||
+    extensionRoadClearance(e, n, r) || pine.keepClear(e, n, r));
+  const forest = addForestDensity(root, grid, (e, n, r) => districts.keepClear(e, n, r) ||
+    streets.occupied(e, n, r) || pine.keepClear(e, n, r), (e, n, r) =>
+    extensionRoadClearance(e, n, r) || railway.keepClear(e, n, r) || extensionStreetClearance(e, n, r));
+  const models = [...host.collisionGroups, railway.group].map(readWalkGeometry);
+  const floors = models.flatMap(model => model.floors);
+  const solid = [...floors, ...models.flatMap(model => model.colliders)];
+  const overlaps = (e: number, n: number, { min, max }: Box) =>
+    Math.hypot(Math.max(min[0] - e, e - max[0], 0), Math.max(min[2] + n, -n - max[2], 0)) < .27;
+
+  function walk(path: readonly Point[], feet: number) {
+    let samples = 0, maxStep = 0;
+    for (const [index, [e, n]] of path.slice(1).entries()) {
+      const [a, b] = path[index];
+      const steps = Math.ceil(Math.hypot(e - a, n - b) / .08);
+      for (let step = 1; step <= steps; step++) {
+        const x = a + (e - a) * step / steps, north = b + (n - b) * step / steps;
+        const surface = host.exposedSurfaceAt(x, north) ?? grid.heightAt(x, north);
+        const next = Math.max(surface, host.supportAt(x, north, feet + .43),
+          ...floors.filter(box => box.max[1] <= feet + .43 && overlaps(x, north, box)).map(box => box.max[1]));
+        const delta = Math.abs(next - feet);
+        const context = `E${x}/N${north}; ${feet} → ${next}`;
+        assert.ok(delta <= .43 && canEnter(x, north), context);
+        assert.ok(!scenery.blocked(x, north) && !districts.blocked(x, north) && !streets.blocked(x, north) &&
+          !forest.blocked(x, north) && !railway.vehicleBlocks(x, north, next, 1.8, .27), context);
+        assert.ok(!host.blocks(x, north, next, 1.8, .025) && !solid.some(box => next + .025 < box.max[1] &&
+          next + 1.8 - .025 > box.min[1] && overlaps(x, north, box)), context);
+        feet = next;
+        samples++;
+        maxStep = Math.max(maxStep, delta);
+      }
+      if (e === 47.5 && n === 203.1) assert.equal(feet, 11.2);
+    }
+    return { feet, samples, maxStep };
+  }
+
+  try {
+    for (const [route, path, start, end, samples] of [
+      ['west', west, 16.34, 10, 528], ['east', east, roadY, 10, 221], ['island', island, 10, 11.2, 298],
+    ] as const) {
+      const out = walk(path, start), back = walk([...path].reverse(), end);
+      assert.ok(Math.abs(out.feet - end) < .001 && Math.abs(back.feet - start) < .001, route);
+      assert.equal(out.samples, samples);
+      assert.equal(back.samples, samples);
+      console.log(JSON.stringify({ route, out, back }));
+    }
+
+    // The approved old walking strip crosses under the station deck without snapping to it.
+    const low = host.supportAt(24.39, 177.1, 15);
+    const high = host.supportAt(24.39, 177.1, 17);
+    assert.ok(low > 13 && low < 15, String(low));
+    assert.equal(high, 16.34);
+    assert.ok(host.ceilingAt(24.39, 177.1, low) - low > 1.8);
+    assert.equal(host.blocks(24.39, 177.1, low, 1.8, .025), false);
+  } finally { host.dispose(); }
+});
