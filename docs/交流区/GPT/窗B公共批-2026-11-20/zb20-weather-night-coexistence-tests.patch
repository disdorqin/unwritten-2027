diff --git a/tests/server/town-night-weather-coexistence.test.ts b/tests/server/town-night-weather-coexistence.test.ts
new file mode 100644
index 0000000..c3a753c
--- /dev/null
+++ b/tests/server/town-night-weather-coexistence.test.ts
@@ -0,0 +1,180 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { setTimeout as delay } from 'node:timers/promises';
+import { WebSocket } from 'ws';
+import { createPresenceServer } from '../../src/presence/server.js';
+import { readTownNightOptions } from '../../src/presence/town-night-config.js';
+import { createOrdinaryTownNightSchedule } from '../../src/shared/town-night-window.js';
+
+type Frame = {
+  type?: string;
+  kind?: string;
+  self?: boolean;
+  epochMs?: number;
+  at?: number;
+  expiresAt?: number;
+  townCalendarDawnEpoch?: number;
+  townNightWindow?: { phase: string; canEnterRestricted: boolean; layersOverlap: boolean };
+  townOutdoorWeather?: { weather: string; startedAt: number; nextChangeAt: number };
+  state?: { phase?: string; weather?: string; canEnterRestricted?: boolean; layersOverlap?: boolean };
+};
+
+async function until(frames: Frame[], predicate: (frame: Frame) => boolean) {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const frame = frames.find(predicate);
+    if (frame) return frame;
+    await delay(10);
+  }
+  assert.fail('Presence frame timed out');
+}
+
+async function openSocket(port: number) {
+  const socket = new WebSocket(`ws://127.0.0.1:${port}/presence`);
+  const frames: Frame[] = [];
+  socket.on('message', (raw, binary) => { if (!binary) frames.push(JSON.parse(raw.toString())); });
+  await once(socket, 'open');
+  socket.send(JSON.stringify({ type: 'join', name: '夜窗天气同钟甲' }));
+  const self = await until(frames, frame => frame.type === 'join' && frame.self === true);
+  return { socket, frames, self };
+}
+
+async function poll(port: number, path: string, session?: string) {
+  const response = await fetch(`http://127.0.0.1:${port}/presence/poll${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...(session ? { 'x-presence-session': session } : {}) },
+    body: JSON.stringify(path === '/join' ? { name: '夜窗天气同钟乙' } : {}),
+  });
+  assert.equal(response.status, 200);
+  const result = await response.json() as { session?: string; messages: { t: string; d: string }[] };
+  return {
+    session: result.session,
+    frames: result.messages.filter(frame => frame.t === 'text').map(frame => JSON.parse(frame.d) as Frame),
+  };
+}
+
+const isBeacon = (frame: Frame) => frame.kind === 'town-night-beacon';
+const isWarning = (frame: Frame) => frame.kind === 'town-outdoor-weather-warning';
+const isSelf = (frame: Frame) => frame.type === 'join' && frame.self === true;
+
+test('startup derives both clocks from one validated dawn and restores each receipt independently', async t => {
+  const directory = await mkdtemp(join(tmpdir(), 'town-night-weather-'));
+  t.after(() => rm(directory, { recursive: true, force: true }));
+  const receiptPath = join(directory, 'beacon.json');
+  const dawnEpoch = Date.parse('2026-11-20T10:00:00+08:00');
+  const schedule = JSON.stringify({
+    dawnEpoch, beaconOffsetsAfterDusk: Array(12).fill(60_000), cueFreshnessMs: 2_000,
+  });
+
+  const startup = readTownNightOptions(schedule, receiptPath)!;
+  assert.equal(startup.outdoorWeather.dawnEpoch, dawnEpoch);
+  assert.equal(startup.outdoorWeather.restoredWarningAt, undefined);
+  const beaconAt = startup.scheduleAt(dawnEpoch)!.beaconAt;
+  const warningAt = dawnEpoch + 29.5 * 60_000;
+  startup.saveBeacon!(beaconAt);
+  startup.outdoorWeather.saveWarning(warningAt);
+  assert.equal(await readFile(receiptPath, 'utf8'), JSON.stringify(beaconAt));
+  assert.equal(await readFile(`${receiptPath}.weather`, 'utf8'), JSON.stringify(warningAt));
+
+  const restored = readTownNightOptions(schedule, receiptPath)!;
+  assert.equal(restored.restoredBeaconAt, beaconAt);
+  assert.equal(restored.outdoorWeather.restoredWarningAt, warningAt);
+  await writeFile(`${receiptPath}.weather`, 'false');
+  assert.throws(() => readTownNightOptions(schedule, receiptPath), /Invalid town weather warning receipt/);
+});
+
+test('one production wall clock drives beacons and weather warnings across WS and poll without replay', { timeout: 5_000 }, async t => {
+  const dawnEpoch = Date.parse('2026-11-20T10:00:00+08:00');
+  const scheduleAt = createOrdinaryTownNightSchedule({
+    dawnEpoch, beaconOffsetsAfterDusk: Array(12).fill(60_000), cueFreshnessMs: 2_000,
+  });
+  const windAt = dawnEpoch + 30 * 60_000;
+  const warningAt = windAt - 30_000;
+  const beaconAt = scheduleAt(warningAt)!.beaconAt;
+  let epoch = beaconAt - 1;
+  const beaconReceipts: number[] = [];
+  const warningReceipts: number[] = [];
+  let legacyClockReads = 0;
+
+  async function start(restoredBeaconAt?: number, restoredWarningAt?: number) {
+    const server = await createPresenceServer({
+      connectionLog() {},
+      wallNow: () => epoch,
+      townNight: { scheduleAt, restoredBeaconAt, saveBeacon: at => beaconReceipts.push(at) },
+      outdoorWeather: {
+        dawnEpoch,
+        restoredWarningAt,
+        nowEpochMs: () => { legacyClockReads++; return epoch + 86_400_000; },
+        saveWarning: at => warningReceipts.push(at),
+      },
+    });
+    t.after(() => server.close());
+    return server;
+  }
+
+  const server = await start();
+  const port = server.address().port;
+  const ws = await openSocket(port);
+  t.after(() => ws.socket.terminate());
+  const joined = await poll(port, '/join');
+  assert.ok(joined.session);
+  const pollSelf = joined.frames.find(isSelf);
+  assert.equal(ws.self.epochMs, epoch);
+  assert.equal(pollSelf?.epochMs, epoch);
+  assert.equal(ws.self.townCalendarDawnEpoch, dawnEpoch);
+  assert.deepEqual(pollSelf?.townNightWindow, ws.self.townNightWindow);
+  assert.deepEqual(pollSelf?.townOutdoorWeather, ws.self.townOutdoorWeather);
+  assert.equal(ws.self.townNightWindow?.canEnterRestricted, false);
+  assert.equal(ws.self.townOutdoorWeather?.weather, 'clear-snow');
+  ws.socket.send(JSON.stringify({ type: 'clock', sentAt: 1 }));
+  assert.equal((await until(ws.frames, frame => frame.type === 'clock')).epochMs, epoch);
+
+  epoch = beaconAt;
+  const beacon = await until(ws.frames, isBeacon);
+  const open = await until(ws.frames, frame => frame.kind === 'town-night-window' && frame.state?.layersOverlap === true);
+  const pollAfterBeacon = await poll(port, '', joined.session);
+  assert.deepEqual(pollAfterBeacon.frames.filter(isBeacon), [beacon]);
+  assert.ok(pollAfterBeacon.frames.some(frame => frame.kind === 'town-night-window' && frame.state?.layersOverlap === true));
+  assert.deepEqual(beaconReceipts, [beaconAt]);
+  assert.equal(open.state?.canEnterRestricted, true);
+  assert.ok(!pollAfterBeacon.frames.some(isWarning));
+
+  epoch = warningAt;
+  const warning = await until(ws.frames, isWarning);
+  assert.equal(warning.at, warningAt);
+  assert.equal(warning.expiresAt, windAt);
+  assert.deepEqual((await poll(port, '', joined.session)).frames.filter(isWarning), [warning]);
+  assert.ok(!(await poll(port, '', joined.session)).frames.some(isWarning));
+  assert.deepEqual(warningReceipts, [warningAt]);
+  assert.equal(ws.frames.filter(isWarning).length, 1);
+  assert.equal(ws.frames.filter(isBeacon).length, 1);
+  await server.close();
+
+  const resumed = await start(beaconReceipts[0], warningReceipts[0]);
+  const resumedPort = resumed.address().port;
+  const afterRestart = await openSocket(resumedPort);
+  t.after(() => afterRestart.socket.terminate());
+  const pollReconnect = await poll(resumedPort, '/join');
+  assert.ok(pollReconnect.session);
+  assert.equal(afterRestart.self.epochMs, warningAt);
+  assert.equal(afterRestart.self.townNightWindow?.canEnterRestricted, true);
+  assert.equal(afterRestart.self.townNightWindow?.layersOverlap, false);
+  assert.equal(afterRestart.self.townOutdoorWeather?.weather, 'clear-snow');
+  assert.ok(!pollReconnect.frames.some(frame => isWarning(frame) || isBeacon(frame)));
+
+  epoch = windAt;
+  const day = await until(afterRestart.frames, frame => frame.kind === 'town-night-window' && frame.state?.phase === 'day');
+  const wind = await until(afterRestart.frames, frame => frame.kind === 'town-outdoor-weather' && frame.state?.weather === 'wind');
+  const pollAtDawn = await poll(resumedPort, '', pollReconnect.session);
+  assert.ok(pollAtDawn.frames.some(frame => frame.kind === day.kind && frame.state?.phase === 'day'));
+  assert.deepEqual(pollAtDawn.frames.filter(frame => frame.kind === 'town-outdoor-weather'), [wind]);
+  assert.equal(day.state?.canEnterRestricted, false);
+  assert.ok(!afterRestart.frames.some(frame => isWarning(frame) || isBeacon(frame)));
+  assert.ok(!pollAtDawn.frames.some(frame => isWarning(frame) || isBeacon(frame)));
+  assert.deepEqual(beaconReceipts, [beaconAt]);
+  assert.deepEqual(warningReceipts, [warningAt]);
+  assert.equal(legacyClockReads, 0);
+});
