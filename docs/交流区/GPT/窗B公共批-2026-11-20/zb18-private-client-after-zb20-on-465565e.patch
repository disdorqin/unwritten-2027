diff --git a/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts b/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts
new file mode 100644
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts
@@ -0,0 +1,62 @@
+import type { SoulMayorView } from '../../../src/shared/soul-mayor.js';
+import { readStarStoneLocation } from '../../../src/shared/zodiac-star-stones.js';
+
+const invitationKind = 'soul-mayor-accept-invitation';
+const invitationTimeoutMs = 5_000;
+
+function readView(raw: unknown): SoulMayorView | undefined {
+  if (!raw || typeof raw !== 'object') return;
+  const { site, invited, ringCount } = raw as Record<string, unknown>;
+  if (!site || typeof site !== 'object' || typeof invited !== 'boolean' ||
+      typeof ringCount !== 'number' || !Number.isInteger(ringCount) || ringCount < 0 || ringCount > 12) return;
+  const { actor: rawActor, talk: rawTalk } = site as Record<string, unknown>;
+  const actor = readStarStoneLocation(rawActor);
+  const talk = readStarStoneLocation(rawTalk);
+  if (!actor || !talk || actor.layer !== talk.layer) return;
+  return Object.freeze({ site: Object.freeze({ actor: Object.freeze(actor), talk: Object.freeze(talk) }), invited, ringCount });
+}
+
+export function isSoulMayorInvitationRequest(event: string | Uint8Array) {
+  if (typeof event !== 'string') return false;
+  try { return JSON.parse(event)?.kind === invitationKind; }
+  catch { return false; }
+}
+
+/** Receive only private views from this player's current, joined presence session. */
+export function createTownPresenceSoulMayor(send: (event: string) => boolean) {
+  let current: SoulMayorView | undefined;
+  let lastRequest = 0;
+  let pending: { requestId: number; finish(): void } | undefined;
+
+  function finishPending() {
+    const request = pending;
+    pending = undefined;
+    request?.finish();
+  }
+
+  return {
+    view: () => current,
+    receiveInvitation(): Promise<void> {
+      if (!current || current.invited || pending) return Promise.resolve();
+      const requestId = ++lastRequest;
+      return new Promise(resolve => {
+        const timer = setTimeout(finishPending, invitationTimeoutMs);
+        pending = { requestId, finish() { clearTimeout(timer); resolve(); } };
+        if (!send(JSON.stringify({ type: 'event', kind: invitationKind, requestId }))) finishPending();
+      });
+    },
+    acceptView(raw: unknown) {
+      current = readView(raw);
+      if (!current) finishPending();
+    },
+    acceptResult(requestId: unknown, outcome: unknown) {
+      if (!pending || pending.requestId !== requestId ||
+          (outcome !== 'received' && outcome !== 'already-received' && outcome !== 'retry' && outcome !== 'denied')) return;
+      finishPending();
+    },
+    clear() {
+      current = undefined;
+      finishPending();
+    },
+  };
+}
diff --git a/tests/town-blockout-soul-mayor-transport.test.ts b/tests/town-blockout-soul-mayor-transport.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/town-blockout-soul-mayor-transport.test.ts
@@ -0,0 +1,71 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  createTownPresenceSoulMayor, isSoulMayorInvitationRequest,
+} from '../tools/voxel-tavern/town-blockout/town-presence-soul-mayor';
+
+const actor = { layer: 'town', east: 220, north: 188, height: 12 };
+const talk = { ...actor, north: 187 };
+const offer = { site: { actor, talk }, invited: false, ringCount: 11 };
+
+test('a private view is validated without deriving visibility from a local identity', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  await mayor.receiveInvitation();
+  assert.equal(mayor.view(), undefined);
+  assert.deepEqual(sent, []);
+  mayor.acceptView({ ...offer, ringCount: 13 });
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView({ ...offer, site: { actor, talk: { ...talk, layer: 'shared-home' } } });
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView(offer);
+  assert.deepEqual(mayor.view(), offer);
+  assert.ok(Object.isFrozen(mayor.view()?.site.talk));
+  mayor.acceptView(null);
+  assert.equal(mayor.view(), undefined);
+});
+
+test('only one invitation action is pending and then only its server result can complete it', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(offer);
+  let complete = false;
+  const first = mayor.receiveInvitation().then(() => { complete = true; });
+  await mayor.receiveInvitation();
+  assert.deepEqual(sent.map(message => JSON.parse(message)), [
+    { type: 'event', kind: 'soul-mayor-accept-invitation', requestId: 1 },
+  ]);
+  mayor.acceptResult(2, 'received');
+  mayor.acceptResult(1, 'invalid');
+  await Promise.resolve();
+  assert.equal(complete, false);
+  assert.equal(mayor.view()?.invited, false);
+  mayor.acceptView({ ...offer, invited: true });
+  mayor.acceptResult(1, 'received');
+  await first;
+  await mayor.receiveInvitation();
+  assert.equal(mayor.view()?.invited, true);
+  assert.equal(sent.length, 1);
+});
+
+test('disconnect clears view and pending action and does not let its old result settle a new session', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(offer);
+  const first = mayor.receiveInvitation();
+  mayor.clear();
+  await first;
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView(offer);
+  let complete = false;
+  const second = mayor.receiveInvitation().then(() => { complete = true; });
+  assert.ok(sent.every(isSoulMayorInvitationRequest));
+  assert.equal(isSoulMayorInvitationRequest('{"type":"event","kind":"snowfight-request"}'), false);
+  assert.equal(isSoulMayorInvitationRequest(new Uint8Array()), false);
+  mayor.acceptResult(1, 'received');
+  await Promise.resolve();
+  assert.equal(complete, false);
+  mayor.acceptResult(2, 'denied');
+  await second;
+  assert.equal(mayor.view()?.invited, false);
+});
