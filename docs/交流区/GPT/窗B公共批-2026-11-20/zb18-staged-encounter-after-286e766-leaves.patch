diff --git a/tests/town-blockout-soul-mayor-stage.test.ts b/tests/town-blockout-soul-mayor-stage.test.ts
new file mode 100644
index 0000000..f75057e
--- /dev/null
+++ b/tests/town-blockout-soul-mayor-stage.test.ts
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import type { SoulMayorView } from '../src/shared/soul-mayor';
+import { createTownPresenceSoulMayor } from '../tools/voxel-tavern/town-blockout/town-presence-soul-mayor';
+
+const actor = { layer: 'test-town', east: 10, north: 12, height: 2 };
+const talk = { ...actor, north: 11 };
+const greeting: SoulMayorView = { site: { stage: 'station-greeting', actor, talk }, invited: false, ringCount: 0 };
+const offer: SoulMayorView = { ...greeting, site: { ...greeting.site, stage: 'plaza-invitation' } };
+
+test('station greeting views remain visible and unsupported stages fail closed without sending an invitation', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(greeting);
+  assert.deepEqual(mayor.view(), greeting);
+  await mayor.receiveInvitation();
+  mayor.acceptView({ ...greeting, site: { actor, talk } });
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView({ ...greeting, site: { ...greeting.site, stage: 'other-scene' } });
+  assert.equal(mayor.view(), undefined);
+  await mayor.receiveInvitation();
+  assert.deepEqual(sent, []);
+});
+
+test('switching an open plaza offer to a greeting settles a pending action and disables new requests', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(offer);
+  const pending = mayor.receiveInvitation();
+  mayor.acceptView(greeting);
+  await pending;
+  await mayor.receiveInvitation();
+  assert.deepEqual(mayor.view(), greeting);
+  assert.deepEqual(sent.map(message => JSON.parse(message)), [
+    { type: 'event', kind: 'soul-mayor-accept-invitation', requestId: 1 },
+  ]);
+});
