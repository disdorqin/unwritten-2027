diff --git a/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts b/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts
new file mode 100644
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/town-presence-soul-mayor.ts
@@ -0,0 +1,62 @@
+import type { SoulMayorView } from '../../../src/shared/soul-mayor.js';
+import { readStarStoneLocation } from '../../../src/shared/zodiac-star-stones.js';
+
+const invitationKind = 'soul-mayor-accept-invitation';
+const invitationTimeoutMs = 5_000;
+
+function readView(raw: unknown): SoulMayorView | undefined {
+  if (!raw || typeof raw !== 'object') return;
+  const { site, invited, ringCount } = raw as Record<string, unknown>;
+  if (!site || typeof site !== 'object' || typeof invited !== 'boolean' ||
+      typeof ringCount !== 'number' || !Number.isInteger(ringCount) || ringCount < 0 || ringCount > 12) return;
+  const { actor: rawActor, talk: rawTalk } = site as Record<string, unknown>;
+  const actor = readStarStoneLocation(rawActor);
+  const talk = readStarStoneLocation(rawTalk);
+  if (!actor || !talk || actor.layer !== talk.layer) return;
+  return Object.freeze({ site: Object.freeze({ actor: Object.freeze(actor), talk: Object.freeze(talk) }), invited, ringCount });
+}
+
+export function isSoulMayorInvitationRequest(event: string | Uint8Array) {
+  if (typeof event !== 'string') return false;
+  try { return JSON.parse(event)?.kind === invitationKind; }
+  catch { return false; }
+}
+
+/** Receive only private views from this player's current, joined presence session. */
+export function createTownPresenceSoulMayor(send: (event: string) => boolean) {
+  let current: SoulMayorView | undefined;
+  let lastRequest = 0;
+  let pending: { requestId: number; finish(): void } | undefined;
+
+  function finishPending() {
+    const request = pending;
+    pending = undefined;
+    request?.finish();
+  }
+
+  return {
+    view: () => current,
+    receiveInvitation(): Promise<void> {
+      if (!current || current.invited || pending) return Promise.resolve();
+      const requestId = ++lastRequest;
+      return new Promise(resolve => {
+        const timer = setTimeout(finishPending, invitationTimeoutMs);
+        pending = { requestId, finish() { clearTimeout(timer); resolve(); } };
+        if (!send(JSON.stringify({ type: 'event', kind: invitationKind, requestId }))) finishPending();
+      });
+    },
+    acceptView(raw: unknown) {
+      current = readView(raw);
+      if (!current) finishPending();
+    },
+    acceptResult(requestId: unknown, outcome: unknown) {
+      if (!pending || pending.requestId !== requestId ||
+          (outcome !== 'received' && outcome !== 'already-received' && outcome !== 'retry' && outcome !== 'denied')) return;
+      finishPending();
+    },
+    clear() {
+      current = undefined;
+      finishPending();
+    },
+  };
+}
diff --git a/tests/town-blockout-soul-mayor-transport.test.ts b/tests/town-blockout-soul-mayor-transport.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/town-blockout-soul-mayor-transport.test.ts
@@ -0,0 +1,196 @@
+import assert from 'node:assert/strict';
+import { registerHooks } from 'node:module';
+import { test } from 'node:test';
+import { PerspectiveCamera, Scene } from 'three';
+import { MASCOT_ACTOR_ID } from '../src/presence/protocol';
+import { sharedHomeOrigin } from '../src/presence/shared-home-space';
+import { presenceRecordBytes, writePresencePose } from '../tools/voxel-tavern/town-blockout/town-presence-motion';
+import {
+  createTownPresenceSoulMayor, isSoulMayorInvitationRequest,
+} from '../tools/voxel-tavern/town-blockout/town-presence-soul-mayor';
+
+const actor = { layer: 'town', east: 220, north: 188, height: 12 };
+const talk = { ...actor, north: 187 };
+const offer = { site: { actor, talk }, invited: false, ringCount: 11 };
+
+test('domain switching preserves weather, night and wire transforms while clearing private mayor state', async t => {
+  const styleHook = registerHooks({
+    load(url, context, next) {
+      if (url.endsWith('/town-presence-avatars.css')) return { format: 'module', source: '', shortCircuit: true };
+      return next(url, context);
+    },
+  });
+  const { createTownPresence } = await import('../tools/voxel-tavern/town-blockout/town-presence')
+    .finally(() => styleHook.deregister());
+  class Socket {
+    static OPEN = 1;
+    static opened: Socket[] = [];
+    readyState = Socket.OPEN;
+    bufferedAmount = 0;
+    sent: (string | ArrayBuffer)[] = [];
+    onmessage?: (event: { data: string | ArrayBuffer }) => void;
+    constructor(readonly url: string) { Socket.opened.push(this); }
+    send(data: string | ArrayBuffer) { this.sent.push(typeof data === 'string' ? data : data.slice(0)); }
+    close() { this.readyState = 3; }
+    receive(frame: unknown) {
+      this.onmessage?.({ data: frame instanceof ArrayBuffer ? frame : JSON.stringify(frame) });
+    }
+  }
+  const globals = {
+    WebSocket: Socket,
+    location: { protocol: 'https:', host: 'town.test' },
+    document: { getElementById: () => null, querySelector: () => null, addEventListener() {}, visibilityState: 'visible' },
+    window: { setTimeout: () => 1, clearTimeout() {}, addEventListener() {} },
+  };
+  for (const [key, value] of Object.entries(globals)) {
+    const original = Object.getOwnPropertyDescriptor(globalThis, key);
+    Object.defineProperty(globalThis, key, { configurable: true, value });
+    t.after(() => {
+      if (original) Object.defineProperty(globalThis, key, original);
+      else Reflect.deleteProperty(globalThis, key);
+    });
+  }
+  const epochMs = 100_000;
+  const night = {
+    phase: 'night-window', shift: 'night', canEnterRestricted: true, layersOverlap: true,
+    chapterGatesLocked: true, beaconAt: 99_900, morningBellAt: 160_000,
+  };
+  const weather = {
+    weather: 'wind', startedAt: 99_000, nextChangeAt: 150_000, windEast: 1, windNorth: 0, windStrength: .5,
+  };
+  const view = { type: 'event', kind: 'soul-mayor-view', view: offer };
+  function join(roomPath: string, id: number) {
+    const socket = Socket.opened.at(-1)!;
+    assert.equal(socket.url, `wss://town.test${roomPath}`);
+    socket.receive({
+      type: 'join', id, name: 'player', self: true, epochMs, townNightWindow: night, townOutdoorWeather: weather,
+    });
+    assert.deepEqual(presence.getTownNightWindow(), night);
+    assert.deepEqual(presence.outdoorWeather(), weather);
+    assert.equal(presence.northRidgeNightOpen(), true);
+    return socket;
+  }
+  function pose(socket: Socket) {
+    const last = socket.sent.filter((frame): frame is ArrayBuffer => frame instanceof ArrayBuffer).at(-1);
+    assert.ok(last);
+    const data = new DataView(last);
+    return [2, 4, 6].map(offset => data.getUint16(offset, true) / 100);
+  }
+  const snapshot = new ArrayBuffer(1 + presenceRecordBytes);
+  new DataView(snapshot).setUint8(0, 1);
+  function mascot(socket: Socket, east: number, north: number, height: number) {
+    const record = new DataView(snapshot, 1);
+    writePresencePose({ east, north, height, yaw: 0 }, 1, record);
+    record.setUint16(0, MASCOT_ACTOR_ID, true);
+    socket.receive(snapshot);
+  }
+
+  const presence = createTownPresence(new Scene(), new PerspectiveCamera(), () => {});
+  presence.sample(true, 223, 180, 12, 0, false);
+  const town = join('/presence', 1);
+  town.receive(view);
+  assert.deepEqual(presence.soulMayor.view(), offer);
+  const invitation = presence.soulMayor.receiveInvitation();
+  assert.ok(town.sent.some(frame => typeof frame === 'string' && isSoulMayorInvitationRequest(frame)));
+
+  presence.setMountainDomain(true, new Scene());
+  await invitation;
+  assert.equal(presence.soulMayor.view(), undefined);
+  assert.equal(presence.outdoorWeather(), undefined);
+  assert.equal(presence.northRidgeNightOpen(), false);
+  town.receive(view);
+  presence.sample(true, 300, 696, 347, 0, false);
+  const mountain = join('/presence-mountain', 2);
+  mountain.receive(view);
+  await presence.soulMayor.receiveInvitation();
+  assert.equal(presence.soulMayor.view(), undefined);
+  assert.equal(mountain.sent.some(frame => typeof frame === 'string' && isSoulMayorInvitationRequest(frame)), false);
+  presence.update(.1);
+  assert.deepEqual(pose(mountain), [300, 156, 347]);
+  mascot(mountain, 304, 160, 347);
+  assert.equal(presence.sampleRemoteMascot()?.n, 700);
+
+  presence.setMountainDomain(false);
+  presence.setWestDomain(true);
+  presence.sample(true, -200, 180, -18, 0, false);
+  const west = join('/presence-west', 3);
+  west.receive(view);
+  assert.equal(presence.soulMayor.view(), undefined);
+  assert.equal(presence.sampleRemoteMascot(), undefined);
+  presence.update(.1);
+  assert.deepEqual(pose(west), [40, 180, 46]);
+  mascot(west, 40, 180, 46);
+  assert.deepEqual(presence.sampleRemoteMascot(), { x: -200, n: 180, ground: -18, yaw: 0, speed: 0 });
+
+  presence.setWestDomain(false);
+  presence.sample(true, 223, 180, 12, 0, false);
+  const returned = join('/presence', 4);
+  returned.receive(view);
+  assert.deepEqual(presence.soulMayor.view(), offer);
+  presence.sample(true, sharedHomeOrigin.east, sharedHomeOrigin.north, sharedHomeOrigin.height, 0, false);
+  returned.receive(view);
+  assert.equal(presence.soulMayor.view(), undefined);
+  presence.sample(false, 0, 0, 0, 0);
+});
+
+test('a private view is validated without deriving visibility from a local identity', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  await mayor.receiveInvitation();
+  assert.equal(mayor.view(), undefined);
+  assert.deepEqual(sent, []);
+  mayor.acceptView({ ...offer, ringCount: 13 });
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView({ ...offer, site: { actor, talk: { ...talk, layer: 'shared-home' } } });
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView(offer);
+  assert.deepEqual(mayor.view(), offer);
+  assert.ok(Object.isFrozen(mayor.view()?.site.talk));
+  mayor.acceptView(null);
+  assert.equal(mayor.view(), undefined);
+});
+
+test('only one invitation action is pending and then only its server result can complete it', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(offer);
+  let complete = false;
+  const first = mayor.receiveInvitation().then(() => { complete = true; });
+  await mayor.receiveInvitation();
+  assert.deepEqual(sent.map(message => JSON.parse(message)), [
+    { type: 'event', kind: 'soul-mayor-accept-invitation', requestId: 1 },
+  ]);
+  mayor.acceptResult(2, 'received');
+  mayor.acceptResult(1, 'invalid');
+  await Promise.resolve();
+  assert.equal(complete, false);
+  assert.equal(mayor.view()?.invited, false);
+  mayor.acceptView({ ...offer, invited: true });
+  mayor.acceptResult(1, 'received');
+  await first;
+  await mayor.receiveInvitation();
+  assert.equal(mayor.view()?.invited, true);
+  assert.equal(sent.length, 1);
+});
+
+test('disconnect clears view and pending action and does not let its old result settle a new session', async () => {
+  const sent: string[] = [];
+  const mayor = createTownPresenceSoulMayor(event => { sent.push(event); return true; });
+  mayor.acceptView(offer);
+  const first = mayor.receiveInvitation();
+  mayor.clear();
+  await first;
+  assert.equal(mayor.view(), undefined);
+  mayor.acceptView(offer);
+  let complete = false;
+  const second = mayor.receiveInvitation().then(() => { complete = true; });
+  assert.ok(sent.every(isSoulMayorInvitationRequest));
+  assert.equal(isSoulMayorInvitationRequest('{"type":"event","kind":"snowfight-request"}'), false);
+  assert.equal(isSoulMayorInvitationRequest(new Uint8Array()), false);
+  mayor.acceptResult(1, 'received');
+  await Promise.resolve();
+  assert.equal(complete, false);
+  mayor.acceptResult(2, 'denied');
+  await second;
+  assert.equal(mayor.view()?.invited, false);
+});
