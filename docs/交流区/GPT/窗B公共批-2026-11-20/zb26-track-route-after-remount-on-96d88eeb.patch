+  }
+  short.update(21);
+  field.update(21, true);
+  live.sync(field, 21);
+  assert.equal(legacyMesh.visible, false);
+  assert.equal(live.mesh.visible, true);
+  field.update(280, true);
+  live.sync(field, 301);
+  assert.equal(live.mesh.visible, false);
