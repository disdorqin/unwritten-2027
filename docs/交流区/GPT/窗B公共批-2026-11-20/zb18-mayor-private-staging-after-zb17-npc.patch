--- /dev/null
+++ b/tests/town-blockout-soul-mayor-staging.test.ts
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { InstancedMesh, Matrix4, Mesh, Raycaster, Scene, Vector3, type MeshBasicMaterial } from 'three';
+import type { SoulMayorView } from '../src/shared/soul-mayor';
+import { createTownNpcActivity } from '../tools/voxel-tavern/town-blockout/town-npc';
+import { soulMayorCapacity, soulMayorWalkDetour } from '../tools/voxel-tavern/town-blockout/town-soul-mayor';
+
+const actor = { layer: 'town', east: 264, north: 196.4, height: 12 };
+const offer: SoulMayorView = {
+  site: { actor, talk: { ...actor, north: 197.25 } }, invited: false, ringCount: 0,
+};
+
+test('a local living NPC bends around the approved same-floor point and keeps its authored route ends', () => {
+  const start = [264, 198] as const;
+  const end = [264, 194.8] as const;
+  const ground = () => 12;
+  const bypass = (progress: number) => soulMayorWalkDetour(actor, start, end, progress, 12, ground);
+  assert.equal(bypass(0), undefined);
+  assert.equal(bypass(.1), undefined);
+  assert.equal(bypass(.9), undefined);
+  assert.equal(bypass(1), undefined);
+  const center = bypass(.5)!;
+  const side = Math.abs(center.x - actor.east);
+  assert.ok(side > .7 && side < .8);
+  assert.equal(center.n, actor.north);
+  assert.equal(center.ground, 12);
+  assert.ok(Math.abs(bypass(.35)!.x - actor.east) < side);
+  assert.equal(soulMayorWalkDetour(actor, start, end, .5, 12, () => undefined), undefined);
+  assert.equal(soulMayorWalkDetour(actor, start, end, .5, 12, () => 12.7), undefined);
+  assert.equal(soulMayorWalkDetour({ ...actor, height: 13 }, start, end, .5, 12, ground), undefined);
+  assert.equal(soulMayorWalkDetour({ ...actor, east: 265.2 }, start, end, .5, 12, ground), undefined);
+});
+
+test('only the authorized scene sees the detached shadow and private detour, which never move public interaction positions', () => {
+  let privateView: SoulMayorView | undefined;
+  const setup = (view: () => SoulMayorView | undefined) => {
+    const scene = new Scene();
+    const activity = createTownNpcActivity({
+      scene, face() {}, sit() {}, announce() { assert.fail('staging sends no notice'); },
+      open() { assert.fail('staging opens no dialogue'); },
+    }, () => 12, undefined, undefined, undefined, undefined, undefined, {
+      view, standableGround: () => 12,
+      async receiveInvitation() { assert.fail('staging makes no presence request'); },
+    });
+    return { scene, activity, mesh: scene.children[0] as InstancedMesh };
+  };
+  const guest = setup(() => undefined);
+  const local = setup(() => privateView);
+  privateView = offer;
+  guest.activity.update(8.65);
+  local.activity.update(8.65);
+  assert.equal(guest.scene.children.length, 1);
+  assert.equal(local.mesh.count, guest.mesh.count + soulMayorCapacity);
+  const shadow = local.scene.children.find(child => child.name === 'soul-mayor-contact-shadow') as Mesh;
+  assert.ok(shadow);
+  const material = shadow.material as MeshBasicMaterial;
+  assert.equal(material.isMeshBasicMaterial, true);
+  assert.equal(material.opacity, .11);
+  assert.equal(material.transparent, true);
+  assert.equal(material.depthWrite, false);
+  assert.equal(shadow.position.x, actor.east);
+  assert.equal(shadow.position.z, -actor.north);
+  assert.ok(shadow.position.y > actor.height && shadow.position.y < actor.height + .02);
+  assert.deepEqual(new Raycaster(new Vector3(actor.east, 15, -actor.north), new Vector3(0, -1, 0)).intersectObject(shadow), []);
+  for (const { id, x, y, z } of local.activity.snowballTargets) {
+    const target = guest.activity.snowballTargets.find(other => other.id === id);
+    assert.deepEqual([x, y, z], [target?.x, target?.y, target?.z]);
+  }
+  const matrix = (batch: InstancedMesh, index: number) => {
+    const result = new Matrix4();
+    batch.getMatrixAt(index, result);
+    return result;
+  };
+  const shifted: number[] = [];
+  for (let index = 0; index < guest.mesh.count; index++) {
+    const logical = matrix(guest.mesh, index);
+    const visual = matrix(local.mesh, index);
+    if (logical.equals(visual)) continue;
+    assert.ok(Math.abs(logical.elements[12] - actor.east) < .85);
+    assert.ok(Math.abs(logical.elements[14] + actor.north) < .85);
+    assert.ok(Math.abs(Math.abs(visual.elements[12] - logical.elements[12]) - .74) < .001);
+    shifted.push(index);
+  }
+  assert.ok(shifted.length > 5, 'one full living actor is visually detoured');
+  privateView = undefined;
+  local.activity.update(0, { livingPaused: true });
+  assert.equal(shadow.parent, null);
+  assert.equal(local.mesh.count, guest.mesh.count);
+  for (const index of shifted) {
+    assert.ok(Math.abs(matrix(local.mesh, index).elements[12] - actor.east) < .85);
+  }
+  assert.equal(local.scene.children.length, 1);
+});
