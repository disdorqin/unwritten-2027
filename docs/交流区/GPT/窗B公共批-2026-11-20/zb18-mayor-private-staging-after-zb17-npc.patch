 export type SoulMayorClient = Readonly<{
   /** Read the cached private view for this connection. */
   view(): SoulMayorView | undefined;
   receiveInvitation(): Promise<void>;
+  standableGround?(east: number, north: number, nearHeight: number): number | undefined;
 }>;
+
+type WalkPoint = readonly [east: number, north: number];
+type NpcRenderPoint = Readonly<{ x: number; n: number; ground: number }>;
+
+/** Private presentation only. Keep the NPC's public/interactive position on its authored route. */
+export function soulMayorWalkDetour(
+  actor: StarStoneLocation, start: WalkPoint, end: WalkPoint, progress: number, routeGround: number,
+  standableGround: NonNullable<SoulMayorClient['standableGround']>,
+): NpcRenderPoint | undefined {
+  if (progress <= 0 || progress >= 1 || Math.abs(actor.height - routeGround) > soulMayorFloorTolerance) return;
+  const east = end[0] - start[0], north = end[1] - start[1];
+  const length = Math.hypot(east, north);
+  if (!length) return;
+  const alongEast = east / length, alongNorth = north / length;
+  const sideEast = -alongNorth, sideNorth = alongEast;
+  const eastToActor = actor.east - start[0], northToActor = actor.north - start[1];
+  const actorAlong = eastToActor * alongEast + northToActor * alongNorth;
+  const actorSide = eastToActor * sideEast + northToActor * sideNorth;
+  const shift = soulMayorClearance - Math.abs(actorSide);
+  if (actorAlong <= 0 || actorAlong >= length || shift <= 0) return;
+  const along = progress * length;
+  const delta = along - actorAlong;
+  const approach = Math.min(delta < 0 ? actorAlong : length - actorAlong, detourLead);
+  if (Math.abs(delta) >= approach) return;
+  const t = 1 - Math.abs(delta) / approach;
+  const sidestep = (actorSide > 0 ? -1 : 1) * shift * t * t * (3 - 2 * t);
+  const x = start[0] + east * progress + sideEast * sidestep;
+  const n = start[1] + north * progress + sideNorth * sidestep;
+  const ground = standableGround(x, n, routeGround);
+  if (ground === undefined || !Number.isFinite(ground) || Math.abs(ground - routeGround) > .25) return;
+  return { x, n, ground };
+}
+
+function createSoulMayorShadow() {
+  const size = 25, center = (size - 1) / 2;
+  const pixels = new Uint8Array(size * size * 4);
+  for (let z = 0; z < size; z++) {
+    for (let x = 0; x < size; x++) {
+      const index = (z * size + x) * 4;
+      const radial = Math.max(0, 1 - Math.hypot(x - center, z - center) / center);
+      pixels.set([255, 255, 255, Math.round(255 * radial ** 2)], index);
+    }
+  }
+  const map = new DataTexture(pixels, size, size);
+  map.minFilter = map.magFilter = LinearFilter;
+  map.needsUpdate = true;
+  const shadow = new Mesh(new PlaneGeometry(.91, .67), new MeshBasicMaterial({
+    color: '#09131e', map, opacity: normalContactShadowOpacity * .5, transparent: true, depthWrite: false,
+  }));
+  shadow.name = 'soul-mayor-contact-shadow';
+  shadow.rotation.x = -Math.PI / 2;
+  shadow.raycast = () => {};
+  return shadow;
+}

