diff --git a/tests/town-blockout-za29-guard-duty.test.ts b/tests/town-blockout-za29-guard-duty.test.ts
new file mode 100644
index 00000000..1af5ff50
--- /dev/null
+++ b/tests/town-blockout-za29-guard-duty.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createZa29GuardDuty } from '../tools/voxel-tavern/town-blockout/town-za29-guard-duty';
+
+const foot = (east: number, north: number, height: number) => ({ east, north, height });
+
+test('a mounted and on-duty mountain guard warns, talks and stops a crossing of the real approach', () => {
+  const approach = foot(300, 664.95, 347);
+  const guard = foot(302.35, 665.1, 347);
+  const outside = foot(300, 663.25, 347);
+  const inside = foot(300, 666.1, 347);
+  const lines: string[] = [];
+  const duty = createZa29GuardDuty('mountain', { guard, approach }, line => lines.push(line));
+
+  assert.equal(duty.action(outside), undefined);
+  assert.equal(duty.blocksStep(outside, inside), false);
+  duty.observeApproach(outside);
+  assert.deepEqual(lines, []);
+
+  duty.updateDuty(true);
+  duty.observeApproach(outside);
+  duty.observeApproach(outside);
+  assert.deepEqual(lines, ['吃点，吃点再走，山上风大。']);
+  const action = duty.action(outside);
+  assert.equal(action?.label, '与赵满仓交谈');
+  action?.run();
+  assert.equal(duty.blocksStep(outside, inside), true);
+  assert.equal(duty.blocksStep(outside, inside), true);
+  assert.equal(lines.length, 3);
+  assert.equal(duty.blocksStep(inside, outside), false);
+
+  duty.updateDuty(false);
+  action?.run();
+  assert.equal(duty.action(outside), undefined);
+  assert.equal(duty.blocksStep(outside, inside), false);
+  assert.equal(lines.length, 3);
+});
+
+test('the crater guard intervenes on the approach without fencing off the western domain', () => {
+  const height = 10.7773;
+  const approach = foot(-68.4, 159, height);
+  const guard = foot(-68.4, 161.1, height);
+  const lines: string[] = [];
+  const duty = createZa29GuardDuty('crater', { guard, approach }, line => lines.push(line));
+  duty.updateDuty(true);
+
+  const outside = foot(-66, 159, height);
+  const inside = foot(-70.5, 159, height);
+  assert.equal(duty.blocksStep(outside, inside), true);
+  assert.equal(duty.blocksStep(approach, inside), true);
+  assert.equal(duty.blocksStep(foot(-66, 160.7, height), foot(-70.5, 157.3, height)), true);
+  assert.equal(duty.blocksStep(inside, outside), false);
+  assert.equal(duty.blocksStep(inside, foot(-72, 159, height)), false);
+  assert.equal(duty.blocksStep(foot(-66, 153, height), foot(-70.5, 153, height)), false);
+  assert.equal(duty.blocksStep(foot(-66, 159, height + 3), foot(-70.5, 159, height + 3)), false);
+  assert.equal(duty.action(foot(-72, 153, height)), undefined);
+  assert.deepEqual(lines, ['井口的规矩，比命大。']);
+
+  duty.observeApproach(foot(-65, 149, height));
+  duty.observeApproach(outside);
+  assert.equal(duty.blocksStep(outside, inside), true);
+  assert.equal(lines.length, 3);
+  duty.updateDuty(false);
+  assert.equal(duty.blocksStep(outside, inside), false);
+  assert.equal(duty.blocksStep(inside, outside), false);
+});
diff --git a/tools/voxel-tavern/town-blockout/town-za29-guard-duty.ts b/tools/voxel-tavern/town-blockout/town-za29-guard-duty.ts
new file mode 100644
index 00000000..7ebd1047
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/town-za29-guard-duty.ts
@@ -0,0 +1,88 @@
+type Foot = Readonly<{ east: number; north: number; height: number }>;
+type GuardAnchors = Readonly<{ guard: Foot; approach: Foot }>;
+
+const guards = {
+  mountain: {
+    label: '与赵满仓交谈',
+    line: '吃点，吃点再走，山上风大。',
+    east: 0,
+    north: 1,
+  },
+  crater: {
+    label: '与石九斤交谈',
+    line: '井口的规矩，比命大。',
+    east: -1,
+    north: 0,
+  },
+} as const;
+
+const guardReach = 4.5;
+const approachReach = 3.5;
+const passageHalfWidth = 2;
+const levelReach = 1.25;
+
+export function createZa29GuardDuty(
+  kind: keyof typeof guards,
+  { guard, approach }: GuardAnchors,
+  announce: (line: string) => void,
+) {
+  const post = guards[kind];
+  let present = false;
+  let greeted = false;
+  let stopped = false;
+
+  function updateDuty(guardPresent: boolean) {
+    if (present === guardPresent) return;
+    present = guardPresent;
+    greeted = stopped = false;
+  }
+
+  function inReach(point: Foot, anchor: Foot, reach: number) {
+    return Math.abs(point.height - anchor.height) <= levelReach &&
+      Math.hypot(point.east - anchor.east, point.north - anchor.north) <= reach;
+  }
+
+  function along(point: Foot) {
+    return (point.east - approach.east) * post.east + (point.north - approach.north) * post.north;
+  }
+
+  const speak = () => { if (present) announce(post.line); };
+  const conversation = { label: post.label, run: speak };
+
+  function action(position: Foot) {
+    if (present && inReach(position, guard, guardReach)) return conversation;
+  }
+
+  function observeApproach(position: Foot) {
+    const nearApproach = present && along(position) <= 0 &&
+      inReach(position, approach, approachReach) && inReach(position, guard, guardReach);
+    if (!nearApproach) {
+      greeted = stopped = false;
+    } else if (!greeted) {
+      greeted = true;
+      speak();
+    }
+  }
+
+  function blocksStep(from: Foot, to: Foot) {
+    if (!present) return false;
+    const before = along(from), after = along(to);
+    if (before > 0 || after < 0 || after <= before) return false;
+    const mix = -before / (after - before);
+    const crossing = {
+      east: from.east + (to.east - from.east) * mix,
+      north: from.north + (to.north - from.north) * mix,
+      height: from.height + (to.height - from.height) * mix,
+    };
+    // Check the real approach and guard at the swept crossing so a diagonal step
+    // cannot mask a rush, while the rest of the domain needs no guard collision.
+    if (!inReach(crossing, approach, passageHalfWidth) || !inReach(crossing, guard, guardReach)) return false;
+    if (!stopped) {
+      stopped = true;
+      speak();
+    }
+    return true;
+  }
+
+  return { updateDuty, action, observeApproach, blocksStep };
+}
