+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createRequire } from 'node:module';
+import type { InstancedMesh as ThreeInstancedMesh } from 'three';
+import { readWalkGeometry } from '../tools/voxel-tavern/town-blockout/landmark-kit.ts';
+import { buildMarketWishTree, marketWishTreeAnchor } from '../tools/voxel-tavern/town-blockout/market-wish-tree.ts';
+import { createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain.ts';
+import { createWishActivity } from '../tools/voxel-tavern/town-blockout/wish-activity.ts';
+
+const { Scene } = createRequire(new URL('../tools/voxel-tavern/package.json', import.meta.url))('three') as typeof import('three');
+
+test('the market plum is a separate batched tree grounded at E118/N88', () => {
+  const heightAt = createTerrainGrid().heightAt;
+  const group = buildMarketWishTree(heightAt);
+  const { east, north } = marketWishTreeAnchor;
+  assert.deepEqual(group.position.toArray(), [118, heightAt(118, 88), -88]);
+  assert.deepEqual({ east, north }, { east: 118, north: 88 });
+  assert.equal(group.children.length, 1);
+  const batch = group.children[0] as ThreeInstancedMesh;
+  assert.ok(batch.isInstancedMesh && batch.boundingBox);
+  assert.ok(batch.count > 300 && batch.count < 420);
+  const { min, max } = batch.boundingBox;
+  for (const span of [max.x - min.x, max.z - min.z]) assert.ok(13.5 < span && span < 14.5);
+  assert.ok(max.y > 7.8);
+
+  const { colliders, floors } = readWalkGeometry(group);
+  assert.equal(colliders.length, 2, 'trunk and wood box only');
+  const [trunk, chest] = colliders;
+  assert.equal(trunk.min[1], heightAt(east, north));
+  assert.ok(trunk.min[0] < east && trunk.max[0] > east);
+  assert.ok(trunk.min[2] < -north && trunk.max[2] > -north);
+  assert.equal(chest.min[1], heightAt(119.47, 88.71));
+  assert.equal(floors.length, 1, 'stone bench supports foot placement');
+  assert.ok(Math.abs(floors[0].max[1] - heightAt(115.83, 88.29) - .30) < 1e-8);
+  assert.throws(() => buildMarketWishTree(() => Number.NaN), /finite ground height/);
+});
+
+test('building the market plum leaves the plaza wish activity, read key and spot intact', () => {
+  const originalDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  const originalStorage = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+  const accesses: string[] = [];
+  Object.defineProperty(globalThis, 'document', {
+    configurable: true, value: { createElement: () => ({ getContext: () => null }) },
+  });
+  Object.defineProperty(globalThis, 'localStorage', {
+    configurable: true, value: { getItem: (key: string) => { accesses.push(key); return '["广场回归用祝福"]'; } },
+  });
+  try {
+    const scene = new Scene();
+    const activity = createWishActivity({ scene, open() { throw Error('unexpected dialog'); }, announce() {}, sit() {}, face() {} });
+    assert.deepEqual(scene.children[0].position.toArray(), [201.4, 12, -210.65]);
+    const [spot] = activity.spots;
+    assert.deepEqual([spot.x, spot.n, spot.ground, spot.range, spot.label], [201.5, 207, 12, 2.15, '写匿名祝福']);
+    assert.equal(activity.latestWish(), '广场回归用祝福');
+    assert.equal(activity.blocked?.(199.15, 210.81, 12), true);
+
+    scene.add(buildMarketWishTree(createTerrainGrid().heightAt));
+    assert.equal(scene.children[0].name, 'Wish tree and town blessings');
+    assert.equal(scene.children[1].name, 'Market wish tree');
+    assert.equal(activity.spots.length, 1);
+    assert.equal(activity.latestWish(), '广场回归用祝福');
+    assert.deepEqual(accesses, ['unwritten:town-blessings']);
+  } finally {
+    if (originalDocument) Object.defineProperty(globalThis, 'document', originalDocument);
+    else Reflect.deleteProperty(globalThis, 'document');
+    if (originalStorage) Object.defineProperty(globalThis, 'localStorage', originalStorage);
+    else Reflect.deleteProperty(globalThis, 'localStorage');
+  }
+});
