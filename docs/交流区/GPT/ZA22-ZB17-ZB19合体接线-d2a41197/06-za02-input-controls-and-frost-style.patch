From 40d1841e19223a07863a2e087b254ad150fe0033 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 20 Nov 2026 00:06:03 -0800
Subject: [PATCH] Mount the reviewed ZA-02 control buttons and frost asset

---
 tools/voxel-tavern/town-blockout.html      | 2 ++
 tools/voxel-tavern/town-blockout/style.css | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/voxel-tavern/town-blockout.html b/tools/voxel-tavern/town-blockout.html
index d3fa3555..f749ea7c 100644
--- a/tools/voxel-tavern/town-blockout.html
+++ b/tools/voxel-tavern/town-blockout.html
@@ -142,10 +142,12 @@
   </button>
   <div id="touch-walk" aria-label="移动摇杆" hidden><span aria-hidden="true"></span></div>
   <button id="world-action" type="button" hidden></button>
+  <button id="touch-sled-brake" type="button" aria-pressed="false" hidden>刹车</button>
   <aside id="snowball-controls" aria-label="打雪仗" hidden>
     <output id="snowball-score" aria-live="polite">雪球 0/10 · 薄雪</output>
     <output id="snow-practice-status" aria-label="移动靶场计时" aria-live="off" hidden></output>
     <progress id="snowball-action-meter" aria-label="雪球动作进度" value="0" max="1" hidden></progress>
+    <button id="snowball-primary" type="button" hidden>投雪球</button>
     <button id="snowball-board" type="button">雪仗榜</button>
     <button id="snowfight-start" type="button" hidden>团队雪仗</button>
     <button id="snowfight-build" type="button" aria-pressed="false" hidden>堆墙</button>
diff --git a/tools/voxel-tavern/town-blockout/style.css b/tools/voxel-tavern/town-blockout/style.css
index a95a596e..8c755145 100644
--- a/tools/voxel-tavern/town-blockout/style.css
+++ b/tools/voxel-tavern/town-blockout/style.css
@@ -332,7 +332,7 @@ body.museum-inspecting :is(.panel, .town-hud-button, #town-chat, #festival-statu
 #ceremony-frost > div { position: absolute; inset: 0; pointer-events: none; }
 #ceremony-frost .frost-edges {
   opacity: 0;
-  background: url('./snowball-impact-frost.webp') repeat center / min(480px, 55vw) auto;
+  background: url('./snowball-impact-frost.png') repeat center / min(480px, 55vw) auto;
   mask-image: radial-gradient(ellipse farthest-side at center, transparent var(--frost-clear, 100%), #000 104%);
 }
 #ceremony-frost .frost-tint { background: #86bbec; opacity: 0; }
