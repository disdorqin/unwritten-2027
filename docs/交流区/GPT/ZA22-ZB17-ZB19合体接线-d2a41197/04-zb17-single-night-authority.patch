diff --git a/src/presence/town-night-beacon.ts b/src/presence/town-night-beacon.ts
new file mode 100644
index 00000000..59978251
--- /dev/null
+++ b/src/presence/town-night-beacon.ts
@@ -0,0 +1,67 @@
+import { thirteenthBellCatalogueEntry, type TownNightBeaconFrame } from '../shared/town-night-beacon.js';
+import type { createTownNightWindow, TownNightWindowState } from '../shared/town-night-window.js';
+
+type TownNightWindow = ReturnType<typeof createTownNightWindow>;
+
+/** One dispatcher for a town. The host supplies the same window to the ledger, entry gates and witnesses. */
+export function createTownNightBeaconHost(window: TownNightWindow, broadcast: (cue: TownNightBeaconFrame) => void) {
+  return {
+    snapshot: window.snapshot,
+    tick() {
+      const state = window.snapshot();
+      if (state.phase !== 'awaiting-beacon' || state.beaconAt === null) return state;
+      const cue = window.recordBeacon(state.beaconAt);
+      if (!cue) return state;
+      broadcast({ type: 'event', kind: cue.kind, at: cue.at, expiresAt: cue.expiresAt });
+      return cue.state;
+    },
+  };
+}
+
+const milestones = { hear: 1, watch: 2, verify: 3 } as const;
+export type TownNightWitnessStep = keyof typeof milestones;
+export type TownNightWitnessProgress = 0 | typeof milestones[TownNightWitnessStep];
+export { thirteenthBellCatalogueEntry };
+
+type TownNightWitnessHost<Session, Evidence> = Readonly<{
+  window: Pick<TownNightWindow, 'snapshot'>;
+  profileOf: (session: Session) => string | undefined;
+  /** Match the host's audited action or scene evidence. A player naming a step is not evidence. */
+  confirm: (session: Session, step: TownNightWitnessStep, evidence: Evidence, state: TownNightWindowState) => boolean;
+  load: (profile: string) => TownNightWitnessProgress | undefined;
+  save: (profile: string, progress: TownNightWitnessProgress) => void;
+}>;
+
+function witnessState(progress: TownNightWitnessProgress) {
+  return {
+    heard: progress >= milestones.hear,
+    keptWatch: progress >= milestones.watch,
+    verified: progress === milestones.verify,
+    catalogueEntry: progress === milestones.verify ? thirteenthBellCatalogueEntry : null,
+  };
+}
+
+/** Use authenticated sessions with persistent profile keys. Action details stay in the host's evidence adapter. */
+export function createTownNightWitness<Session, Evidence>(host: TownNightWitnessHost<Session, Evidence>) {
+  const writing = new Set<string>();
+  return {
+    snapshot(session: Session) {
+      const profile = host.profileOf(session);
+      return profile ? witnessState(host.load(profile) ?? 0) : undefined;
+    },
+    record(session: Session, step: TownNightWitnessStep, evidence: Evidence) {
+      const profile = host.profileOf(session);
+      if (!profile || writing.has(profile)) return;
+      writing.add(profile);
+      try {
+        const progress = host.load(profile) ?? 0;
+        const next = milestones[step];
+        if (next !== progress + 1 || host.confirm(session, step, evidence, host.window.snapshot()) !== true) return;
+        host.save(profile, next);
+        return witnessState(next);
+      } finally {
+        writing.delete(profile);
+      }
+    },
+  };
+}
diff --git a/src/presence/town-night-config.ts b/src/presence/town-night-config.ts
new file mode 100644
index 00000000..fce68511
--- /dev/null
+++ b/src/presence/town-night-config.ts
@@ -0,0 +1,71 @@
+import { randomUUID } from 'node:crypto';
+import { closeSync, fsyncSync, openSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { createOrdinaryTownNightSchedule, isTownNightSchedule } from '../shared/town-night-window.js';
+import type { PresenceTownNightOptions } from './server.js';
+
+function loadReceipt(path: string): number | null {
+  let contents: string;
+  try {
+    contents = readFileSync(path, 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+  const value: unknown = JSON.parse(contents);
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+    throw new RangeError('Invalid town night beacon receipt');
+  }
+  return value;
+}
+
+function saveReceipt(path: string, at: number) {
+  const temporaryPath = `${path}.${randomUUID()}.tmp`;
+  try {
+    const fd = openSync(temporaryPath, 'wx', 0o600);
+    try {
+      writeFileSync(fd, JSON.stringify(at));
+      fsyncSync(fd);
+    } finally {
+      closeSync(fd);
+    }
+    renameSync(temporaryPath, path);
+  } catch (error) {
+    try { rmSync(temporaryPath, { force: true }); }
+    catch { /* Preserve the original write error. */ }
+    throw error;
+  }
+}
+
+export function readTownNightOptions(schedule: string | undefined, receiptPath: string | undefined): PresenceTownNightOptions | undefined {
+  if (schedule === undefined && receiptPath === undefined) return;
+  if (!schedule || !receiptPath?.trim()) {
+    throw new Error('Set TOWN_NIGHT_SCHEDULE and TOWN_NIGHT_BEACON_RECEIPT together');
+  }
+  const config: unknown = JSON.parse(schedule);
+  if (!config || typeof config !== 'object' ||
+      !('dawnEpoch' in config) || typeof config.dawnEpoch !== 'number' ||
+      !('beaconOffsetsAfterDusk' in config) || !Array.isArray(config.beaconOffsetsAfterDusk) ||
+      !('cueFreshnessMs' in config) || typeof config.cueFreshnessMs !== 'number') {
+    throw new RangeError('Invalid TOWN_NIGHT_SCHEDULE');
+  }
+  const specialCandidate = 'specialNight' in config ? config.specialNight : undefined;
+  const specialNight = isTownNightSchedule(specialCandidate) ? specialCandidate : undefined;
+  if (specialCandidate !== undefined && !specialNight) {
+    throw new RangeError('Invalid town night special schedule');
+  }
+  const ordinary = createOrdinaryTownNightSchedule({
+    dawnEpoch: config.dawnEpoch,
+    beaconOffsetsAfterDusk: config.beaconOffsetsAfterDusk,
+    cueFreshnessMs: config.cueFreshnessMs,
+  });
+  function scheduleAt(now: number) {
+    if (specialNight && now >= specialNight.duskAt && now < specialNight.morningBellAt) return specialNight;
+    return ordinary(now);
+  }
+  return {
+    scheduleAt,
+    restoredBeaconAt: loadReceipt(receiptPath),
+    saveBeacon: at => saveReceipt(receiptPath, at),
+    onSaveError: error => console.error('Town night beacon receipt could not be stored', error),
+  };
+}
