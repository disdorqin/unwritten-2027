 tools/verify-za22-live.mjs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/verify-za22-live.mjs b/tools/verify-za22-live.mjs
index 98434c50..6875b194 100644
--- a/tools/verify-za22-live.mjs
+++ b/tools/verify-za22-live.mjs
@@ -310,7 +310,9 @@ async function checkB13A6Native() {
     source: b13SourceDoor, target: b13TargetDoor, device, limitMs: b13LimitMs, afterRevealMs: b13AfterRevealMs,
     cache: 'Fresh browser process. The native source approach can warm exterior chunks; this does not repeat the historical staged setup.',
