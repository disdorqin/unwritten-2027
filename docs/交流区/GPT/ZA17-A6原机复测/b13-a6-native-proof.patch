+async function checkB13A6Native() {
+  assert.equal(report.browser, '146.0.7680.178', 'B13 historical Chrome version');
+  const { page, evidence } = await openTown('B13 A6 native walking and door book');
+  assert.match(report.gpu?.renderer ?? '', /Intel\(R\) UHD Graphics.*0x0000A788.*Direct3D11/i);
+  const device = await page.evaluate(() => {
+    const canvas = document.querySelector('#scene canvas');
+    return { dpr: devicePixelRatio, width: innerWidth, height: innerHeight,
+      canvasWidth: canvas.width, canvasHeight: canvas.height,
+      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches };
+  });
+  const comparableWeather = frame => frame.weatherTier === 'medium' && Math.abs(frame.snowIntensity - 2.45) < .001;
+  assert.ok(Math.abs(device.dpr - 1) < .001, JSON.stringify(device));
+  assert.deepEqual([device.width, device.height, device.canvasWidth, device.canvasHeight, device.reducedMotion],
+    [1000, 650, 1000, 650, false]);
+  assert.ok(comparableWeather(await page.evaluate(() => window.__za22Frame)), 'B13 historical weather');
+  const cold = report.b13 = {
+    source: b13SourceDoor, target: b13TargetDoor, device, limitMs: b13LimitMs, afterRevealMs: b13AfterRevealMs,
+    cache: 'Fresh browser process. The native source approach can warm exterior chunks; this does not repeat the historical staged setup.',
+  };
+  await follow(page, evidence, [...station.slice(0, 18), [519, 366], [519, 371], [513, 373], [513, 371.92]], 'b13-approach');
+  await face(page, evidence, Math.PI);
+  cold.before = await waitForWire(page, evidence, pose => pose?.area === 'town'
+    && Math.hypot(pose.east - 513, pose.north - 371.92) <= .46 && Math.abs(pose.height - 19.873635) < .25);
+  assert.equal((await readPose(page)).status, '已连接 · 1 人');
+  await action(page, '进入屋舍空间');
+  cold.inside = await waitForWire(page, evidence, pose => pose?.area === 'town'
+    && Math.hypot(pose.east - 625.18, pose.north - 493.64) < .06 && pose.height === 150);
+  await page.keyboard.down('d');
+  try {
+    await page.waitForFunction(() => {
+      const button = document.querySelector('#world-action');
+      return button && !button.hidden && button.textContent.includes('百门册');
+    }, null, { timeout: 12_000 });
+  } finally {
+    await page.keyboard.up('d');
+  }
+  await action(page, '百门册');
+  await card(page, '百门册 · 一屋通百门');
+  const book = page.locator('#place-card[open] .house-door-book');
+  const entries = book.locator('button[data-house-door]');
+  assert.equal(await entries.first().getAttribute('data-house-door'), b13SourceDoor);
+  assert.match(await entries.first().textContent(), /刚从这儿进/);
+  await book.locator('[data-house-door-zone="memorial"]').click();
+  assert.equal(await entries.count(), 14);
+  await book.locator(`button[data-house-door="${b13TargetDoor}"]`).click();
+  await page.waitForFunction(() => window.__b13Native?.finished, null, { timeout: 15_000 });
+  const { clicks, revealedAt, frames, keys } = await page.evaluate(() => window.__b13Native);
+  Object.assign(cold, { clicks, revealedAt, frames, keys });
+  assert.equal(clicks.length, 1, 'Only one exit per fresh browser');
+  assert.equal(clicks[0].trusted, true);
+  assert.deepEqual(keys.map(key => [key.code, key.trusted]), [['KeyE', true], ['KeyD', true], ['KeyE', true]]);
+  assert.ok(revealedAt > clicks[0].at && frames.length > 0 && frames.every(comparableWeather));
+  const firstExterior = frames.find(frame => frame.cameraY < 100);
+  assert.ok(firstExterior && firstExterior.at <= revealedAt, 'Exterior draw while revealing');
+  cold.landing = await waitForWire(page, evidence, pose => pose?.area === 'town'
+    && Math.hypot(pose.east - b13Landing.east, pose.north - b13Landing.north) < .05
+    && Math.abs(pose.height - b13Landing.height) < .05
+    && Math.abs(yawDistance(pose.yaw, b13Landing.yaw)) < .01);
+  assert.equal((await readPose(page)).status, '已连接 · 1 人');
+  const peakMs = Math.max(...frames.map(frame => frame.frameMs));
+  cold.summary = { frames: frames.length, peakMs, over50: frames.filter(frame => frame.frameMs > b13LimitMs).length,
+    firstExterior };
+  await snapshot(page, evidence, 'b13-native-target-after-frame-window');
+  assert.ok(peakMs <= b13LimitMs, `B13 native walk frame window peaked at ${peakMs.toFixed(1)} ms`);
+}
