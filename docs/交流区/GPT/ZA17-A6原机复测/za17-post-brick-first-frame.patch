-      dummy.scale.set(...size);
-      dummy.rotation.z = roll;
-      dummy.updateMatrix();
-      mesh.setMatrixAt(index, dummy.matrix);
-    });
+    blocks.forEach((block, index) => placeBlock(mesh, block, index));
     if (tint === 'goldLight') {
