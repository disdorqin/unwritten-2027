-export const marketStallLayouts: readonly MarketStallLayout[] = stalls.map((
-  [x, z, width, canopy, kind, row, yaw, base], index,
-) => ({ id: `market-stall-${index}`, x, z, width, canopy, kind, row, yaw, base, counterGround: index === 4 ? oxApproachGround : base }));
+export const marketTastingStallCount = stalls.length;
+const phaseThreeBounds = [97, 128, 271, 212] as const;
+const phaseThree = phaseThreeBounds.every((edge, i) => edge === layout.plaza.bounds[i]);
+const [marketEast, marketNorth] = layout.plots.find(plot => plot.id === 'market-stalls')!.origin;
+
+// Maintain the template pitch on both sides of the southwest road. The road
+// occupies one continuous break. The lower-left last foundation meets the cut grade.
+const expansion: readonly Stall[] = [
+  [110 - marketEast, marketNorth - 142, 4.9, '#a1342d', '糖葫芦', 'spillover', north, 12],
+  [117.5 - marketEast, marketNorth - 142, 4.9, '#92562e', '干果炒货', 'spillover', north, 12, 1.17],
+  [147.5 - marketEast, marketNorth - 142, 4.9, '#8a312d', '吃食', 'spillover', north, 12],
+  [155 - marketEast, marketNorth - 142, 4.9, '#2e6a67', '热饮', 'spillover', north, 12],
+  [162.5 - marketEast, marketNorth - 142, 4.9, '#95702c', '杂货', 'spillover', north, 12],
+  [170 - marketEast, marketNorth - 142, 4.9, '#593f7c', '布匹/围巾', 'spillover', north, 12],
+  [-16.2, -24.6, 5.15, '#b54126', '灯笼', 'north', east, 10.81512, .78],
+];
+
+function stallLayout(
+  [x, z, width, canopy, kind, row, yaw, base, footingDepth]: Stall, index: number,
+): MarketStallLayout {
+  return { id: `market-stall-${index}`, x, z, width, canopy, kind, row, yaw, base,
+    counterGround: index === 4 ? oxApproachGround : base,
+    ...(footingDepth === undefined ? {} : { footingDepth }) };
+}
+
+export const marketStallLayouts: readonly MarketStallLayout[] =
+  (phaseThree ? [...stalls, ...expansion] : stalls).map(stallLayout);
+
+export const marketExpansionStalls = marketStallLayouts.slice(marketTastingStallCount);
+
+export function marketSpilloverWalkAt(x: number, n: number) {
+  const localX = x - marketEast, localZ = marketNorth - n;
+  return marketExpansionStalls.some(stall => stall.row === 'spillover' &&
+    Math.abs(localX - stall.x) < stall.width / 2 && Math.abs(localZ - (stall.z - 2.6)) <= 1);
+}
