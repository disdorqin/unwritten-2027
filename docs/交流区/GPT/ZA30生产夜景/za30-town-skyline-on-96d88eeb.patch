+const summitSkylineMesh: Mesh<BufferGeometry, MeshLambertMaterial | MeshBasicMaterial> =
+  createMainSummitBlock(mainSummitLayout, 347, 100).coarse;
+const summitSkylineDayMaterial = summitSkylineMesh.material;
+summitSkylineDayMaterial.side = DoubleSide;
+// Town eyes see the underside of the open heightfield. A height tint keeps
+// that backlit silhouette legible during snow nights and the ceremony dim.
+const summitSkylinePositions = summitSkylineMesh.geometry.getAttribute('position');
+// The south apron is approached through the cloud route. In town it would
+// project above the far ridge and replace the sky with an underside plane.
+const skylineNearNorth = 600;
+const summitSkylineSource = summitSkylineMesh.geometry.getIndex()!;
+const summitSkylineIndices: number[] = [];
+for (let triangle = 0; triangle < summitSkylineSource.count; triangle += 3) {
+  const a = summitSkylineSource.getX(triangle);
+  const b = summitSkylineSource.getX(triangle + 1);
+  const c = summitSkylineSource.getX(triangle + 2);
+  if ([a, b, c].every(index => -summitSkylinePositions.getZ(index) >= skylineNearNorth)) {
+    summitSkylineIndices.push(a, b, c);
+  }
+}
+summitSkylineMesh.geometry.setIndex(summitSkylineIndices);
+const summitSkylineColors = new Float32Array(summitSkylinePositions.count * 3);
+const summitSkylineShadow = new Color('#2d4059');
+const summitSkylineSnow = new Color('#6b86a2');
+const summitSkylineTint = new Color();
+const { baseHeight, summitHeight } = mainSummitSpec;
+for (let vertex = 0; vertex < summitSkylinePositions.count; vertex++) {
+  const heightRatio = (summitSkylinePositions.getY(vertex) - baseHeight) / (summitHeight - baseHeight);
+  summitSkylineTint.copy(summitSkylineShadow).lerp(summitSkylineSnow, heightRatio).toArray(summitSkylineColors, vertex * 3);
+}
+summitSkylineMesh.geometry.setAttribute('color', new BufferAttribute(summitSkylineColors, 3));
