@@ -0,0 +1,157 @@
+import { sampleNorthRidge350 } from './north-ridge-350-terrain';
+
+export type Za36SwitchbackPoint = Readonly<{
+  east: number; north: number; height: number; distance: number;
+}>;
+export const ZA36_SWITCHBACK_FOOT_WIDTH = 2.5;
+export const ZA36_SWITCHBACK_GRADE_LIMIT = .12;
+export const ZA36_SWITCHBACK_MIN_LENGTH = 2750;
+
+// ZA-36 A ruling: no transfer at town/mountain, use a physical contour-following
+// walk from the N539 town edge to existing foot, mid station and cloud terrace.
+// This is an isolated survey candidate only, NOT a terrain/Presence override.
+const R = { centerE: 320, centerN: 650, eastScale: 330, southScale: 380 } as const;
+const controls = {
+  town: { east: 630, north: 539 },
+  foot: { east: 290, north: 300 },
+  mid: { east: 440, north: 520 },
+  summit: { east: 336, north: 640 },
+} as const;
+
+type PlanPoint = { east: number; north: number };
+const mix = (a: number, b: number, t: number) => a + (b - a) * t;
+function elliptical(site: PlanPoint) {
+  const x = (site.east - R.centerE) / R.eastScale;
+  const y = (site.north - R.centerN) / R.southScale;
+  return { theta: Math.atan2(y, x), radius: Math.hypot(x, y) };
+}
+function fromEllipse(radius: number, theta: number): PlanPoint {
+  return {
+    east: R.centerE + radius * R.eastScale * Math.cos(theta),
+    north: R.centerN + radius * R.southScale * Math.sin(theta),
+  };
+}
+function pathPlan() {
+  const route: PlanPoint[] = [{ ...controls.town }];
+  const foot = elliptical(controls.foot);
+  const town = elliptical(controls.town);
+  function arc(from: ReturnType<typeof elliptical>, to: ReturnType<typeof elliptical>,
+    final?: PlanPoint) {
+    const meanR = (from.radius + to.radius) / 2;
+    const count = Math.max(2, Math.ceil(Math.abs(to.theta - from.theta) * meanR * 380 / 2));
+    for (let i = 1; i <= count; i++) {
+      const progress = i / count;
+      route.push(i === count && final ? { ...final } : fromEllipse(
+        mix(from.radius, to.radius, progress), mix(from.theta, to.theta, progress)));
+    }
+  }
+  // Approach follows the outer foothill contour, not a line through the
+  // southern old-town buildings. The start is on the legal N539 town lip.
+  arc(town, foot, controls.foot);
+  const footIndex = route.length - 1;
+  // Four flank traverses rise to the actual lower cable midpoint.
+  const mid = elliptical(controls.mid);
+  const lowTurns = [
+    { theta: -2.64, radius: .83 },
+    { theta: -.5, radius: .70 },
+    { theta: -2.64, radius: .60 },
+    { theta: mid.theta, radius: mid.radius },
+  ];
+  let previous = foot;
+  for (const [i, turn] of lowTurns.entries()) {
+    arc(previous, turn, i === lowTurns.length - 1 ? controls.mid : undefined);
+    previous = turn;
+  }
+  const midIndex = route.length - 1;
+  // Sixteen smaller contour returns distribute the 207m final rise over a
+  // long safe grade, without building giant suspended tracks at E600.
+  const summit = elliptical(controls.summit);
+  for (let i = 1; i <= 16; i++) {
+    const turn = {
+      theta: i === 16 ? summit.theta : i % 2 ? -2.64 : -.5,
+      radius: mix(mid.radius, summit.radius, i / 16),
+    };
+    arc(previous, turn, i === 16 ? controls.summit : undefined);
+    previous = turn;
+  }
+  return { route, footIndex, midIndex, summitIndex: route.length - 1 };
+}
+export function surveyZa36ContinuousSwitchback(townHeightAt: (east: number, north: number) => number) {
+  const { route, footIndex, midIndex, summitIndex } = pathPlan();
+  const horizontal: number[] = [0];
+  for (let i = 1; i < route.length; i++) {
+    const a = route[i - 1]!, b = route[i]!;
+    horizontal.push(horizontal[i - 1]! + Math.hypot(b.east - a.east, b.north - a.north));
+  }
+  const controlsByDistance = [
+    { index: 0, height: townHeightAt(controls.town.east, controls.town.north) },
+    { index: footIndex, height: sampleNorthRidge350(controls.foot.east, controls.foot.north) },
+    { index: midIndex, height: sampleNorthRidge350(controls.mid.east, controls.mid.north) },
+    { index: summitIndex, height: sampleNorthRidge350(controls.summit.east, controls.summit.north) },
+  ];
+  // Fit the old mountain profile under a strict Lipschitz grade bound.
+  // Four signed-off anchors are fixed; between them we minimize vertical
+  // deviations from the real mountain instead of making floating struts.
+  const gradeLimit = ZA36_SWITCHBACK_GRADE_LIMIT * .985;
+  const anchors = controlsByDistance.map(point => ({
+    ...point, distance: horizontal[point.index]!,
+  }));
+  const height = route.map((position, index) => {
+    const natural = sampleNorthRidge350(position.east, position.north);
+    const distance = horizontal[index]!;
+    const low = Math.max(...anchors.map(anchor =>
+      anchor.height - gradeLimit * Math.abs(distance - anchor.distance)));
+    const high = Math.min(...anchors.map(anchor =>
+      anchor.height + gradeLimit * Math.abs(distance - anchor.distance)));
+    if (low > high + 1e-7) throw new Error('ZA-36 signed-off heights require more than 12% grade');
+    return Math.max(low, Math.min(high, natural));
+  });
+  for (let round = 0; round < 5; round++) {
+    for (let index = 1; index < height.length; index++) {
+      const cap = gradeLimit * (horizontal[index]! - horizontal[index - 1]!);
+      height[index] = Math.max(height[index - 1]! - cap,
+        Math.min(height[index - 1]! + cap, height[index]!));
+    }
+    for (let index = height.length - 2; index >= 0; index--) {
+      const cap = gradeLimit * (horizontal[index + 1]! - horizontal[index]!);
+      height[index] = Math.max(height[index + 1]! - cap,
+        Math.min(height[index + 1]! + cap, height[index]!));
+    }
+  }
+  let maxGrade = 0, maxRidgeMismatch = 0;
+  const points: Za36SwitchbackPoint[] = route.map((position, index) => {
+    maxRidgeMismatch = Math.max(maxRidgeMismatch, Math.abs(height[index]! -
+      sampleNorthRidge350(position.east, position.north)));
+    if (index) {
+      const step = horizontal[index]! - horizontal[index - 1]!;
+      maxGrade = Math.max(maxGrade, Math.abs(height[index]! - height[index - 1]!) / step);
+    }
+    return { ...position, height: height[index]!, distance: horizontal[index]! };
+  });
+  const length = horizontal.at(-1)!;
+  function pointAt(distance: number): Za36SwitchbackPoint {
+    if (!Number.isFinite(distance) || distance < 0 || distance > length) {
+      throw new RangeError('ZA-36 requires a bounded physical distance along the approved survey.');
+    }
+    let lo = 0, hi = points.length - 1;
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1;
+      if (points[mid]!.distance < distance) lo = mid + 1;
+      else hi = mid;
+    }
+    if (lo === 0) return points[0]!;
+    const a = points[lo - 1]!, b = points[lo]!;
+    const t = (distance - a.distance) / (b.distance - a.distance);
+    return {
+      east: mix(a.east, b.east, t), north: mix(a.north, b.north, t),
+      height: mix(a.height, b.height, t), distance,
+    };
+  }
+  return {
+    points, length, maxGrade, maxRidgeMismatch,
+    width: ZA36_SWITCHBACK_FOOT_WIDTH,
+    checkpoints: Array.from({ length: Math.floor(length / 250) }, (_, i) => pointAt(250 * (i + 1))),
+    foot: points[footIndex]!, middle: points[midIndex]!, summit: points[summitIndex]!,
+    pointAt,
+  };
+}
