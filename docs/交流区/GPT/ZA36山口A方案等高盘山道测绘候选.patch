+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createTerrainGrid, worldBounds } from '../tools/voxel-tavern/town-blockout/terrain';
+import { sampleNorthRidge350 } from '../tools/voxel-tavern/town-blockout/north-ridge-350-terrain';
+import {
+  surveyZa36ContinuousSwitchback, ZA36_SWITCHBACK_FOOT_WIDTH,
+  ZA36_SWITCHBACK_GRADE_LIMIT, ZA36_SWITCHBACK_MIN_LENGTH,
+} from '../tools/voxel-tavern/town-blockout/town-za36-switchback-survey';
+
+function findNonlocalOverlap(points: readonly {east:number; north:number; distance:number}[]) {
+  const buckets = new Map<string, typeof points[number][]>();
+  let nearest = Infinity;
+  const cell = 12;
+  for (const point of points) {
+    const gx = Math.floor(point.east / cell), gy = Math.floor(point.north / cell);
+    for (let dx = -1; dx <= 1; dx++) for (let dy = -1; dy <= 1; dy++) {
+      for (const previous of buckets.get(`${gx+dx}:${gy+dy}`) ?? []) {
+        if (Math.abs(point.distance - previous.distance) < 28) continue;
+        nearest = Math.min(nearest, Math.hypot(point.east - previous.east,
+          point.north - previous.north));
+      }
+    }
+    const key = `${gx}:${gy}`;
+    const bin = buckets.get(key) ?? [];
+    bin.push(point);
+    buckets.set(key, bin);
+  }
+  return nearest;
+}
+
+test('ZA-36 A ruling: proposed contour route satisfies 2.75km and maximum 12% rise with four surveyed anchors', () => {
+  const ground = createTerrainGrid().groundHeightAt;
+  const route = surveyZa36ContinuousSwitchback(ground);
+  assert.ok(route.length >= ZA36_SWITCHBACK_MIN_LENGTH);
+  assert.ok(route.maxGrade <= ZA36_SWITCHBACK_GRADE_LIMIT);
+  assert.equal(route.width, ZA36_SWITCHBACK_FOOT_WIDTH);
+  assert.equal(route.points[0]?.north, worldBounds.depth - 1);
+  assert.equal(route.points[0]?.height, ground(route.points[0]!.east, worldBounds.depth - 1));
+  assert.deepEqual([route.foot.east, route.foot.north], [290, 300]);
+  assert.deepEqual([route.middle.east, route.middle.north], [440, 520]);
+  assert.deepEqual([route.summit.east, route.summit.north], [336, 640]);
+  for (const point of [route.foot, route.middle, route.summit]) {
+    assert.ok(Math.abs(point.height - sampleNorthRidge350(point.east, point.north)) < 1e-6);
+  }
+  assert.equal(route.checkpoints.length, Math.floor(route.length / 250));
+  for (let i = 1; i < route.points.length; i++) {
+    const before = route.points[i-1]!, after = route.points[i]!;
+    assert.ok(after.distance > before.distance && after.distance - before.distance <= 2.5);
+    assert.ok(Math.abs(after.height-before.height) /
+      (after.distance-before.distance) <= ZA36_SWITCHBACK_GRADE_LIMIT + 1e-8);
+  }
+});
+
+test('ZA-36 A ruling fails construction gate until adjacent ridge cut and nonlocal hairpin overlaps are repaired', () => {
+  const route = surveyZa36ContinuousSwitchback(createTerrainGrid().groundHeightAt);
+  // Negative gate: do NOT infer a road is safe merely from route length/grade.
+  const gap = findNonlocalOverlap(route.points);
+  assert.ok(route.maxRidgeMismatch > 20, 'needs 3D earthworks/shoulder blending before walk surface');
+  assert.ok(gap < ZA36_SWITCHBACK_FOOT_WIDTH, 'turns are closer than a single walk lane');
+  assert.ok(route.length > 5000, 'the safe-gradient approach adds substantial walking distance');
+  // Non-release proof: the survey must remain an isolated candidate until
+  // ridge mismatch and nonlocal clearance pass independently.
+});
