+// Runs before the viewer in a fresh browser context. Forward calls unchanged
+// and read the real camera and the surveyed main-summit GPU draw.
+export function observeBareTown() {
+  const proto = WebGL2RenderingContext.prototype;
+  const getUniformLocation = proto.getUniformLocation;
+  const uniformMatrix4fv = proto.uniformMatrix4fv;
+  const useProgram = proto.useProgram;
+  const bufferData = proto.bufferData;
+  const bufferSubData = proto.bufferSubData;
+  const drawElements = proto.drawElements;
+  const knownUniforms = new WeakMap();
+  const programs = new WeakMap();
+  const summitIndices = new WeakSet();
+  let activeProgram;
+  let frame = 0;
+  const observation = { camera: null, summitDraws: [], indexedCounts: {}, summitSizedDraws: 0 };
+  window.__za30Bare = observation;
+
+  function countFrame() {
+    frame++;
+    requestAnimationFrame(countFrame);
+  }
+  requestAnimationFrame(countFrame);
+
+  function cameraFrom(m, x = m[12], y = m[13], z = m[14]) {
+    return {
+      east: -(m[0] * x + m[1] * y + m[2] * z),
+      north: m[8] * x + m[9] * y + m[10] * z,
+      cameraY: -(m[4] * x + m[5] * y + m[6] * z),
+      yaw: Math.atan2(-m[2], m[10]),
+      pitch: Math.asin(Math.max(-1, Math.min(1, -m[6]))),
+    };
+  }
+
+  proto.getUniformLocation = function (program, name) {
+    const location = getUniformLocation.call(this, program, name);
+    if (location && ['viewMatrix', 'modelViewMatrix', 'projectionMatrix'].includes(name)) {
+      knownUniforms.set(location, { program, name });
+      if (!programs.has(program)) programs.set(program, {});
+    }
+    return location;
+  };
+
+  proto.uniformMatrix4fv = function (location, transpose, values, ...offsets) {
+    uniformMatrix4fv.call(this, location, transpose, values, ...offsets);
+    const uniform = knownUniforms.get(location);
+    if (!uniform || this.canvas.parentElement?.id !== 'scene') return;
+    const m = offsets[0] ? values.subarray(offsets[0]) : values;
+    const data = programs.get(uniform.program);
+    if (uniform.name === 'modelViewMatrix') {
+      // Three reuses one temporary mat4 array across programs. Save the values
+      // through the next draw, even if the uniform is still valid and skipped.
+      (data.modelView ??= new Float32Array(16)).set(m);
+    } else if (uniform.name === 'viewMatrix') observation.camera = cameraFrom(m);
+    else data.far = m[14] / (m[10] + 1);
+  };
+
+  proto.useProgram = function (program) {
+    useProgram.call(this, program);
+    if (this.canvas.parentElement?.id === 'scene') activeProgram = programs.get(program);
+  };
+
+  proto.bufferData = function (target, values, ...args) {
+    bufferData.call(this, target, values, ...args);
+    if (target !== this.ELEMENT_ARRAY_BUFFER || this.canvas.parentElement?.id !== 'scene') return;
+    if (!(values instanceof Uint16Array) || values.length !== 4350) return;
+    // Reviewed 100 m grid of createMainSummitBlock(mainSummitLayout, 347, 100).
+    let hash = 2166136261;
+    for (const index of values) hash = Math.imul(hash ^ index, 16777619);
+    if ((hash >>> 0) === 2706687782) {
+      const buffer = this.getParameter(this.ELEMENT_ARRAY_BUFFER_BINDING);
+      if (buffer) summitIndices.add(buffer);
+    }
+  };
+
+  proto.bufferSubData = function (target, ...args) {
+    bufferSubData.call(this, target, ...args);
+    if (target === this.ELEMENT_ARRAY_BUFFER && this.canvas.parentElement?.id === 'scene') {
+      summitIndices.delete(this.getParameter(this.ELEMENT_ARRAY_BUFFER_BINDING));
+    }
+  };
+
+  proto.drawElements = function (mode, count, type, offset) {
+    drawElements.call(this, mode, count, type, offset);
+    if (mode !== this.TRIANGLES || count < 4_000 || this.canvas.parentElement?.id !== 'scene') return;
+    const indexed = observation.indexedCounts;
+    if (indexed[count] !== undefined) indexed[count]++;
+    else if (Object.keys(indexed).length < 64 || count === 4350) indexed[count] = 1;
+    if (count !== 4350 || offset !== 0 || type !== this.UNSIGNED_SHORT || !activeProgram?.modelView) return;
+    observation.summitSizedDraws++;
+    if (!summitIndices.has(this.getParameter(this.ELEMENT_ARRAY_BUFFER_BINDING))) return;
+
+    // The model transform is translation (300, 0, -676). Recover the camera
+    // from this object's actual modelView, independent of any other shader.
+    const m = activeProgram.modelView;
+    const viewTranslation = [m[12] - 300 * m[0] + 676 * m[8], m[13] - 300 * m[1] + 676 * m[9],
+      m[14] - 300 * m[2] + 676 * m[10]];
+    const sample = { ...cameraFrom(m, ...viewTranslation), frame, far: activeProgram.far, calls: 1,
+      triangles: count / 3, indexHash: 2706687782, modelViewTranslation: [m[12], m[13], m[14]], viewTranslation };
+    const recent = observation.summitDraws;
+    if (recent.at(-1)?.frame === frame) recent.pop();
+    recent.push(sample);
+    if (recent.length > 12) recent.shift();
+  };
+}
