diff --git a/tools/verify-webgl-canvas-evidence.mjs b/tools/verify-webgl-canvas-evidence.mjs
new file mode 100644
--- /dev/null
+++ b/tools/verify-webgl-canvas-evidence.mjs
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import { writeFile } from 'node:fs/promises';
+
+// Playwright serializes this function into the fresh browser context.
+// Capture before Chromium discards the default WebGL drawing buffer.
+export function installWebGLCanvasCapture() {
+  const requestFrame = window.requestAnimationFrame;
+  const gl = WebGL2RenderingContext.prototype;
+  let pending;
+  let drawnCanvas;
+  for (const name of ['drawElements', 'drawElementsInstanced', 'drawArrays', 'drawArraysInstanced']) {
+    const draw = gl[name];
+    gl[name] = function (...args) {
+      const result = draw.apply(this, args);
+      if (pending && !drawnCanvas && this.canvas.matches?.(pending.selector) &&
+          this.getParameter(this.DRAW_FRAMEBUFFER_BINDING) === null) drawnCanvas = this.canvas;
+      return result;
+    };
+  }
+
+  window.requestAnimationFrame = function (callback) {
+    return requestFrame.call(this, function (timestamp) {
+      callback.call(this, timestamp);
+      if (!pending || !drawnCanvas) return;
+      const { resolve, reject, timer } = pending;
+      const canvas = drawnCanvas;
+      pending = drawnCanvas = undefined;
+      clearTimeout(timer);
+      try {
+        const data = canvas.toDataURL('image/png');
+        resolve({ data, width: canvas.width, height: canvas.height, timestamp });
+      } catch (error) {
+        reject(error);
+      }
+    });
+  };
+
+  window.__captureWebGLCanvas = (selector, timeoutMs) => new Promise((resolve, reject) => {
+    if (pending) {
+      reject(new Error('A WebGL canvas capture is already pending'));
+      return;
+    }
+    const timer = setTimeout(() => {
+      pending = drawnCanvas = undefined;
+      reject(new Error('No WebGL draw reached the visible framebuffer in time'));
+    }, timeoutMs);
+    pending = { resolve, reject, selector, timer };
+  });
+}
+
+export async function captureWebGLCanvas(page, path, timeoutMs = 20_000) {
+  const { data, width, height, timestamp } = await page.evaluate(
+    ({ timeoutMs }) => window.__captureWebGLCanvas('#scene > canvas', timeoutMs), { timeoutMs },
+  );
+  assert.ok(data.startsWith('data:image/png;base64,') && width > 0 && height > 0, 'Valid canvas PNG required');
+  const png = Buffer.from(data.slice('data:image/png;base64,'.length), 'base64');
+  assert.equal(png.readUInt32BE(16), width);
+  assert.equal(png.readUInt32BE(20), height);
+  await writeFile(path, png);
+  return { width, height, timestamp, source: 'WebGL2 default framebuffer after render' };
+}
