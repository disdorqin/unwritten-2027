+const flatDistance = (a, b) => Math.hypot(a.east - b.east, a.north - b.north);
+const bearing = (a, b) => Math.atan2(b.east - a.east, b.north - a.north);
+const interpolate = (a, b, t) => ({
+  east: a.east + (b.east - a.east) * t,
+  north: a.north + (b.north - a.north) * t,
+});
+
+export async function planZa31Descent(townModulesUrl, override = process.env.ZA31_WINCH_SURVEY_FILE) {
+  const load = name => import(new URL(`${name}.ts`, townModulesUrl).href);
+  const [
+    { createTerrainGrid, worldBounds }, { mountWestCraterRoad }, { mountMeteorCraterSurface },
+    { meteorCraterDepth, meteorCraterFloorRadius, meteorCraterFixturePlan }, { mountZa31CraterCamp },
+  ] = await Promise.all([
+    load('terrain'), load('town-za22-crater-road'), load('meteor-crater-surface'),
+    load('meteor-crater'), load('town-za31-crater-camp'),
+  ]);
+  const grid = createTerrainGrid();
+  const road = mountWestCraterRoad(worldBounds.depth, north => grid.groundHeightAt(0, north));
+  const surface = mountMeteorCraterSurface(road.anchor);
+  const camp = mountZa31CraterCamp(road).placements.filter(site => site.kind === 'camp');
+  const fire = camp.find(site => site.id === 'fire-ring');
+  assert.ok(fire, 'The production camp has no surveyed fire ring');
+  const winch = override ? JSON.parse(await readFile(override, 'utf8'))
+    : (await load('town-za31-crater-winch')).surveyZa31CraterWinch(road);
+  assert.ok(winch?.descentApproach?.length >= 2 && winch?.useFoot && winch?.plinth, 'No surveyed winch foot');
+
+  const stages = [];
+  const maxChord = 5.8;
+  const lookAhead = .006;
+  const designBenchDepths = meteorCraterFixturePlan.terraces.map(bench => bench.depth);
+  const checkpoints = [
+    [0, 'lip'], [designBenchDepths[0] / meteorCraterDepth, 'bench-upper'],
+    [designBenchDepths[1] / meteorCraterDepth, 'bench-middle'],
+    [designBenchDepths[2] / meteorCraterDepth, 'bench-lower'], [1, 'floor-outlet'],
+  ];
+  // At the tightest 20 m radius a 5.8 m chord deviates <.22 m. The player radius
+  // and native driver arrival margin still fit within the one-metre trail half-width.
+  const trailAt = progress => {
+    const p = surface.trailPoint(progress);
+    assert.ok(Number.isFinite(p.height), `No production ground at trail progress ${progress}`);
+    return p;
+  };
+  for (let i = 0; i < checkpoints.length; ++i) {
+    const [progress, label] = checkpoints[i];
+    const point = trailAt(progress);
+    if (i) {
+      const previous = checkpoints[i - 1][0];
+      const arcUpperBound = (progress - previous) * Math.hypot(
+        meteorCraterFixturePlan.mainTrail.turns * 2 * Math.PI *
+        flatDistance(trailAt(previous), road.anchor), meteorCraterDepth,
+      );
+      const divisions = Math.ceil(arcUpperBound / maxChord);
+      for (let step = 1; step < divisions; ++step) {
+        const p = previous + (progress - previous) * step / divisions;
+        stages.push({ point: trailAt(p), progress: p });
+      }
+    }
+    const ahead = trailAt(Math.min(1, progress + lookAhead));
+    stages.push({ point, progress, label,
+      aim: progress < 1 ? { ...ahead, height: ahead.height + .7 } : undefined });
+  }
+
+  const outlet = stages.at(-1).point;
+  assert.ok(flatDistance(outlet, winch.descentApproach[0]) < .15, 'Winch approach does not start at the real trail outlet');
+  assert.ok(flatDistance(winch.descentApproach.at(-1), winch.useFoot) < .05, 'Winch approach must end at its use foot');
+  const floorRadius = 7.6;
+  const floorHeight = road.anchor.rimHeight - meteorCraterDepth;
+  function floorPoint(point) {
+    const height = road.heightAt(point.east, point.north);
+    assert.ok(Number.isFinite(height) && Math.abs(height - floorHeight) <= .12, `Off the surveyed floor: ${JSON.stringify(point)}`);
+    return { east: point.east, north: point.north, height };
+  }
+  function floorPolar(angle) {
+    return floorPoint({
+      east: road.anchor.east + floorRadius * Math.sin(angle),
+      north: road.anchor.north + floorRadius * Math.cos(angle),
+    });
+  }
+  function floorLine(toPoint) {
+    const from = stages.at(-1).point;
+    const segments = Math.max(1, Math.ceil(flatDistance(from, toPoint) / 4.8));
+    for (let i = 1; i <= segments; ++i) stages.push({ point: floorPoint(interpolate(from, toPoint, i / segments)) });
+  }
+  function floorArc(from, to) {
+    const range = Math.atan2(Math.sin(to - from), Math.cos(to - from));
+    const segments = Math.max(1, Math.ceil(Math.abs(range) / .28));
+    for (let i = 1; i <= segments; ++i) stages.push({ point: floorPolar(from + range * i / segments) });
+  }
+  const campBearing = bearing(road.anchor, fire);
+  const outletBearing = bearing(road.anchor, outlet);
+  floorLine(floorPolar(outletBearing));
+  floorArc(outletBearing, campBearing);
+  Object.assign(stages.at(-1), { label: 'floor-camp', aim: { ...fire, height: fire.height + .45 } });
+
+  const bend = winch.descentApproach[1];
+  assert.ok(flatDistance(outlet, road.anchor) > floorRadius && flatDistance(bend, road.anchor) < floorRadius,
+    'Winch path must meet the floor approach ring before the surveyed bend');
+  let outside = 0, inside = 1;
+  for (let i = 0; i < 30; ++i) {
+    const t = (outside + inside) / 2;
+    if (flatDistance(interpolate(outlet, bend, t), road.anchor) > floorRadius) outside = t;
+    else inside = t;
+  }
+  const winchEntry = interpolate(outlet, bend, inside);
+  floorArc(campBearing, bearing(road.anchor, winchEntry));
+  for (const point of winch.descentApproach.slice(1)) floorLine(point);
+  Object.assign(stages.at(-1), { label: 'winch-foot', aim: winch.axle ?? { ...winch.plinth, height: winch.plinth.height + .5 } });
+
+  // The real candidate can change. Reject a stale QA route instead of allowing a prop or shaft shortcut.
+  const trailWidth = meteorCraterFixturePlan.mainTrail.halfWidth;
+  const shaftGuard = surface.shaftRadius + .5;
+  for (let i = 1; i < stages.length; ++i) {
+    const { point: from, progress: fromProgress } = stages[i - 1];
+    const { point: to, progress: toProgress } = stages[i];
+    assert.ok(flatDistance(from, to) <= maxChord + .001, `QA step ${i} is too long`);
+    for (let j = 0; j <= 8; ++j) {
+      const t = j / 8;
+      const sample = interpolate(from, to, t);
+      const height = road.heightAt(sample.east, sample.north);
+      assert.ok(Number.isFinite(height), `Missing ground at QA step ${i}`);
+      if (toProgress !== undefined) {
+        const survey = trailAt(fromProgress + t * (toProgress - fromProgress));
+        assert.ok(flatDistance(survey, sample) + .27 + .46 < trailWidth, `QA chord leaves trail width at step ${i}`);
+        assert.ok(Math.abs(survey.height - height) < .15, `QA chord leaves trail grade at step ${i}`);
+      } else {
+        assert.ok(flatDistance(sample, road.anchor) <= meteorCraterFloorRadius + .01, `QA step ${i} crosses a wall`);
+        assert.ok(flatDistance(sample, road.anchor) >= shaftGuard, `QA step ${i} crosses the sealed shaft`);
+        assert.ok(!camp.some(site => flatDistance(sample, site) < site.radius + .5), `QA step ${i} crosses camp props`);
+        assert.ok(!winch.snakeStoneReservation ||
+          flatDistance(sample, winch.snakeStoneReservation) > winch.snakeStoneReservation.radius + .27,
+        `QA step ${i} crosses the snake-stone reservation`);
+      }
+    }
+  }
+  return { stages, anchor: road.anchor, camp: fire, winch, maxChord, depth: meteorCraterDepth };
+}
+
+export async function walkZa31Descent({
+  page, evidence, plan, readPose, waitForWire, walkTo, face, snapshot,
+}) {
+  const { stages, anchor, camp, winch, maxChord, depth } = plan;
+  const progress = [];
+  evidence.descent = { anchor, camp, winch, maxChord, depth, progress,
+    wireScope: 'Native client position frames on the live west room WebSocket; no server pose echo.',
+  };
+  for (const [index, { point, progress: fraction, label, aim }] of stages.entries()) {
+    const checkpoint = `za31-${label ?? `trail-${index + 1}`}`;
+    // The native driver treats an already-reached point as a no-op. The presence
+    // client does not send stationary keepalive positions, so reuse its last
+    // matching pose only for that case.
+    const before = await readPose(page);
+    const alreadyReached = flatDistance(before, point) <= .46;
+    const startAt = Date.now();
+    await walkTo(page, evidence, [point.east, point.north], checkpoint);
+    const wire = await waitForWire(page, evidence, pose => pose?.area === 'west' &&
+      (alreadyReached || pose.ms >= startAt) &&
+      flatDistance(pose, point) < .59 && Math.abs(pose.height - point.height) < .42);
+    const hud = await readPose(page);
+    assert.ok(flatDistance(hud, point) < .54 && Math.abs(hud.height - point.height) < .45,
+      `${checkpoint} does not agree with the surveyed floor: ${JSON.stringify({ point, hud, wire })}`);
+    progress.push({ label: checkpoint, expected: point, progress: fraction, hud, wire });
+    if (label && aim) {
+      const yaw = bearing(hud, aim);
+      const pitch = Math.atan2(aim.height - hud.cameraY, flatDistance(hud, aim));
+      await face(page, yaw, pitch);
+      await snapshot(page, evidence, checkpoint);
+    }
+  }
+  assert.ok(Math.abs(progress.at(-1).wire.height - (anchor.rimHeight - depth)) < .42, 'Actual descent did not reach the bottom');
+}
