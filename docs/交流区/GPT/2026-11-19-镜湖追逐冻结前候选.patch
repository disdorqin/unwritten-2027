+    const [east, north] = mirrorLake.center;
+    const height = mirrorLake.height;
+    const start = { type: 'event', kind: 'bell-start' };
+    const touch = { type: 'event', kind: 'bell-touch' };
+    const begin = wallNow;
+
+    host.pose(east, north, height);
+    chaser.pose(east + 1.3, north, height);
+    await delay(80);
+    host.send(start);
+    const started = await host.text.next(stateWith(state => state.loose?.east === east));
+    assert.deepEqual(started.loose, { east, north });
+    assert.equal(started.endsAt - begin, 180_000);
+    await chaser.text.next(stateWith(state => state.endsAt === started.endsAt));
+
+    host.send(touch);
+    await chaser.text.next(stateWith(state => state.holder?.id === host.id));
+    wallNow = begin + 999;
+    const beforeRange = host.text.total(isBellState);
+    chaser.send(touch);
+    await delay(80);
+    assert.equal(host.text.total(isBellState), beforeRange, '999 ms is still protected');
+
+    wallNow++;
+    chaser.pose(east + 1.31, north, height);
+    await delay(80);
+    chaser.send(touch);
+    await delay(80);
+    assert.equal(host.text.total(isBellState), beforeRange, '1.31 m is out of range');
+
+    chaser.pose(east + 1.3, north, height);
+    await delay(80);
+    chaser.send(touch);
+    const steal = await host.text.next(stateWith(state => state.holder?.id === chaser.id));
+    assert.deepEqual(steal.totals, [[host.id, 1_000]]);
+
+    wallNow = begin + 2_000;
+    chaser.pose(east + mirrorLake.radius[0] - 1, north, height);
+    await delay(80);
+    assert.ok(isMirrorLakeIce(east + mirrorLake.radius[0] - 1, north));
+    assert.equal(host.text.total(isBellState), beforeRange + 1, 'still on ice');
+    chaser.pose(east + mirrorLake.radius[0], north, height);
+    const dropped = await host.text.next(stateWith(state => state.holder === null && state.loose !== null));
+    assert.equal(dropped.pickableAt - wallNow, 1_000);
+    assert.ok(isMirrorLakeIce(dropped.loose!.east, dropped.loose!.north));
+    assert.deepEqual(dropped.totals, [[host.id, 1_000], [chaser.id, 1_000]]);
+
+    wallNow = dropped.pickableAt;
+    const afterDrop = host.text.total(isBellState);
+    chaser.send(touch);
+    await delay(80);
+    assert.equal(host.text.total(isBellState), afterDrop, 'shoreline claimant within radius cannot retrieve the bell');
+    host.pose(dropped.loose!.east, dropped.loose!.north, height);
+    await delay(80);
+    host.send(touch);
+    await chaser.text.next(stateWith(state => state.holder?.id === host.id));
+
+    wallNow = started.endsAt + 5;
+    const settled = await chaser.text.next(value => 'kind' in value && value.kind === 'bell-end') as BellEndEvent;
+    assert.deepEqual(settled.standings.map(row => [row.id, row.ms]), [[host.id, 178_000], [chaser.id, 1_000]]);
+    context.diagnostic(`round ${started.endsAt - begin} ms; shore drop ${dropped.loose!.east.toFixed(4)},${dropped.loose!.north.toFixed(4)}; pickup +${dropped.pickableAt - (begin + 2_000)} ms; totals ${settled.standings.map(row => row.ms).join('/')}`);
+  });
