+    let wallNow = Date.now();
+    context.mock.method(Date, 'now', () => wallNow);
+    const { join } = await fixture(context, { ...defaultBellConfig, titleMs: [...defaultBellConfig.titleMs] });
+    const host = await join('追逐甲');
