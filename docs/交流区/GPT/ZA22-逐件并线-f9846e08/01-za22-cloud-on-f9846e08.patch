+++ b/src/shared/za22-mountain-domain.ts
@@ -0,0 +1,12 @@
+// The front ridge uses the existing unsigned centimetre wire format in its own room.
+export const mountainPresencePath = '/presence-mountain';
+export const townNightWindowPath = '/presence/night-window';
+export const mountainPresenceNorthOrigin = 540;
+export const mountainPresenceBounds = Object.freeze({ width: 640, depth: 260, height: 655.35 });
+
+export function isMountainPresenceFoot(east: number, north: number, height: number) {
+  return Number.isFinite(east) && east >= 0 && east <= mountainPresenceBounds.width &&
+    Number.isFinite(north) && north >= mountainPresenceNorthOrigin &&
+    north <= mountainPresenceNorthOrigin + mountainPresenceBounds.depth &&
+    Number.isFinite(height) && height >= 0 && height <= mountainPresenceBounds.height;
+}
diff --git a/tests/server/za22-night-window-endpoint.test.ts b/tests/server/za22-night-window-endpoint.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c300f64a840c1835a693f57b06e9aaa7a67ba115
--- /dev/null
+++ b/tests/server/za22-night-window-endpoint.test.ts
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { test } from 'node:test';
+import { createZa22NightWindowEndpoint } from '../../src/presence/za22-night-window-endpoint.js';
+import {
+  isMountainPresenceFoot, mountainPresenceNorthOrigin, townNightWindowPath,
+} from '../../src/shared/za22-mountain-domain.js';
+
+test('the town HTTP authority opens after the received bell and closes at morning', async t => {
+  const dawnEpoch = 2_000_000;
+  let now = dawnEpoch + 419_999;
+  const { listener, tick } = createZa22NightWindowEndpoint({
+    dawnEpoch,
+    offsetsAfterDusk: Array(12).fill(60_000),
+    now: () => now,
+  });
+  const server = createServer(listener);
+  t.after(() => new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve())));
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const addr = `http://127.0.0.1:${(server.address() as AddressInfo).port}${townNightWindowPath}`;
+  assert.equal((await fetch(addr, { method: 'POST' })).status, 405);
+  const before = await fetch(addr);
+  assert.equal(before.headers.get('cache-control'), 'no-store');
+  assert.equal((await before.json()).canEnterRestricted, false);
+  now++;
+  tick();
+  const opened = await (await fetch(addr)).json();
+  assert.equal(opened.canEnterRestricted, true);
+  assert.equal(opened.beaconAt, now);
+  assert.equal(opened.chapterGatesLocked, true);
+  now += 60_000;
+  const noOverlap = await (await fetch(addr)).json();
+  assert.equal(noOverlap.layersOverlap, false);
+  assert.equal(noOverlap.canEnterRestricted, true);
+  now = dawnEpoch + 600_000;
+  assert.equal((await (await fetch(addr)).json()).canEnterRestricted, false);
+});
+
+test('mountain wire admission accepts both surveyed stops and rejects unencodable poses', () => {
+  assert.equal(isMountainPresenceFoot(336, 640, 347), true);
+  assert.equal(isMountainPresenceFoot(300, 666, 347), true);
+  assert.equal(isMountainPresenceFoot(526, mountainPresenceNorthOrigin - .01, 26), false);
+  assert.equal(isMountainPresenceFoot(300, 676, 800), false);
+});
diff --git a/tests/town-blockout-za22-cloud-route.test.ts b/tests/town-blockout-za22-cloud-route.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..056cd6beb46d9354035d8d12c7540c8c57879655
--- /dev/null
+++ b/tests/town-blockout-za22-cloud-route.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createZa22CloudRoute, createZa22NorthRidgeLine, za22CloudRunway, za22CloudSurfaceAt, za22StationApproach } from '../tools/voxel-tavern/town-blockout/town-za22-cloud-route';
+import { sampleNorthRidge350 } from '../tools/voxel-tavern/town-blockout/north-ridge-350-terrain';
+
+test('the front line follows three surveyed stations on one opposed-car clock', () => {
+  const line = createZa22NorthRidgeLine(26);
+  const epoch = Date.UTC(2026, 0, 1);
+  assert.deepEqual(line.pointAt(0), { east: 526, north: 329, height: 26 });
+  assert.deepEqual(line.pointAt(line.lowerMetres), { east: 440, north: 520, height: 140 });
+  assert.deepEqual(line.pointAt(line.length), { east: 336, north: 640, height: 347 });
+  assert.ok(line.length > 490 && line.length < 545, `witnessed line ${line.length} m`);
+  assert.equal(line.timeline(epoch + 500, 0).boarding, 'base');
+  assert.equal(line.timeline(epoch + 500, 1).boarding, 'summit');
+  assert.equal(line.timeline(epoch + 8001, 0).boarding, undefined);
+  for (let time = 8000; time < line.legMs; time += 100) {
+    const upward = line.timeline(epoch + time, 0);
+    const downward = line.timeline(epoch + time, 1);
+    assert.equal(upward.direction, 'up');
+    assert.equal(downward.direction, 'down');
+    assert.equal(upward.arrivalAt, epoch + line.legMs);
+  }
+  assert.ok(line.points.slice(1, -1).every(point => point.height >= sampleNorthRidge350(point.east, point.north)));
+  assert.equal(line.timeline(epoch + line.legMs, 0).boarding, 'summit');
+  assert.equal(line.timeline(epoch + line.legMs, 1).boarding, 'base');
+});
+
+test('the shared front floor reaches the surveyed cloud connection and the runway without a step', () => {
+  const path = [[336, 640], [336, 663.25], [300, 663.25], [300, 665.9]] as const;
+  for (let part = 1; part < path.length; part++) {
+    const a = path[part - 1]!, b = path[part]!;
+    const steps = Math.ceil(Math.hypot(a[0] - b[0], a[1] - b[1]) / .09);
+    for (let i = 0; i <= steps; i++) {
+      const f = i / steps;
+      assert.equal(za22CloudSurfaceAt(a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f), 347);
+    }
+  }
+  for (let east = za22CloudRunway.end; east <= za22CloudRunway.start; east += .25) {
+    assert.equal(za22CloudSurfaceAt(east, za22CloudRunway.north + 2.2), 347);
+    assert.equal(za22CloudSurfaceAt(east, za22CloudRunway.north - 2.2), 347);
+  }
+  assert.equal(za22CloudSurfaceAt(300, 666), undefined);
+  assert.equal(za22CloudSurfaceAt(350, 654), undefined);
+});
+
+test('boarding comes only from the legal station approach and authoritative night state', () => {
+  let night = false;
+  const cloud = createZa22CloudRoute({
+    now: () => Date.UTC(2026, 0, 1) + 20_000, nightOpen: () => night,
+    enterOrExit() { assert.fail('must not transfer'); }, view() { assert.fail('must not interact'); },
+  });
+  assert.equal(cloud.action(za22StationApproach), undefined);
+  night = true;
+  assert.equal(cloud.action({ ...za22StationApproach, height: 27.7 }), undefined);
+  assert.equal(cloud.action({ ...za22StationApproach, north: 320 }), undefined);
+  const board = cloud.action(za22StationApproach);
+  assert.equal(board?.label, '乘缆车一线前往云海台');
+  board?.run();
+  cloud.update(za22StationApproach);
+  assert.match(cloud.action(za22StationApproach)?.label ?? '', /等候前山缆车/);
+  assert.ok(!cloud.active());
+  night = false;
+  cloud.update(za22StationApproach);
+  night = true;
+  assert.equal(cloud.action(za22StationApproach)?.label, '乘缆车一线前往云海台');
+});
