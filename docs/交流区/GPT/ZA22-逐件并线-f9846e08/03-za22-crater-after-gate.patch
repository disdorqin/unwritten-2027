+          positions.push(e, samples[from], -n);
+          if (e === endE || n === endN) continue;
+          const a = (e - east) + (n - north) * width;
+          const b = a + 1, c = a + width, d = c + 1;
+          if (!inside[from] && !inside[from + 1] && !inside[from + eastCount]) indices.push(a, b, c);
