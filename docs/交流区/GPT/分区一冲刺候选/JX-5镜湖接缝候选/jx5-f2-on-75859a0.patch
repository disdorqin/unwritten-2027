+++ b/tests/town-blockout-mirror-f2-slope-review.test.ts
@@ -0,0 +1,193 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, Raycaster, Vector3 } from 'three';
+import { isMirrorLakeIce, mirrorLake } from '../src/shared/mirror-lake';
+import { addDistrictHousing } from '../tools/voxel-tavern/town-blockout/district-layout';
+import { addForestDensity } from '../tools/voxel-tavern/town-blockout/forest-density';
+import { readWalkGeometry } from '../tools/voxel-tavern/town-blockout/landmark-kit';
+import { createMirrorF2Slope, mirrorF2RoadAt, surveyedF2Corridor } from '../tools/voxel-tavern/town-blockout/mirror-lake-f2-slope';
+import { addScenery } from '../tools/voxel-tavern/town-blockout/scenery';
+import { addStreetscape } from '../tools/voxel-tavern/town-blockout/streetscape';
+import { canEnter, createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain';
+import { extensionRoadClearance, extensionStreetClearance } from '../tools/voxel-tavern/town-blockout/town-extension';
+import { buildPineCamp } from '../tools/voxel-tavern/town-blockout/town-pine-camp';
+import { createTownRailway } from '../tools/voxel-tavern/town-blockout/town-railway';
+
+// This is a review fixture and never a selected alignment or a frozen design.
+const profile = { halfWidth: 1, rowStep: 1, stages: [
+  { runFraction: .4, riseFraction: .5 },
+  { runFraction: .6, riseFraction: .5 },
+] };
+const terrain = createTerrainGrid();
+
+test('the staged F2 review surface meets the legacy shoulder without sampling road or strict ice', () => {
+  const candidate = createMirrorF2Slope(terrain.heightAt, profile);
+  try {
+    const north = 210;
+    const { centerEast, shoulderEast } = mirrorF2RoadAt(north);
+    const roadHeight = terrain.heightAt(centerEast, north);
+    const shoulderHeight = terrain.heightAt(shoulderEast, north);
+    const start = 73.7736380844118;
+    assert.ok(Math.abs(roadHeight - 16.509804) < 1e-6);
+    assert.equal(candidate.heightAt(centerEast, north), undefined);
+    assert.equal(candidate.heightAt(shoulderEast + .001, north), undefined);
+    assert.equal(candidate.heightAt(shoulderEast, north), shoulderHeight);
+    assert.equal(candidate.heightAt(start, north), mirrorLake.height);
+    assert.ok(isMirrorLakeIce(start - .001, north));
+    assert.equal(candidate.heightAt(start - .001, north), undefined);
+    assert.ok(terrain.heightAt(start, north) - mirrorLake.height > 10);
+    assert.equal(candidate.heightAt(shoulderEast - 1, 212), undefined);
+
+    const count = Math.ceil((shoulderEast - start) / .08);
+    const values = Array.from({ length: count + 1 }, (_, index) =>
+      candidate.heightAt(start + (shoulderEast - start) * index / count, north)!);
+    const maxRise = Math.max(...values.slice(1).map((value, index) => value - values[index]));
+    assert.ok(values.slice(1).every((value, index) => value >= values[index]));
+    assert.ok(maxRise < .43);
+    assert.ok(values.filter(value => Math.abs(value - (shoulderHeight + mirrorLake.height) / 2) < 1e-12).length > 1);
+    console.log(JSON.stringify({ north, centerEast, roadHeight, shoulderEast, shoulderHeight,
+      start, originalIceRimTerrain: terrain.heightAt(start, north), samples: values.length, maxRise }));
+  } finally {
+    candidate.dispose();
+  }
+});
+
+test('F2 mesh and local collision sampler coincide, clear existing rail and release independently', () => {
+  const railway = createTownRailway(terrain, () => Date.UTC(2026, 10, 19));
+  const rail = readWalkGeometry(railway.group);
+  const candidate = createMirrorF2Slope(terrain.heightAt, profile);
+  const scene = new Group();
+  scene.add(candidate.mesh);
+  candidate.mesh.updateMatrixWorld(true);
+  const ray = new Raycaster(new Vector3(), new Vector3(0, -1, 0));
+  const points = candidate.mesh.geometry.attributes.position;
+  const triangles = candidate.mesh.geometry.index!;
+  let maximumHeightDifference = 0, railContacts = 0, nearestRailPoint = Infinity;
+  const vertex = (index: number) => new Vector3().fromBufferAttribute(points, triangles.getX(index));
+  for (let i = 0; i < triangles.count; i += 3) {
+    const a = vertex(i), b = vertex(i + 1), c = vertex(i + 2);
+    // Include interior points on every rendered triangle.
+    for (let u = 1; u <= 7; u++) for (let v = 1; v <= 8 - u; v++) {
+      const point = a.clone().addScaledVector(b.clone().sub(a), u / 9).addScaledVector(c.clone().sub(a), v / 9);
+      const height = candidate.heightAt(point.x, -point.z);
+      assert.ok(height !== undefined);
+      ray.ray.origin.set(point.x, 35, point.z);
+      const hit = ray.intersectObject(candidate.mesh)[0];
+      assert.ok(hit);
+      maximumHeightDifference = Math.max(maximumHeightDifference, Math.abs(hit.point.y - height));
+      for (const { min, max } of [...rail.colliders, ...rail.floors]) {
+        const radius = Math.hypot(Math.max(min[0] - point.x, point.x - max[0], 0),
+          Math.max(min[2] - point.z, point.z - max[2], 0));
+        if (radius < .27 && height + .025 < max[1] && height + 1.95 > min[1]) railContacts++;
+      }
+      for (const p of railway.route.points) nearestRailPoint = Math.min(nearestRailPoint,
+        Math.hypot(p.x - point.x, p.z - point.z));
+    }
+  }
+  assert.equal(railContacts, 0);
+  assert.ok(maximumHeightDifference < .00001);
+  let disposed = 0;
+  candidate.mesh.geometry.addEventListener('dispose', () => disposed++);
+  candidate.mesh.material.addEventListener('dispose', () => disposed++);
+  candidate.dispose();
+  candidate.dispose();
+  assert.equal(scene.children.length, 0);
+  assert.equal(disposed, 2);
+  assert.equal(candidate.heightAt(78, 210), undefined);
+  console.log(JSON.stringify({ vertices: points.count, triangles: triangles.count / 3,
+    faceSamples: triangles.count / 3 * 28, maximumHeightDifference, railContacts, nearestRailPoint, disposed }));
+});
+
+test('the surveyed F2 alignment avoids the released forest and preserves the road and ice contacts', t => {
+  const landscape = new Group();
+  const railway = createTownRailway(terrain, () => Date.UTC(2026, 10, 19));
+  const camp = buildPineCamp(terrain);
+  const previousDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  Object.defineProperty(globalThis, 'document', {
+    configurable: true,
+    value: { createElement: () => ({ getContext: () => ({
+      createRadialGradient: () => ({ addColorStop() {} }),
+      fillRect() {}, strokeRect() {}, fillText() {}, drawImage() {},
+    }) }) },
+  });
+  let scenery: ReturnType<typeof addScenery>;
+  try {
+    scenery = addScenery(landscape, terrain, camp.keepClear);
+  } finally {
+    if (previousDocument) Object.defineProperty(globalThis, 'document', previousDocument);
+    else Reflect.deleteProperty(globalThis, 'document');
+  }
+  const districts = addDistrictHousing(landscape, terrain, scenery.blocked, railway.keepClear);
+  const streets = addStreetscape(landscape, terrain, (e, n, r) =>
+    districts.keepClear(e, n, r) || extensionRoadClearance(e, n, r) || camp.keepClear(e, n, r));
+  const forest = addForestDensity(landscape, terrain,
+    (e, n, r) => districts.keepClear(e, n, r) || streets.occupied(e, n, r) || camp.keepClear(e, n, r),
+    (e, n, r) => extensionRoadClearance(e, n, r) || railway.keepClear(e, n, r) || extensionStreetClearance(e, n, r));
+  const radius = .27;
+  const { colliders, floors } = readWalkGeometry(railway.group);
+  const railBoxes = [...colliders, ...floors];
+  const pathEnd = 72.5;
+  const { centerNorth, halfWidth } = surveyedF2Corridor;
+  const ramp = createMirrorF2Slope(terrain.heightAt, surveyedF2Corridor);
+  const heightAt = (east: number, north: number) => ramp.heightAt(east, north) ??
+    (isMirrorLakeIce(east, north) ? mirrorLake.height : terrain.heightAt(east, north));
+  let tested = 0;
+  let maximumAdjacentRise = 0;
+  let maximumSprintStep = 0;
+  let maximumShoulderStep = 0;
+  let maximumTerrainCover = 0;
+  try {
+    assert.ok([74.68, 74.76, 74.84, 74.92].some(east => forest.blocked(east, 210)));
+    let roadHeight = terrain.heightAt(mirrorF2RoadAt(210).centerEast, 210);
+    for (let index = 0; index <= 22; index++) {
+      const north = 210 + (centerNorth - 210) * index / 22;
+      const { centerEast } = mirrorF2RoadAt(north);
+      const nextHeight = terrain.heightAt(centerEast, north);
+      assert.ok(canEnter(centerEast, north) && !forest.blocked(centerEast, north));
+      assert.ok(Math.abs(nextHeight - roadHeight) < .43);
+      assert.equal(heightAt(centerEast, north), nextHeight);
+      roadHeight = nextHeight;
+    }
+    for (let row = -13; row <= 13; row++) {
+      const north = centerNorth + halfWidth * row / 13;
+      const { centerEast, shoulderEast } = mirrorF2RoadAt(north);
+      assert.equal(ramp.heightAt(centerEast, north), undefined);
+      const rimHeight = ramp.heightAt(shoulderEast, north);
+      assert.ok(rimHeight !== undefined && Math.abs(rimHeight - terrain.heightAt(shoulderEast, north)) < .43,
+        `Shoulder N${north}: ramp Y${rimHeight}, road Y${terrain.heightAt(shoulderEast, north)}`);
+      maximumShoulderStep = Math.max(maximumShoulderStep, Math.abs(rimHeight - terrain.heightAt(shoulderEast, north)));
+      assert.equal(heightAt(pathEnd, north), mirrorLake.height);
+      const samples = Math.ceil((centerEast - pathEnd) / .04);
+      for (let step = 0; step <= samples; step++) {
+        const east = pathEnd + (centerEast - pathEnd) * step / samples;
+        const feet = heightAt(east, north);
+        maximumTerrainCover = Math.max(maximumTerrainCover, terrain.heightAt(east, north) - feet);
+        assert.ok(canEnter(east, north) || isMirrorLakeIce(east, north), `Ground at E${east}, N${north}`);
+        assert.equal(scenery.blocked(east, north) || scenery.plazaCoverBlocks(east, north, radius) ||
+          districts.blocked(east, north) || streets.blocked(east, north) || forest.blocked(east, north),
+        false, `Static obstruction at E${east}, N${north}`);
+        assert.ok(!railBoxes.some(({ min, max }) =>
+          feet + .025 < max[1] && feet + 1.8 - .025 > min[1] &&
+          Math.hypot(Math.max(min[0] - east, east - max[0], 0), Math.max(min[2] + north, -north - max[2], 0)) < radius),
+        `Rail obstruction at E${east}, N${north}`);
+        const slopeRun = Math.min(centerEast, east + 11.3 / 60);
+        maximumSprintStep = Math.max(maximumSprintStep, Math.abs(heightAt(slopeRun, north) - feet));
+        if (step) {
+          const earlier = heightAt(pathEnd + (centerEast - pathEnd) * (step - 1) / samples, north);
+          maximumAdjacentRise = Math.max(maximumAdjacentRise, Math.abs(feet - earlier));
+        }
+        tested++;
+      }
+    }
+    assert.ok(maximumSprintStep < .43, 'Either travel direction stays inside the current step limit');
+  } finally {
+    ramp.dispose();
+  }
+  assert.equal(ramp.heightAt(78, centerNorth), undefined);
+  t.diagnostic(JSON.stringify({
+    centerNorth, south: centerNorth - halfWidth, north: centerNorth + halfWidth,
+    tested, maximumAdjacentRise, maximumSprintStep, maximumShoulderStep, maximumTerrainCover,
+    edgeHeight: heightAt(pathEnd, centerNorth),
+    centerRoadHeight: terrain.heightAt(mirrorF2RoadAt(centerNorth).centerEast, centerNorth),
+  }));
+});
diff --git a/tools/voxel-tavern/town-blockout/mirror-lake-f2-slope.ts b/tools/voxel-tavern/town-blockout/mirror-lake-f2-slope.ts
