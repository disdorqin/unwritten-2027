+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { playOrdinaryNinthBell, playTowerBell } from '../tools/voxel-tavern/tower-chime';
+
+function audioFixture() {
+  const nodes: ReturnType<typeof node>[] = [];
+  const buffers: number[] = [];
+  function param() {
+    const values: [number, number][] = [];
+    function add(value: number, at: number) { values.push([value, at]); }
+    return { value: 0, values, setValueAtTime: add, linearRampToValueAtTime: add, exponentialRampToValueAtTime: add };
+  }
+  function node(kind: string) {
+    return { kind, type: '', panningModel: '', rolloffFactor: 1, frequency: param(), detune: param(), gain: param(),
+      positionX: param(), positionY: param(), positionZ: param(), offset: param(), startAt: 0, stopAt: 0,
+      disconnected: false, onended: undefined as (() => void) | undefined,
+      start(at: number) { this.startAt = at; }, stop(at: number) { this.stopAt = at; },
+      connect<T>(destination: T) { return destination; }, disconnect() { this.disconnected = true; } };
+  }
+  function create(kind: string) { const result = node(kind); nodes.push(result); return result; }
+  const ctx = { state: 'running', currentTime: 10, sampleRate: 8_000, destination: node('destination'),
+    createOscillator: () => create('oscillator'), createGain: () => create('gain'),
+    createBiquadFilter: () => create('filter'), createPanner: () => create('panner'),
+    createConvolver: () => create('convolver'), createConstantSource: () => create('cleanup'),
+    createBuffer(_channels: number, length: number) {
+      buffers.push(length);
+      return { getChannelData: () => new Float32Array(length) };
+    } };
+  return { ctx, audio: ctx as unknown as AudioContext, nodes, buffers };
+}
+
+test('the ninth uses the agreed filter, tail and pitch with explicit host mix and direction', () => {
+  const { audio, nodes, buffers } = audioFixture();
+  playOrdinaryNinthBell(audio, 2, { sourceInListenerSpace: [-1, .5, -.25], gainDb: -8, wetMix: .3 });
+  const [filter, panner, dry, wet] = nodes;
+  assert.deepEqual([filter.type, filter.frequency.value], ['lowpass', 1200]);
+  assert.deepEqual([panner.panningModel, panner.positionX.value, panner.positionY.value, panner.positionZ.value],
+    ['HRTF', -1, .5, -.25]);
+  assert.deepEqual([dry.gain.value, wet.gain.value], [.7, .3]);
+  assert.deepEqual(buffers, [48_000]);
+  const tones = nodes.filter(node => node.kind === 'oscillator');
+  assert.equal(tones.length, 3);
+  for (const tone of tones) {
+    assert.equal(tone.startAt, 12.045);
+    assert.equal(tone.detune.values[1][0], -50);
+  }
+  const cleanup = nodes.at(-1)!;
+  assert.equal(cleanup.kind, 'cleanup');
+  assert.ok(cleanup.stopAt >= Math.max(...tones.map(tone => tone.stopAt)) + 6);
+  cleanup.onended?.();
+  assert.ok(nodes.filter(node => node.kind !== 'oscillator').slice(0, 5).every(node => node.disconnected));
+  playOrdinaryNinthBell(audio, 3, { sourceInListenerSpace: [-1, .5, -.25], gainDb: -8, wetMix: .3 });
+  assert.deepEqual(buffers, [48_000]);
+});
+
+test('the existing tower voice still allocates six untuned partials per strike', () => {
+  const { audio, nodes } = audioFixture();
+  playTowerBell(audio, 'small', 20, 3);
+  const tones = nodes.filter(node => node.kind === 'oscillator');
+  assert.equal(tones.length, 18);
+  assert.deepEqual([...new Set(tones.map(tone => tone.startAt))], [10.045, 12.065, 14.085]);
+  assert.ok(tones.every(tone => tone.detune.values.length === 0));
+});
