+type NinthBellSound = {
+  sourceInListenerSpace: readonly [number, number, number];
+  gainDb: number;
+  wetMix: number;
+};
+
+const ninthBellImpulses = new WeakMap<AudioContext, AudioBuffer>();
+
+/** Play an externally scheduled ninth strike using the ordinary tower voice. */
+export function playOrdinaryNinthBell(context: AudioContext, delaySeconds: number, sound: NinthBellSound) {
+  const [x, y, z] = sound.sourceInListenerSpace;
+  if (context.state !== 'running' || ![delaySeconds, x, y, z, sound.gainDb, sound.wetMix].every(Number.isFinite) ||
+    delaySeconds < 0 || Math.hypot(x, y, z) === 0 || sound.gainDb > 0 || sound.wetMix < 0 || sound.wetMix > 1) return;
+  const { lowpassHz, tailSeconds, tailDetuneCents } = ordinaryNinthSound;
+
+  const filter = context.createBiquadFilter();
+  filter.type = 'lowpass';
+  filter.frequency.value = lowpassHz;
+  const panner = context.createPanner();
+  panner.panningModel = 'HRTF';
+  panner.rolloffFactor = 0;
+  panner.positionX.value = x;
+  panner.positionY.value = y;
+  panner.positionZ.value = z;
+  const dry = context.createGain();
+  const wet = context.createGain();
+  dry.gain.value = 1 - sound.wetMix;
+  wet.gain.value = sound.wetMix;
+  const convolution = context.createConvolver();
+  let impulse = ninthBellImpulses.get(context);
+  if (!impulse) {
+    impulse = context.createBuffer(1, Math.ceil(tailSeconds * context.sampleRate), context.sampleRate);
+    const samples = impulse.getChannelData(0);
+    let seed = 7319;
+    for (let i = 0; i < samples.length; i++) {
+      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+      samples[i] = (seed / 2147483648 - 1) * Math.pow(.001, i / samples.length);
+    }
+    ninthBellImpulses.set(context, impulse);
+  }
+  convolution.buffer = impulse;
+  filter.connect(dry).connect(panner);
+  filter.connect(convolution).connect(wet).connect(panner);
+  panner.connect(context.destination);
+
+  const at = context.currentTime + .045 + delaySeconds;
+  playBellTone(context, filter, at, bellFrequency, .36 * Math.pow(10, sound.gainDb / 20), 1, undefined,
+    { partialCount: 3, tailDetuneCents });
+  // Use the audio clock so a suspended tab cannot trim the convolution tail.
+  const cleanup = context.createConstantSource();
+  cleanup.offset.value = 0;
+  cleanup.connect(context.destination);
+  cleanup.onended = () => {
+    for (const node of [filter, convolution, dry, wet, panner, cleanup]) node.disconnect();
+  };
+  cleanup.start(at);
+  cleanup.stop(at + partials[1][2] + tailSeconds + .03);
+}
