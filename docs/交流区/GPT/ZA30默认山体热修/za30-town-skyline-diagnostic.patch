+function observeTownSkyline() {
+  const gl = WebGL2RenderingContext.prototype;
+  const bufferData = gl.bufferData;
+  const drawElements = gl.drawElements;
+  const skylineBuffers = new WeakSet();
+  let skyline = [];
+  window.skylineProfiles = [];
+  // Capture the existing mouse-drag fallback on a headless display.
+  HTMLCanvasElement.prototype.requestPointerLock = undefined;
+
+  gl.bufferData = function (target, data, ...args) {
+    bufferData.call(this, target, data, ...args);
+    if (target !== this.ELEMENT_ARRAY_BUFFER || this.canvas.parentElement?.id !== 'scene') return;
+    if (!(data instanceof Uint16Array) || data.length !== 4350) return;
+    let hash = 2166136261;
+    for (const index of data) hash = Math.imul(hash ^ index, 16777619);
+    // The surveyed 100 m grid has 1,450 indexed triangles.
+    const buffer = this.getParameter(this.ELEMENT_ARRAY_BUFFER_BINDING);
+    if (buffer && (hash >>> 0) === 2706687782) skylineBuffers.add(buffer);
+  };
+
+  const transform = (m, [x, y, z, w]) => [0, 1, 2, 3].map(i => m[i] * x + m[i + 4] * y + m[i + 8] * z + m[i + 12] * w);
+  gl.drawElements = function (mode, count, type, offset) {
+    drawElements.call(this, mode, count, type, offset);
+    if (mode !== this.TRIANGLES || count !== 4350 || type !== this.UNSIGNED_SHORT || offset !== 0 ||
+        this.canvas.parentElement?.id !== 'scene' || !skylineBuffers.has(this.getParameter(this.ELEMENT_ARRAY_BUFFER_BINDING))) return;
+    const program = this.getParameter(this.CURRENT_PROGRAM);
+    if (!program) return;
+    const projectionLocation = this.getUniformLocation(program, 'projectionMatrix');
+    const modelViewLocation = this.getUniformLocation(program, 'modelViewMatrix');
+    if (!projectionLocation || !modelViewLocation) return;
+    const projection = this.getUniform(program, projectionLocation);
+    const modelView = this.getUniform(program, modelViewLocation);
+    const [x, y, z, w] = transform(projection, transform(modelView, [50, 800, -1000, 1]));
+    skyline.push({ triangles: count / 3, far: projection[14] / (projection[10] + 1), peakNdc: [x / w, y / w, z / w] });
+  };
+
+  document.addEventListener('town-frame-profile', ({ detail }) => {
+    if (window.skylineProfiles.length === 30) window.skylineProfiles.shift();
+    window.skylineProfiles.push({ ...detail, skyline });
+    skyline = [];
+  }, true);
+}
+
+function townSkylineReady(reportTelemetry) {
+  const profiles = window.skylineProfiles.slice(-3);
+  return profiles.length === 3 && profiles.every(profile => {
+    if (!(profile.calls > 0) || profile.skyline.length !== 1) return false;
+    const [{ triangles, far, peakNdc }] = profile.skyline;
+    // WebGL receives a float32 projection matrix; its recovered far plane is approximate.
+    if (triangles !== 1450 || !(Math.abs(far - 2400) < 1) || !peakNdc.every(value => Math.abs(value) <= 1)) return false;
+    if (!reportTelemetry) return profile.summitSkyline === undefined;
+    const telemetry = profile.summitSkyline;
+    return telemetry?.draws === 1 && telemetry.far === 2400 && telemetry.peakNdc?.length === 3 &&
+      telemetry.peakNdc.every((value, i) => Math.abs(value - peakNdc[i]) < .0001);
+  });
+}
