+export type FirstNightHomeAssignment = Readonly<{ principalKey: string; houseId: string }>;
+
+type AssignmentStore = {
+  load(): unknown;
+  save(assignments: readonly FirstNightHomeAssignment[]): undefined;
+};
+
+function validKey(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0;
+}
+
+/** Host-authenticated first-arrival route assignment. House ownership is a separate action. */
+export function createFirstNightHomeAssignments(houseIds: readonly string[], store: AssignmentStore) {
+  const ordered = [...houseIds];
+  const registered = new Set(ordered);
+  if (ordered.length !== 52 || registered.size !== 52 || !ordered.every(validKey)) {
+    throw new Error('First-night assignment requires 52 unique registered houses.');
+  }
+
+  const assigned = new Map<string, string>();
+  const used = new Set<string>();
+  const saved = store.load();
+  if (saved !== undefined) {
+    if (!Array.isArray(saved)) throw new Error('Invalid first-night housing records.');
+    for (const row of saved as unknown[]) {
+      if (!row || typeof row !== 'object' || !('principalKey' in row) || !('houseId' in row)) {
+        throw new Error('Invalid first-night housing record.');
+      }
+      const { principalKey, houseId } = row;
+      if (!validKey(principalKey) || !validKey(houseId) || !registered.has(houseId) ||
+          assigned.has(principalKey) || used.has(houseId)) {
+        throw new Error('Invalid or duplicate first-night housing record.');
+      }
+      assigned.set(principalKey, houseId);
+      used.add(houseId);
+    }
+  }
+
+  // Call once at the authoritative admission point after resolving the stable principal.
+  function assign(principalKey: string): string | undefined {
+    if (!validKey(principalKey)) throw new Error('A verified principal key is required.');
+    const existing = assigned.get(principalKey);
+    if (existing !== undefined) return existing;
+    const houseId = ordered.find(candidate => !used.has(candidate));
+    if (houseId === undefined) return undefined;
+
+    const records = Array.from(assigned, ([principalKey, houseId]) => ({ principalKey, houseId }));
+    records.push({ principalKey, houseId });
+    store.save(records);
+    assigned.set(principalKey, houseId);
+    used.add(houseId);
+    return houseId;
+  }
+
+  return { assign };
+}
diff --git a/tests/server/first-night-home.test.ts b/tests/server/first-night-home.test.ts
