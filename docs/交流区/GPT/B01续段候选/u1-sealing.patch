+++ b/tests/town-blockout-meteor-crater-sealing.test.ts
@@ -0,0 +1,132 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, InstancedMesh, Matrix4, Texture, Vector3 } from 'three';
+import { createMeteorCrater, meteorCraterRimRadius } from '../tools/voxel-tavern/town-blockout/meteor-crater.ts';
+import { buildCraterSealing, craterSealSignText, findCraterSealingObstruction, isCraterSealSignText, planCraterSealing } from '../tools/voxel-tavern/town-blockout/meteor-crater-sealing.ts';
+
+const crater = createMeteorCrater({
+  terraces: [{ outerRadius: 50, innerRadius: 46, depth: 7 }, { outerRadius: 41, innerRadius: 37, depth: 16 },
+    { outerRadius: 32, innerRadius: 27, depth: 26 }],
+  mainTrail: { startBearing: .7, turns: 3.5, halfWidth: 1, shoulderWidth: 1, maxGrade: .1 },
+});
+const surface = crater.buildPreviewSurface(meteorCraterRimRadius / 30);
+const entryGap = crater.mainTrailPoint(0);
+const second = crater.mainTrailPoint(.001);
+const entryDirection = { east: second.east - entryGap.east, north: second.north - entryGap.north };
+const anchors = { pitCenter: { east: 0, north: 0 }, entryGap, entryDirection,
+  rimWall: { east: 3, north: 55.3, yaw: .15 }, terraceWall: { east: 0, north: 39, yaw: 0 },
+  cargo: { east: 54, north: -18, yaw: 1.6 }, rimCrane: { east: 13, north: -54 },
+  heightAt: surface.heightAt };
+const plan = planCraterSealing(anchors);
+
+test('sealing signs use only the approved short commands and statuses', () => {
+  assert.ok(craterSealSignText.every(word => /^[\p{Script=Han}]{2,6}$/u.test(word)));
+  for (const invalid of ['编号12', '2026', '李工', '应急管理处', '危险！', 'DANGER', '封 存']) {
+    assert.equal(isCraterSealSignText(invalid), false);
+  }
+  assert.deepEqual(new Set(plan.signs.map(sign => sign.text)), new Set(['封存', '止步', '勿动', '待检']));
+  assert.ok(plan.signs.every(sign => isCraterSealSignText(sign.text)));
+});
+
+test('the actual spiral mesh still clears the broken fence and four other scenery groups', t => {
+  const scenery = buildCraterSealing(plan, () => new Texture());
+  t.after(() => scenery.dispose());
+  const boxes = scenery.group.userData.colliders as { min: number[]; max: number[] }[];
+  function blockedByNativeBox({ east, north, height }: { east: number; north: number; height: number }) {
+    return boxes.some(({ min, max }) => {
+      const x = Math.max(0, min[0] - east, east - max[0]);
+      const z = Math.max(0, min[2] + north, -north - max[2]);
+      return height + .025 < max[1] && height + 1.8 - .025 > min[1] && x * x + z * z < .27 * .27;
+    });
+  }
+  const counts = [];
+  for (const offset of [0, -.27, .27]) {
+    const route = Array.from({ length: 1501 }, (_, i) => {
+      const sample = crater.mainTrailPoint(i / 1500);
+      const scale = 1 + offset / Math.hypot(sample.east, sample.north);
+      const east = sample.east * scale, north = sample.north * scale;
+      const height = surface.heightAt(east, north);
+      assert.notEqual(height, undefined);
+      return { east, north, height: height! };
+    });
+    assert.equal(findCraterSealingObstruction(plan, route), undefined);
+    assert.equal(findCraterSealingObstruction(plan, [...route].reverse()), undefined);
+    assert.ok(route.every(feet => !blockedByNativeBox(feet)));
+    counts.push(route.length);
+  }
+  const fence = plan.colliders.filter(collider => collider.fixture === 'fence');
+  assert.equal(fence.length, 2);
+  const centerDistance = Math.hypot(fence[0].center.east - fence[1].center.east, fence[0].center.north - fence[1].center.north);
+  const gap = centerDistance - fence[0].size[0];
+  assert.ok(Math.abs(gap - 3.2) < 1e-12);
+  const directionLength = Math.hypot(entryDirection.east, entryDirection.north);
+  const crossing = Array.from({ length: 27 }, (_, index) => {
+    const distance = (index - 18) * .09;
+    const east = entryGap.east + distance * entryDirection.east / directionLength;
+    const north = entryGap.north + distance * entryDirection.north / directionLength;
+    const height = surface.heightAt(east, north);
+    assert.notEqual(height, undefined);
+    return { east, north, height: height! };
+  });
+  assert.equal(findCraterSealingObstruction(plan, crossing), undefined);
+  assert.ok(crossing.every(feet => !blockedByNativeBox(feet)));
+  t.diagnostic(JSON.stringify({ samples: counts.reduce((a, b) => a + b), reversible: true, clearFenceGapMetres: gap,
+    playerDiameter: .54, props: { renderedBoxes: plan.boxes.length, renderedBeams: plan.beams.length,
+      blockers: plan.colliders.length, signs: plan.signs.length } }));
+});
+
+test('a cargo seam is visibly dark but its solid shell and the walls still block movement', () => {
+  const crate = plan.colliders.find(collider => collider.fixture === 'cargo')!;
+  const crateFront = { ...crate.center, height: crate.center.height - 1 };
+  assert.deepEqual(findCraterSealingObstruction(plan, [crateFront]), { fixture: 'cargo', index: 0 });
+  const cargoBoxes = plan.boxes.filter(piece => piece.fixture === 'cargo');
+  assert.equal(cargoBoxes.filter(piece => piece.color === '#13151a').length, 1);
+  assert.equal(cargoBoxes.find(piece => piece.color === '#13151a')!.size[0], .16);
+  const wall = plan.colliders.find(collider => collider.fixture === 'rim-wall')!;
+  assert.deepEqual(findCraterSealingObstruction(plan, [{ ...wall.center, height: wall.center.height - .7 }]),
+    { fixture: 'rim-wall', index: 0 });
+});
+
+test('the main damaged crane arm points to the physical crater center and leaves the pit-bottom well separate', () => {
+  const arm = plan.beams.find(piece => piece.fixture === 'crane')!;
+  const ve = arm.end.east - arm.start.east, vn = arm.end.north - arm.start.north;
+  const de = anchors.pitCenter.east - anchors.rimCrane.east;
+  const dn = anchors.pitCenter.north - anchors.rimCrane.north;
+  const cosine = (ve * de + vn * dn) / (Math.hypot(ve, vn) * Math.hypot(de, dn));
+  assert.ok(cosine > .999999999999);
+  assert.equal(findCraterSealingObstruction(plan, [{ east: 0, north: 0, height: -35 }]), undefined);
+});
+
+test('unsupported geometry and missing alignment are rejected', () => {
+  assert.throws(() => planCraterSealing({ ...anchors, heightAt: () => undefined }), /supported anchor/);
+  assert.throws(() => planCraterSealing({ ...anchors, entryDirection: { east: 0, north: 0 } }), /entry direction/);
+  assert.throws(() => planCraterSealing({ ...anchors, cargo: { ...anchors.cargo, yaw: NaN } }), /finite/);
+  assert.throws(() => findCraterSealingObstruction(plan, [{ east: 0, north: 0, height: NaN }]), /finite foot/);
+});
+
+test('the Three mesh uses one solid batch, preserves placement and releases all owned sign textures', () => {
+  const made: string[] = [];
+  let textureDisposals = 0;
+  const scenery = buildCraterSealing(plan, ({ text }) => {
+    made.push(text);
+    const texture = new Texture();
+    texture.addEventListener('dispose', () => textureDisposals++);
+    return texture;
+  });
+  const host = new Group();
+  host.add(scenery.group);
+  const batch = scenery.group.children[0];
+  assert.ok(batch instanceof InstancedMesh);
+  assert.equal(batch.count, 55);
+  const matrix = new Matrix4();
+  batch.getMatrixAt(0, matrix);
+  const expected = plan.boxes[0].center;
+  assert.ok(new Vector3().setFromMatrixPosition(matrix)
+    .distanceTo(new Vector3(expected.east, expected.height, -expected.north)) < 1e-5);
+  assert.equal(scenery.group.children.length, 5);
+  assert.deepEqual(made, plan.signs.map(sign => sign.text));
+  scenery.dispose();
+  scenery.dispose();
+  assert.equal(textureDisposals, 4);
+  assert.equal(host.children.length, 0);
+});
