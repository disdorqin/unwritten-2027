@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  orbitalAnchorIds, readOrbitalDualKeyStatus, resolveOrbitalAnchorVisit,
+  type AcceptedOrbitalMovement, type OrbitalAnchorHost, type OrbitalAnchorId,
+} from '../../src/presence/orbital-anchor-registry.ts';
+import { resolveOrbitalGateTravel, type OrbitalGateHost } from '../../src/presence/orbital-gates.ts';
+
+// Separate authority fixtures intentionally reuse a horizontal position across layers.
+const footpoints: Record<OrbitalAnchorId, AcceptedOrbitalMovement> = {
+  starport: { domain: 'front-ridge', pose: { east: 3, north: 4, height: 350, yaw: 0 }, route: 'physical' },
+  'crater-bottom': { domain: 'west-crater', pose: { east: 3, north: 4, height: -35, yaw: 0 }, route: 'physical' },
+  summit: { domain: 'summit', pose: { east: 9, north: 7, height: 800, yaw: 0 }, route: 'physical' },
+  plaza: { domain: 'old-town', pose: { east: 8, north: 6, height: 12, yaw: 0 }, route: 'physical' },
+};
+const sites: OrbitalAnchorHost = Object.fromEntries(orbitalAnchorIds.map(id => {
+  const { domain, pose } = footpoints[id];
+  const point = { domain, containsSupportedFootpoint(at: typeof pose) {
+    return pose.east === at.east && pose.north === at.north && pose.height === at.height;
+  } };
+  return [id, point];
+}));
+
+test('all four anchors record the first successful physical visit exactly once', () => {
+  const initial: readonly OrbitalAnchorId[] = [];
+  let state = initial;
+  for (const [index, anchor] of orbitalAnchorIds.entries()) {
+    const result = resolveOrbitalAnchorVisit(anchor, footpoints[anchor], state, sites);
+    assert.ok(result.ok && result.added);
+    assert.deepEqual(result.visited, orbitalAnchorIds.slice(0, index + 1));
+    const repeat = resolveOrbitalAnchorVisit(anchor, footpoints[anchor], result.visited, sites);
+    assert.deepEqual(repeat, { ok: true, added: false, visited: result.visited });
+    state = result.visited;
+  }
+  assert.deepEqual(initial, []);
+});
+
+test('cannot register a claimed, unmounted, transported, restored, or wrong-domain site', () => {
+  const local = footpoints.starport;
+  for (const value of [null, 'constructor', { id: 'starport', pose: local.pose }]) {
+    assert.deepEqual(resolveOrbitalAnchorVisit(value, local, [], sites), { ok: false, reason: 'invalid-anchor' });
+  }
+  assert.deepEqual(resolveOrbitalAnchorVisit('starport', local, [], {}), { ok: false, reason: 'missing-anchor' });
+  for (const route of ['transport', 'restore'] as const) {
+    assert.deepEqual(resolveOrbitalAnchorVisit('starport', { ...local, route }, [], sites),
+      { ok: false, reason: 'not-physical' });
+  }
+  assert.deepEqual(resolveOrbitalAnchorVisit('starport', { ...local, domain: 'west-crater' }, [], sites),
+    { ok: false, reason: 'wrong-position' });
+  for (const pose of [{ ...local.pose, height: -35 }, { ...local.pose, yaw: Number.NaN }]) {
+    assert.deepEqual(resolveOrbitalAnchorVisit('starport', { ...local, pose }, [], sites),
+      { ok: false, reason: 'wrong-position' });
+  }
+});
+
+test('the two keys count distinct in-range pages and cannot change either closed gate', () => {
+  const all = Array.from({ length: 12 }, (_, i) => i + 1);
+  for (const assembled of [false, true]) {
+    assert.deepEqual(readOrbitalDualKeyStatus(all, assembled), {
+      collectedPages: 12, fragmentsComplete: true, flyerAssembled: assembled,
+    });
+  }
+  assert.deepEqual(readOrbitalDualKeyStatus([...all.slice(0, 11), 1, 13, 12.5, Infinity], true), {
+    collectedPages: 11, fragmentsComplete: false, flyerAssembled: true,
+  });
+  const host: OrbitalGateHost = {
+    isOpen: () => false, isAtOpening: () => true,
+    landingAt: () => { throw new Error('A locked gate cannot query its landing'); },
+    isLegalLanding: () => false,
+  };
+  const keys = readOrbitalDualKeyStatus(all, true);
+  for (const gate of ['starport', 'core'] as const) {
+    assert.deepEqual(resolveOrbitalGateTravel({ gate, direction: 'enter', ...keys }, {
+      site: gate, pose: footpoints.starport.pose,
+    }, host), { ok: false, reason: 'locked' });
+  }
+});
