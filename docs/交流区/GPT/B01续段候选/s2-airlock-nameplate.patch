+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Box3, Mesh, MeshStandardMaterial } from 'three';
+import { createOrbitalEarlyRooms } from '../tools/voxel-tavern/town-blockout/orbital-early-rooms';
+
+test('the airlock nameplate and muted ship emblem share the existing opaque wall batch', () => {
+  const { group, collisions } = createOrbitalEarlyRooms();
+  const wall = group.getObjectByName('orbital-status-wall');
+  assert.ok(wall instanceof Mesh && wall.material instanceof MeshStandardMaterial);
+  assert.equal(wall.material.vertexColors, true);
+  assert.equal(wall.material.emissive.getHex(), 0);
+  assert.deepEqual(wall.userData.nameplate, {
+    text: '未央号', motif: 'half-moon-and-descending-arc', y: 2.62, north: -3.776,
+  });
+  const bounds = new Box3().setFromObject(wall);
+  assert.ok(bounds.max.y > 2.75 && bounds.max.y < 2.95);
+  assert.ok(bounds.min.z > 3.5);
+  assert.ok(Math.abs(bounds.max.z - 3.825) < 1e-6);
+  const equalCounts = { red: 0, green: 0, wall: 0 };
+  group.traverse(node => {
+    if (node.name === 'status-red') equalCounts.red++;
+    if (['status-teleport', 'status-life-support'].includes(node.name)) equalCounts.green++;
+    if (node.name === 'orbital-status-wall') equalCounts.wall++;
+    if (/^orbital-.*frame$/.test(node.name)) assert.equal(node.userData.nameplate, undefined);
+  });
+  assert.deepEqual(equalCounts, { red: 16, green: 2, wall: 1 });
+  assert.deepEqual(collisions.find(collider => collider.kind === 'status-panel'),
+    { kind: 'status-panel', minX: -2.225, maxX: 2.225, minN: -3.82, maxN: -3.48 });
+});
+
+test('both accepted airlock landings reach both log hand stations and return on the same standing path', t => {
+  const { ports, cockpit, floorHeightAt, isWalkable } = createOrbitalEarlyRooms();
+  let measured = 0;
+  let maxStep = 0;
+  for (const { arrival } of Object.values(ports)) {
+    for (const hand of [cockpit.leftHand, cockpit.rightHand]) {
+      const points = [arrival, { x: hand.x, n: arrival.n }, hand];
+      for (const route of [points, [...points].reverse()]) {
+        let previous = floorHeightAt(route[0]!.x, route[0]!.n)!;
+        for (const [index, point] of route.entries()) {
+          if (!index) continue;
+          const from = route[index - 1]!;
+          const count = Math.ceil(Math.hypot(point.x - from.x, point.n - from.n) / .05);
+          for (let step = 0; step <= count; step++) {
+            const x = from.x + (point.x - from.x) * step / count;
+            const n = from.n + (point.n - from.n) * step / count;
+            const ground = floorHeightAt(x, n);
+            assert.ok(ground !== undefined && isWalkable(x, n, .27), JSON.stringify({ x, n }));
+            maxStep = Math.max(maxStep, Math.abs(ground - previous));
+            previous = ground;
+            measured++;
+          }
+        }
+      }
+    }
+  }
+  assert.equal(cockpit.log.text, '');
+  assert.equal(measured, 2072);
+  assert.ok(maxStep <= .43);
+  t.diagnostic(JSON.stringify({ directions: 8, measured, maxStep }));
+});
