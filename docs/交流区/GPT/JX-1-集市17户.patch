diff --git a/tools/voxel-tavern/town-blockout/market-homes-review.ts b/tools/voxel-tavern/town-blockout/market-homes-review.ts
new file mode 100644
index 0000000..60331e7
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/market-homes-review.ts
@@ -0,0 +1,262 @@
+import {
+  BufferGeometry, Color, DirectionalLight, Float32BufferAttribute, Group, HemisphereLight,
+  Mesh, MeshLambertMaterial, PerspectiveCamera, Scene, Vector3, WebGLRenderer,
+} from 'three';
+import { addDistrictHousing } from './district-layout';
+import { buildPineCamp } from './town-pine-camp';
+import { addScenery } from './scenery';
+import { canEnter, createTerrainGrid, isWater } from './terrain';
+import { createTownRailway } from './town-railway';
+import { buildMarketHomeInterior, marketHomeIds } from './market-home-interior';
+import { canStandInMarketHome, marketHomeWalkRoute } from './market-home-walk';
+import streetRoutes from './market-homes-review-routes.json';
+
+type Angle = 'street' | 'north' | 'east' | 'south' | 'west' | 'interior';
+type Point = { x: number; z: number };
+
+const viewport = document.querySelector<HTMLElement>('#market-review-viewport')!;
+const picker = document.querySelector<HTMLSelectElement>('#market-review-home')!;
+const status = document.querySelector<HTMLElement>('#market-review-status')!;
+const walkButton = document.querySelector<HTMLButtonElement>('#market-review-walk')!;
+const exterior = new Scene();
+const interior = new Scene();
+const camera = new PerspectiveCamera(52, 1, .08, 480);
+const renderer = new WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
+renderer.setPixelRatio(1);
+viewport.append(renderer.domElement);
+
+for (const scene of [exterior, interior]) {
+  scene.background = new Color(scene === exterior ? '#b9cddd' : '#362c2b');
+  scene.add(new HemisphereLight('#fff4e5', '#5d5c73', scene === exterior ? 2.1 : 1.5));
+}
+const sun = new DirectionalLight('#ffe7bd', 2.4);
+sun.position.set(-42, 80, -25);
+exterior.add(sun);
+const landscape = new Group();
+exterior.add(landscape);
+const grid = createTerrainGrid();
+const pine = buildPineCamp(grid);
+const scenery = addScenery(landscape, grid, pine.keepClear);
+const rail = createTownRailway(grid, () => 0);
+const district = addDistrictHousing(landscape, grid, scenery.blocked, rail.keepClear);
+
+// Existing housing and porch geometry sits on a cropped, sampled display of the same terrain.
+const land = new BufferGeometry();
+const xyz: number[] = [];
+const faces: number[] = [];
+const columns = 221;
+const rows = 211;
+for (let row = 0; row < rows; row++) {
+  for (let column = 0; column < columns; column++) {
+    const east = 62 + column;
+    const north = 28 + row;
+    xyz.push(east, grid.heightAt(east, north), -north);
+    if (row + 1 === rows || column + 1 === columns) continue;
+    const index = row * columns + column;
+    faces.push(index, index + 1, index + columns, index + 1, index + columns + 1, index + columns);
+  }
+}
+land.setAttribute('position', new Float32BufferAttribute(xyz, 3));
+land.setIndex(faces);
+land.computeVertexNormals();
+landscape.add(new Mesh(land, new MeshLambertMaterial({ color: '#d8e5ec' })));
+
+const rowsById = new Map(district.housePortals.flatMap((portal, index) =>
+  portal.zone === 'market' && portal.id.startsWith('old-town:')
+    ? [[portal.id, { portal, site: district.sites[index], card: district.housingCards.get(portal.id) }] as const]
+    : [],
+));
+if (rowsById.size !== marketHomeIds.length || marketHomeIds.some(id => !rowsById.has(id))) {
+  throw new Error('Current housing registry differs from the 17-house JX-1 roster.');
+}
+
+let selected = marketHomeIds[0];
+let activeRoom: ReturnType<typeof buildMarketHomeInterior> | undefined;
+let stage = exterior;
+let angle: Angle = 'street';
+let walking = false;
+let viewportWidth = 0;
+let viewportHeight = 0;
+const headings = { north: [0, -1], east: [1, 0], south: [0, 1], west: [-1, 0] } as const;
+const clearStreetCameras: Partial<Record<string, readonly [number, number]>> = {
+  'old-town:158:184': [166, 141.095],
+  'old-town:173:135': [163.155, 145.5],
+};
+
+function draw() {
+  const width = viewport.clientWidth, height = viewport.clientHeight;
+  if (width <= 0 || height <= 0) return;
+  if (width !== viewportWidth || height !== viewportHeight) {
+    viewportWidth = width;
+    viewportHeight = height;
+    camera.aspect = width / height;
+    camera.updateProjectionMatrix();
+    renderer.setSize(width, height, false);
+  }
+  renderer.render(stage, camera);
+}
+
+function cameraAt(point: Point, eye: number, direction: Point, pitch = 0) {
+  camera.position.set(point.x, eye, point.z);
+  camera.lookAt(point.x + direction.x, eye + pitch, point.z + direction.z);
+  draw();
+}
+
+function room() {
+  if (!activeRoom) {
+    const { site } = rowsById.get(selected)!;
+    activeRoom = buildMarketHomeInterior(selected, site.w, site.d);
+    interior.add(activeRoom.group);
+  }
+  return activeRoom;
+}
+
+function capture(next: Angle) {
+  angle = next;
+  if (next === 'interior') {
+    const { halfDepth } = room();
+    stage = interior;
+    cameraAt({ x: 0, z: halfDepth - .48 }, 1.63, { x: 0, z: -1 }, -.10);
+    return;
+  }
+  stage = exterior;
+  const { portal, site } = rowsById.get(selected)!;
+  const base = grid.heightAt(site.x, site.n);
+  if (next === 'street') {
+    const [east, north] = clearStreetCameras[selected] ?? [
+      portal.x + 10 * Math.sin(portal.exitYaw), portal.n + 10 * Math.cos(portal.exitYaw),
+    ];
+    camera.position.set(east, grid.heightAt(east, north) + 2.05, -north);
+  } else {
+    const [dx, dz] = headings[next];
+    const radius = Math.max(site.w, site.d) * 1.32 + 5;
+    // Lift the camera on the same bearing where a neighboring roof masks the house.
+    let rise = .62;
+    if (selected === 'old-town:158:184' && (next === 'north' || next === 'east')) rise = 1;
+    if (selected === 'old-town:179:155' && next === 'east') rise = .8;
+    camera.position.set(site.x + radius * dx, base + radius * rise, -site.n + radius * dz);
+  }
+  camera.lookAt(site.x, base + 3, -site.n);
+  draw();
+}
+
+function select(id: string) {
+  if (walking) throw new Error('Finish the current walk before changing houses.');
+  if (!rowsById.has(id)) throw new RangeError('Unknown market door.');
+  selected = id as typeof selected;
+  activeRoom?.dispose();
+  activeRoom = undefined;
+  picker.value = id;
+  status.textContent = id;
+  capture('street');
+}
+
+function stats() {
+  return {
+    draws: renderer.info.render.calls,
+    triangles: renderer.info.render.triangles,
+    camera: camera.position.toArray(),
+    angle,
+  };
+}
+
+function snapshot() {
+  const { portal, site, card } = rowsById.get(selected)!;
+  const current = room();
+  return {
+    id: selected, portal, footprint: [site.w, site.d], lot: [site.x, site.n], card,
+    room: { width: current.halfWidth * 2, depth: current.halfDepth * 2,
+      theme: current.theme, categories: current.categories, accent: current.accent },
+    current: stats(),
+  };
+}
+
+const nextFrame = () => new Promise<void>(resolve => requestAnimationFrame(() => resolve()));
+
+async function walk() {
+  if (walking) throw new Error('A house walk is already running.');
+  walking = true;
+  walkButton.disabled = true;
+  picker.disabled = true;
+  const { portal } = rowsById.get(selected)!;
+  const current = room();
+  const original = { x: portal.x, z: -portal.n };
+  const indoorRoute = marketHomeWalkRoute(current.halfWidth, current.halfDepth);
+  const phases: { name: string; steps: number; from: Point; to: Point }[] = [];
+  const isExteriorFree = ({ x, z }: Point) => canEnter(x, -z) && !isWater(x, -z) &&
+    !district.blocked(x, -z) && !scenery.blocked(x, -z);
+  function isInteriorFree({ x, z }: Point) {
+    return canStandInMarketHome(x, z, current.colliders, current.halfWidth, current.halfDepth);
+  }
+
+  async function pass(name: string, points: Point[], canStand: (point: Point) => boolean, eyeAt: (point: Point) => number) {
+    let steps = 0;
+    const viewing = new Vector3();
+    for (let i = 1; i < points.length; i++) {
+      const start = points[i - 1], end = points[i];
+      const distance = Math.hypot(end.x - start.x, end.z - start.z);
+      if (!distance) continue;
+      viewing.set((end.x - start.x) / distance, 0, (end.z - start.z) / distance);
+      const count = Math.ceil(distance / .075);
+      for (let step = 0; step <= count; step++) {
+        const t = step / count;
+        const point = { x: start.x + (end.x - start.x) * t, z: start.z + (end.z - start.z) * t };
+        if (!canStand(point)) throw new Error(`Blocked at ${name} x=${point.x.toFixed(3)} z=${point.z.toFixed(3)}`);
+        steps++;
+        if (step % 9 === 0 || step === count) {
+          await nextFrame();
+          cameraAt(point, eyeAt(point), viewing);
+        }
+      }
+    }
+    phases.push({ name, steps, from: points[0], to: points[points.length - 1] });
+  }
+
+  try {
+    // Surveyed A-02 road approaches on commit 352aa49, compressed along straight segments.
+    const approachRoute = streetRoutes[selected].map(([east, north]) => ({ x: east, z: -north }));
+    const end = approachRoute.at(-1)!;
+    if (Math.hypot(end.x - original.x, end.z - original.z) >= .001) {
+      throw new Error('The surveyed approach no longer matches its door.');
+    }
+    approachRoute[approachRoute.length - 1] = original;
+    const approach = approachRoute.slice(1).reduce((sum, next, index) =>
+      sum + Math.hypot(next.x - approachRoute[index].x, next.z - approachRoute[index].z), 0);
+    stage = exterior;
+    const outsideEye = (point: Point) => grid.heightAt(point.x, -point.z) + 1.63;
+    await pass('street-to-door', approachRoute, isExteriorFree, outsideEye);
+    stage = interior;
+    await pass('inside-loop', indoorRoute, isInteriorFree, () => 1.63);
+    stage = exterior;
+    await pass('same-door-to-street', [...approachRoute].reverse(), isExteriorFree, outsideEye);
+    status.textContent = `${selected} · 街至门 ${approach.toFixed(2)} m · 绕行室内并原门返回街面`;
+    return { ok: true, id: selected, approach, phases, sameDoor: portal.id };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    status.textContent = message;
+    return { ok: false, id: selected, phases, error: message };
+  } finally {
+    walking = false;
+    walkButton.disabled = false;
+    picker.disabled = false;
+  }
+}
+
+for (const id of marketHomeIds) picker.add(new Option(id, id));
+picker.addEventListener('change', () => select(picker.value));
+for (const element of document.querySelectorAll<HTMLButtonElement>('[data-camera]')) {
+  element.addEventListener('click', () => {
+    if (!walking) capture(element.dataset.camera as Angle);
+  });
+}
+walkButton.addEventListener('click', () => { if (!walking) void walk(); });
+const resize = new ResizeObserver(draw);
+resize.observe(viewport);
+window.addEventListener('pagehide', event => {
+  if (event.persisted) return;
+  resize.disconnect();
+  activeRoom?.dispose();
+  renderer.dispose();
+});
+select(selected);
+Object.assign(window, { __marketHomesReview: { ids: marketHomeIds, select, capture, walk, stats, snapshot } });
diff --git a/tests/town-blockout-market-homes.test.ts b/tests/town-blockout-market-homes.test.ts
new file mode 100644
index 0000000..ad62cf1
--- /dev/null
+++ b/tests/town-blockout-market-homes.test.ts
@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, type InstancedMesh } from 'three';
+import { buildMarketHomeInterior, marketHomeIds } from '../tools/voxel-tavern/town-blockout/market-home-interior.ts';
+import { marketHomeWalkRoute, sampleMarketHomeWalk } from '../tools/voxel-tavern/town-blockout/market-home-walk.ts';
+
+test('the 17 original market doors have distinct furnished rooms and continuous local return loops', () => {
+  assert.equal(marketHomeIds.length, 17);
+  assert.equal(new Set(marketHomeIds).size, 17);
+  assert.throws(() => buildMarketHomeInterior('district:516:273', 10, 9), /outside the JX-1 roster/);
+  const signatures = new Set<string>();
+  for (const id of marketHomeIds) {
+    const room = buildMarketHomeInterior(id, 9.65, 9.4);
+    try {
+      assert.ok(room.categories.length >= 4, id);
+      const route = marketHomeWalkRoute(room.halfWidth, room.halfDepth);
+      assert.deepEqual(route[0], route.at(-1), id);
+      const sampled = sampleMarketHomeWalk(route, room.colliders, room.halfWidth, room.halfDepth);
+      assert.equal(sampled.blockedAt, undefined, id);
+      assert.ok(sampled.samples > 160, id);
+      signatures.add(JSON.stringify(room.colliders));
+    } finally {
+      room.dispose();
+    }
+  }
+  assert.equal(signatures.size, 17);
+});
+
+test('a selected market room releases its geometry and leaves other scenes mounted', () => {
+  const parent = new Group();
+  const other = new Group();
+  const room = buildMarketHomeInterior(marketHomeIds[0], 10, 9.8);
+  parent.add(other, room.group);
+  const batch = room.group.children.find((child): child is InstancedMesh =>
+    'isInstancedMesh' in child && child.isInstancedMesh === true);
+  assert.ok(batch);
+  let released = 0;
+  batch.geometry.addEventListener('dispose', () => released++);
+  room.dispose();
+  room.dispose();
+  assert.deepEqual(parent.children, [other]);
+  assert.equal(room.group.children.length, 0);
+  assert.equal(released, 1);
+});
