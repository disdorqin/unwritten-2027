+import type { Box } from './landmark-kit';
+
+export type MarketHomeTheme = 'tea-table' | 'pantry' | 'linen' | 'ceramics' | 'woodwork' | 'books';
+
+export type MarketHomeFurnishingProfile = {
+  theme: MarketHomeTheme;
+  arrangement: number;
+  halfWidth: number;
+  halfDepth: number;
+  accent: string;
+};
+
+export type MarketHomePiece = {
+  x: number;
+  y: number;
+  z: number;
+  width: number;
+  height: number;
+  depth: number;
+  color: string;
+};
+
+export type MarketHomeDetail = 'furniture' | 'utensils' | 'light' | 'textiles' | 'storage' | 'planter';
+
+const wood = '#704b39';
+const edge = '#b07b51';
+const dark = '#3d2f2d';
+const brass = '#d0a06a';
+const linen = '#ead5ae';
+const ember = '#ffc58a';
+
+type Desk = { height: number; depth: number; open: boolean };
+const desks = {
+  'tea-table': { height: .73, depth: 1.68, open: true },
+  pantry: { height: .92, depth: 1.94, open: false },
+  linen: { height: .81, depth: 2.10, open: true },
+  ceramics: { height: .87, depth: 1.80, open: false },
+  woodwork: { height: .94, depth: 2.18, open: true },
+  books: { height: .79, depth: 1.56, open: false },
+} satisfies Record<MarketHomeTheme, Desk>;
+
+/** Describes the fixtures in local room coordinates: floor y=0 and entrance at positive z. */
+export function buildMarketHomeFurnishings({ theme, arrangement, halfWidth, halfDepth, accent }: MarketHomeFurnishingProfile) {
+  const desk = desks[theme];
+  if (!desk || !Number.isInteger(arrangement) || arrangement < 0 || arrangement > 16 ||
+      !Number.isFinite(halfWidth) || !Number.isFinite(halfDepth) || halfWidth < 3.6 || halfDepth < 3.6) {
+    throw new RangeError('Market home furnishings need a registered theme, arrangement and room footprint.');
+  }
+
+  const solid: MarketHomePiece[] = [];
+  const glow: MarketHomePiece[] = [];
+  const colliders: Box[] = [];
+  const categories: MarketHomeDetail[] = ['furniture', 'utensils', 'light', 'textiles', 'storage', 'planter'];
+  function put(x: number, y: number, z: number, width: number, height: number, depth: number, color: string, lit = false) {
+    (lit ? glow : solid).push({ x, y, z, width, height, depth, color });
+  }
+  function block(x: number, z: number, width: number, height: number, depth: number) {
+    colliders.push({ min: [x - width / 2, 0, z - depth / 2], max: [x + width / 2, height, z + depth / 2] });
+  }
+
+  const side = arrangement % 2 ? 1 : -1;
+  const lane = Math.floor(arrangement / 2) % 3;
+  const deskX = side * (halfWidth - .79);
+  const deskZ = [-.42, -.10, .22][lane] * halfDepth;
+  const deskWidth = 1.02;
+  const deskDepth = desk.depth + (Math.floor(arrangement / 6) - 1) * .17;
+  const deskTop = desk.height;
+
+  put(deskX, deskTop - .10, deskZ, deskWidth, .10, deskDepth, edge);
+  if (desk.open) {
+    for (const dx of [-.37, .37]) {
+      for (const dz of [-deskDepth / 2 + .13, deskDepth / 2 - .13]) {
+        put(deskX + dx, 0, deskZ + dz, .13, deskTop - .10, .14, wood);
+      }
+    }
+    put(deskX + side * .24, .38, deskZ, .13, .12, deskDepth - .23, dark);
+  } else {
+    put(deskX, 0, deskZ, .88, deskTop - .10, deskDepth - .12, wood);
+    for (const dz of [-deskDepth / 4, deskDepth / 4]) {
+      put(deskX - side * .448, .19, deskZ + dz, .023, deskTop - .33, deskDepth / 2 - .13, dark);
+      put(deskX - side * .471, deskTop - .31, deskZ + dz, .039, .06, .16, brass);
+    }
+  }
+  block(deskX, deskZ, deskWidth, deskTop, deskDepth);
+
+  function jar(x: number, y: number, z: number, width: number, height: number, glaze: string) {
+    put(x, y, z, width * .77, height, width, glaze);
+    put(x, y + height * .15, z, width, height * .64, width * .76, glaze);
+    put(x, y + height, z, width * .58, .055, width * .58, edge);
+  }
+  const propX = deskX + side * .10;
+  if (theme === 'tea-table') {
+    put(propX, deskTop, deskZ, .57, .042, .77, dark);
+    jar(propX + side * .07, deskTop + .042, deskZ - .18, .29, .21, '#a45f4c');
+    for (const dz of [.06, .24]) jar(propX - side * .12, deskTop + .042, deskZ + dz, .13, .13, linen);
+  } else if (theme === 'pantry') {
+    for (const [dz, height] of [[-.50, .31], [0, .22], [.44, .36]]) {
+      put(propX, deskTop, deskZ + dz, .52, height, .34, wood);
+      put(propX - side * .27, deskTop + height - .07, deskZ + dz, .035, .047, .21, brass);
+    }
+  } else if (theme === 'linen') {
+    for (const [dz, y, color] of [[-.36, 0, linen], [-.29, .09, accent], [.23, 0, '#987068']] as const) {
+      put(propX, deskTop + y, deskZ + dz, .56, .085, .39, color);
+      put(propX - side * .21, deskTop + y + .085, deskZ + dz, .085, .017, .37, dark);
+    }
+  } else if (theme === 'ceramics') {
+    jar(propX + side * .08, deskTop, deskZ - .39, .31, .35, '#7a9093');
+    jar(propX - side * .14, deskTop, deskZ + .03, .26, .25, linen);
+    jar(propX + side * .02, deskTop, deskZ + .39, .34, .29, accent);
+  } else if (theme === 'woodwork') {
+    for (const [dx, y, depth] of [[-.15, 0, .87], [.11, 0, .70], [0, .09, .55]]) {
+      put(propX + dx, deskTop + y, deskZ - .29, .16, .081, depth, edge);
+    }
+    put(propX - side * .17, deskTop, deskZ + .53, .20, .09, .43, dark);
+    put(propX + side * .01, deskTop + .09, deskZ + .53, .30, .07, .10, brass);
+  } else {
+    for (let i = 0; i < 4; i++) {
+      put(propX + side * .12, deskTop, deskZ - .42 + i * .092, .28, .24 + i % 3 * .058, .077,
+        [accent, '#52616c', '#8d704f'][i % 3]);
+    }
+    put(propX - side * .17, deskTop, deskZ + .30, .43, .048, .34, linen);
+    put(propX - side * .17, deskTop + .052, deskZ + .30, .028, .071, .35, dark);
+  }
+
+  const bedX = -side * (halfWidth - .96);
+  const bedZ = -halfDepth + 1.58 + (arrangement % 3) * .23;
+  const bedDepth = 2.20 + (arrangement % 4) * .12;
+  put(bedX, 0, bedZ, 1.33, .35, bedDepth, wood);
+  put(bedX, .35, bedZ, 1.23, .20, bedDepth - .15, linen);
+  put(bedX, .55, bedZ + .26, 1.25, .087, bedDepth - .68, accent);
+  for (const dz of [.19, .45]) put(bedX, .637, bedZ + dz, 1.18, .015, .10, '#d5a781');
+  put(bedX, .55, bedZ - bedDepth / 2 + .37, .81, .16, .45, '#f1dfbe');
+  put(bedX, 0, bedZ - bedDepth / 2, 1.37, .89, .13, dark);
+  block(bedX, bedZ - .03, 1.37, .89, bedDepth + .12);
+
+  const shelfX = -side * (halfWidth - .60);
+  const shelfZ = halfDepth * (.37 + (arrangement % 3) * .062);
+  const shelfDepth = 1.25 + (arrangement % 3) * .125;
+  put(shelfX, 0, shelfZ, .72, .94, shelfDepth, wood);
+  put(shelfX, .94, shelfZ, .80, .083, shelfDepth + .06, edge);
+  for (const dz of [-.31, .31]) {
+    put(shelfX + side * .364, .22, shelfZ + dz, .030, .47, .52, dark);
+    put(shelfX + side * .389, .53, shelfZ + dz, .050, .051, .16, brass);
+  }
+  jar(shelfX, 1.023, shelfZ - .28, .25, .23, '#a97660');
+  put(shelfX + side * .16, 1.127, shelfZ - .28, .10, .099, .052, '#875944');
+  put(shelfX, 1.023, shelfZ + .23, .47, .047, .31, linen);
+  block(shelfX, shelfZ, .80, 1.03, shelfDepth + .06);
+
+  const lampZ = halfDepth * (.62 + (arrangement % 2) * .08);
+  const lampX = side * (halfWidth - .24);
+  put(lampX, 1.77, lampZ, .30, .098, .28, dark);
+  put(lampX - side * .10, 1.86, lampZ, .21, .27, .21, ember, true);
+  put(lampX - side * .10, 2.13, lampZ, .27, .061, .27, brass);
+  for (const dz of [-.10, .10]) put(lampX - side * .215, 1.84, lampZ + dz, .033, .30, .029, wood);
+
+  const plantX = -side * (halfWidth - .51);
+  const plantZ = halfDepth - .48;
+  jar(plantX, 0, plantZ, .39, .27, '#996951');
+  put(plantX, .31, plantZ, .060, .36, .061, '#5a6652');
+  for (const [dx, h, dz] of [[-.104, .39, -.06], [.09, .52, .08], [.06, .61, -.11]]) {
+    put(plantX + dx, h, plantZ + dz, .23, .092, .17, '#7e8c64');
+  }
+  block(plantX, plantZ, .44, .40, .44);
+
+  const rugZ = halfDepth * .25 + (arrangement % 5) * .14;
+  const rugDepth = 1.47 + (arrangement % 4) * .13;
+  put(0, .003, rugZ, 1.65, .015, rugDepth, accent);
+  for (const dx of [-.72, .72]) put(dx, .018, rugZ, .064, .005, rugDepth, '#bf9270');
+
+  return { solid, glow, colliders, categories };
+}
diff --git a/tools/voxel-tavern/town-blockout/market-home-interior.ts b/tools/voxel-tavern/town-blockout/market-home-interior.ts
