@@ -0,0 +1,59 @@
+import type { Box } from './landmark-kit';
+
+export type MarketHomeWalkPoint = { x: number; z: number };
+
+const bodyRadius = .27;
+const bodyHeight = 1.8;
+const surfaceEpsilon = .025;
+const sampleSpacing = .08;
+
+/** Local ground is y = 0 and the front wall is at positive z. */
+export function canStandInMarketHome(
+  x: number, z: number, colliders: readonly Box[], halfWidth: number, halfDepth: number,
+) {
+  if (!Number.isFinite(x) || !Number.isFinite(z) || !Number.isFinite(halfWidth) || !Number.isFinite(halfDepth) ||
+    Math.abs(x) + bodyRadius > halfWidth || Math.abs(z) + bodyRadius > halfDepth) return false;
+  return !colliders.some(({ min, max }) => {
+    if (max[1] <= surfaceEpsilon || min[1] >= bodyHeight - surfaceEpsilon) return false;
+    const dx = Math.max(min[0] - x, x - max[0], 0);
+    const dz = Math.max(min[2] - z, z - max[2], 0);
+    return dx * dx + dz * dz < bodyRadius * bodyRadius;
+  });
+}
+
+/** Inward, across the rear of the clear aisle, then back to the room's front. */
+export function marketHomeWalkRoute(halfWidth: number, halfDepth: number): MarketHomeWalkPoint[] {
+  if (!Number.isFinite(halfWidth) || halfWidth < 1 || !Number.isFinite(halfDepth) || halfDepth < 1) {
+    throw new RangeError('A market home needs room for its entrance and interior walk.');
+  }
+  const front = halfDepth - .55;
+  const rear = -halfDepth + .85;
+  const side = Math.min(.65, halfWidth - bodyRadius);
+  return [
+    { x: 0, z: front }, { x: 0, z: 0 }, { x: side, z: rear },
+    { x: -side, z: rear }, { x: 0, z: 0 }, { x: 0, z: front },
+  ];
+}
+
+export function sampleMarketHomeWalk(
+  points: readonly MarketHomeWalkPoint[], colliders: readonly Box[], halfWidth: number, halfDepth: number,
+): { samples: number; blockedAt?: MarketHomeWalkPoint } {
+  if (points.length === 0) throw new RangeError('A market home walk needs at least one point.');
+  let samples = 0;
+  for (const [index, to] of points.entries()) {
+    if (!canStandInMarketHome(to.x, to.z, colliders, halfWidth, halfDepth)) return { samples, blockedAt: to };
+    if (index === 0) {
+      samples++;
+      continue;
+    }
+    const from = points[index - 1];
+    const dx = to.x - from.x, dz = to.z - from.z;
+    const steps = Math.ceil(Math.hypot(dx, dz) / sampleSpacing);
+    for (let step = 1; step <= steps; step++) {
+      const x = from.x + dx * step / steps, z = from.z + dz * step / steps;
+      if (!canStandInMarketHome(x, z, colliders, halfWidth, halfDepth)) return { samples, blockedAt: { x, z } };
+      samples++;
+    }
+  }
+  return { samples };
+}
