+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  DataTexture, ShaderLib, type BoxGeometry, type InstancedBufferAttribute, type InstancedMesh,
+  type MeshBasicMaterial, type MeshLambertMaterial,
+} from 'three';
+import { buildMarketHomeInterior, marketHomeIds } from '../tools/voxel-tavern/town-blockout/market-home-interior.ts';
+
+test('all rooms use one host atlas with six fixture finishes and two drawing batches', () => {
+  const atlas = new DataTexture(new Uint8Array(108 * 18 * 4), 108, 18);
+  let disposed = false;
+  atlas.addEventListener('dispose', () => { disposed = true; });
+  const seen = new Set<number>();
+  for (const id of marketHomeIds) {
+    const room = buildMarketHomeInterior(id, 9.65, 9.4, undefined, atlas);
+    try {
+      assert.equal(room.group.children.length, 2, id);
+      const [solid, glow] = room.group.children as [InstancedMesh<BoxGeometry, MeshLambertMaterial>,
+        InstancedMesh<BoxGeometry, MeshBasicMaterial>];
+      assert.ok(solid.isInstancedMesh && glow.isInstancedMesh, id);
+      assert.ok(solid.material.isMeshLambertMaterial && glow.material.isMeshBasicMaterial, id);
+      assert.equal(solid.material.map, atlas, id);
+      assert.equal(glow.material.map, null, id);
+      const tiles = solid.geometry.getAttribute('marketHomeTile') as InstancedBufferAttribute;
+      assert.ok(tiles.isInstancedBufferAttribute, id);
+      assert.equal(tiles.count, solid.count, id);
+      for (const tile of tiles.array) seen.add(tile);
+      const shader = { vertexShader: ShaderLib.lambert.vertexShader } as Parameters<
+        typeof solid.material.onBeforeCompile
+      >[0];
+      solid.material.onBeforeCompile(shader, {} as Parameters<typeof solid.material.onBeforeCompile>[1]);
+      assert.match(shader.vertexShader, /attribute float marketHomeTile;/);
+      assert.match(shader.vertexShader, /vMapUv = tilePixel \/ vec2\(108\.0, 18\.0\)/);
+    } finally {
+      room.dispose();
+    }
+    assert.equal(disposed, false, id);
+  }
+  assert.deepEqual([...seen].sort((a, b) => a - b), [0, 1, 2, 3, 4, 5]);
+  atlas.dispose();
+  assert.equal(disposed, true);
+});
