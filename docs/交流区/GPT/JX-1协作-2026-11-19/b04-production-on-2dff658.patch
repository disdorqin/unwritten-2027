@@ -0,0 +1,210 @@
+import { BoxGeometry, Group, InstancedMesh, Matrix4, MeshLambertMaterial } from 'three';
+import type { Box, Ramp } from './landmark-kit';
+
+export type MarketHomePorchInput = {
+  east: number;
+  north: number;
+  angle: number;
+  foundationY: number;
+  entrance: { x: number; frontZ: number; width: number; height: number; floorY: number };
+  heightAt(east: number, north: number): number | undefined;
+  /** Reject foreign collision and protected surface footprints, excluding this home's legacy coarse blocker. */
+  blocked(east: number, north: number, radius: number): boolean;
+};
+
+export type MarketHomePorch = {
+  floors: Box[];
+  colliders: Box[];
+  ramps: Ramp[];
+  approach: { east: number; north: number; ground: number };
+  maximumStep: number;
+  minimumClearWidth: number;
+  minimumClearHeight: number;
+  leftClearance: number;
+  rightClearance: number;
+};
+
+const bodyRadius = .27;
+const bodyHeight = 1.8;
+const stepHeight = .43;
+const surfaceEpsilon = .025;
+const nominalRiser = .40;
+const treadDepth = .22;
+const railThickness = .08;
+const railHeight = .9;
+const originalStandDistance = 1.42;
+const standSeparation = .04;
+const maximumDepth = originalStandDistance - bodyRadius - standSeparation;
+const maximumTreads = Math.floor(maximumDepth / treadDepth);
+
+function overlaps(box: Box, east: number, z: number) {
+  const dx = Math.max(box.min[0] - east, east - box.max[0], 0);
+  const dz = Math.max(box.min[2] - z, z - box.max[2], 0);
+  return dx ** 2 + dz ** 2 < bodyRadius ** 2;
+}
+
+function checkPath(
+  supports: readonly Box[], walls: readonly Box[], first: number, last: number, firstY: number,
+  sample: (position: number) => { east: number; north: number; height: number | undefined },
+  stride: number,
+) {
+  const segments = Math.ceil(Math.abs(last - first) / stride);
+  let previous = firstY;
+  let maximumStep = 0;
+  for (let index = 0; index <= segments; index++) {
+    const { east, north, height } = sample(first + (last - first) * index / segments);
+    if (height === undefined || !Number.isFinite(height)) return;
+    const z = -north;
+    let next = height;
+    for (const support of supports) {
+      if (support.max[1] <= previous + stepHeight && overlaps(support, east, z)) {
+        next = Math.max(next, support.max[1]);
+      }
+    }
+    for (const wall of walls) {
+      if (wall.max[1] <= previous + .03 && overlaps(wall, east, z)) next = Math.max(next, wall.max[1]);
+    }
+    const blocks = (box: Box) => next + surfaceEpsilon < box.max[1] &&
+      next + bodyHeight - surfaceEpsilon > box.min[1] && overlaps(box, east, z);
+    const change = Math.abs(next - previous);
+    if (change > stepHeight || supports.some(blocks) || walls.some(blocks)) return;
+    maximumStep = Math.max(maximumStep, change);
+    previous = next;
+  }
+  return { maximumStep, end: previous };
+}
+
+export function planMarketHomePorch(input: MarketHomePorchInput): MarketHomePorch | undefined {
+  const { east, north, angle, foundationY, entrance, heightAt, blocked } = input;
+  const { x, frontZ, width, height, floorY } = entrance;
+  if (![east, north, angle, foundationY, x, frontZ, width, height, floorY].every(Number.isFinite)) return;
+  const clearWidth = width - 2 * railThickness;
+  const sideClearance = clearWidth / 2 - bodyRadius;
+  if (sideClearance <= surfaceEpsilon || height - bodyHeight <= surfaceEpsilon) return;
+  // Old-town house axes are cardinal. An AABB must not fill a diagonal doorway.
+  const quarterTurns = Math.round(angle / (Math.PI / 2));
+  if (Math.abs(angle - quarterTurns * Math.PI / 2) > 1e-6) return;
+  const sin = Math.round(Math.sin(quarterTurns * Math.PI / 2));
+  const cos = Math.round(Math.cos(quarterTurns * Math.PI / 2));
+  const halfWidth = width / 2;
+  const thresholdY = foundationY + floorY;
+  const approachZ = frontZ + originalStandDistance;
+  const interiorZ = frontZ - bodyRadius - .02;
+  const toWorld = (localX: number, localZ: number) => ({
+    east: east + cos * localX + sin * localZ,
+    north: north + sin * localX - cos * localZ,
+  });
+  const coordHeight = (localX: number, localZ: number) => {
+    const world = toWorld(localX, localZ);
+    return heightAt(world.east, world.north);
+  };
+  const approachWorld = toWorld(x, approachZ);
+  const ground = heightAt(approachWorld.east, approachWorld.north);
+  if (ground === undefined || !Number.isFinite(ground) || blocked(approachWorld.east, approachWorld.north, bodyRadius)) return;
+  const approach = { ...approachWorld, ground };
+
+  function box(left: number, right: number, inner: number, outer: number, bottom: number, top: number): Box {
+    const a = toWorld(left, inner);
+    const b = toWorld(right, outer);
+    return {
+      min: [Math.min(a.east, b.east), bottom, -Math.max(a.north, b.north)],
+      max: [Math.max(a.east, b.east), top, -Math.min(a.north, b.north)],
+    };
+  }
+
+  function terrainBounds(inner: number, outer: number) {
+    const lateralSamples = Math.ceil(width / .15);
+    const depthSamples = Math.ceil((outer - inner) / .15);
+    let min = Infinity;
+    let max = -Infinity;
+    for (let col = 0; col <= lateralSamples; col++) {
+      const localX = x - halfWidth + width * col / lateralSamples;
+      for (let row = 0; row <= depthSamples; row++) {
+        const point = toWorld(localX, inner + (outer - inner) * row / depthSamples);
+        if (blocked(point.east, point.north, .12)) return;
+        const height = heightAt(point.east, point.north);
+        if (height === undefined || !Number.isFinite(height)) return;
+        min = Math.min(min, height);
+        max = Math.max(max, height);
+      }
+    }
+    return { min, max };
+  }
+
+  // Supports meet the real room floor at its threshold. This probe-only
+  // continuation is not registered as a second interior floor.
+  const threshold = box(x - halfWidth, x + halfWidth, interiorZ - .30, frontZ, thresholdY - .08, thresholdY);
+  for (let count = 1; count <= maximumTreads; count++) {
+    const outside = frontZ + count * treadDepth;
+    const bottomReference = coordHeight(x, Math.min(approachZ, outside + bodyRadius + surfaceEpsilon));
+    if (bottomReference === undefined || !Number.isFinite(bottomReference)) continue;
+    const rise = (thresholdY - bottomReference) / count;
+    if (rise < 0 || rise > nominalRiser) continue;
+
+    const floors: Box[] = [];
+    const colliders: Box[] = [];
+    for (let index = 0; index < count; index++) {
+      const inner = frontZ + index * treadDepth;
+      const outer = inner + treadDepth;
+      const top = thresholdY - index * rise;
+      const terrain = terrainBounds(inner, outer);
+      if (!terrain || terrain.max > top - surfaceEpsilon) break;
+      const bottom = terrain.min - .08;
+      floors.push(box(x - halfWidth, x + halfWidth, inner, outer, bottom, top));
+      colliders.push(
+        box(x - halfWidth, x - halfWidth + railThickness, inner, outer, bottom, top + railHeight),
+        box(x + halfWidth - railThickness, x + halfWidth, inner, outer, bottom, top + railHeight),
+      );
+    }
+    if (floors.length !== count) continue;
+    if ([...floors, ...colliders].some(solid => overlaps(solid, approach.east, -approach.north))) continue;
+
+    const support = [...floors, threshold];
+    let maximumStep = 0;
+    let viable = true;
+    for (const lateral of [0, -sideClearance / 2, sideClearance / 2]) {
+      const sample = (position: number) => {
+        const world = toWorld(x + lateral, position);
+        return { ...world, height: heightAt(world.east, world.north) };
+      };
+      const firstY = sample(approachZ).height;
+      if (firstY === undefined) { viable = false; break; }
+      // Include a dense sweep and a displacement near the production 60 Hz sprint cap.
+      for (const stride of [.025, 11.3 / 60]) {
+        const inward = checkPath(support, colliders, approachZ, interiorZ, firstY, sample, stride);
+        const outward = checkPath(support, colliders, interiorZ, approachZ, thresholdY, sample, stride);
+        if (!inward || !outward || Math.abs(inward.end - thresholdY) > surfaceEpsilon ||
+            Math.abs(outward.end - firstY) > surfaceEpsilon) {
+          viable = false;
+          break;
+        }
+        maximumStep = Math.max(maximumStep, inward.maximumStep, outward.maximumStep);
+      }
+      if (!viable) break;
+    }
+    if (viable) return {
+      floors, colliders, ramps: [], approach, maximumStep,
+      minimumClearWidth: clearWidth, minimumClearHeight: height,
+      leftClearance: sideClearance, rightClearance: sideClearance,
+    };
+  }
+}
+
+export function buildMarketHomePorch(plan: MarketHomePorch): Group {
+  const group = new Group();
+  group.name = 'Market home porch';
+  const geometry = new BoxGeometry();
+  function batch(boxes: readonly Box[], color: string) {
+    const mesh = new InstancedMesh(geometry, new MeshLambertMaterial({ color }), boxes.length);
+    const transform = new Matrix4();
+    boxes.forEach(({ min, max }, index) => {
+      transform.makeScale(max[0] - min[0], max[1] - min[1], max[2] - min[2]);
+      transform.setPosition((min[0] + max[0]) / 2, (min[1] + max[1]) / 2, (min[2] + max[2]) / 2);
+      mesh.setMatrixAt(index, transform);
+    });
+    mesh.computeBoundingSphere();
+    return mesh;
+  }
+  group.add(batch(plan.floors, '#806c63'), batch(plan.colliders, '#685a56'));
+  return group;
+}
diff --git a/tools/voxel-tavern/town-blockout/market-home-walk.ts b/tools/voxel-tavern/town-blockout/market-home-walk.ts
