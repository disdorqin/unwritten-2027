+  const shelfDepth = 1.25 + (arrangement % 3) * .125;
+  put(shelfX, 0, shelfZ, .72, .94, shelfDepth, wood);
+  put(shelfX, .94, shelfZ, .80, .083, shelfDepth + .06, edge);
+  for (const dz of [-.31, .31]) {
