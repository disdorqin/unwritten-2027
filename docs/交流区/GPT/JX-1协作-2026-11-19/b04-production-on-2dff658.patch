@@ -0,0 +1,159 @@
+import type { Box } from './landmark-kit';
+import type { MarketHomePorch, MarketHomePorchInput } from './market-home-porch';
+
+type Point = { east: number; north: number };
+type Waypoint = Point & { ground: number };
+export type MarketHomeLateralPorch = MarketHomePorch & { side: -1 | 1; route: Waypoint[] };
+
+const radius = .27;
+const bodyHeight = 1.8;
+const stepHeight = .43;
+const epsilon = .025;
+const railWidth = .07;
+const treadDepth = .24;
+const insideEdge = .16;
+const outsideEdge = 1.10;
+const stairLine = (insideEdge + outsideEdge) / 2;
+const originalStand = 1.42;
+
+function overlaps(box: Box, { east, north }: Point) {
+  const dx = Math.max(box.min[0] - east, east - box.max[0], 0);
+  const dz = Math.max(box.min[2] + north, -north - box.max[2], 0);
+  return dx * dx + dz * dz < radius * radius;
+}
+
+function audit(
+  input: MarketHomePorchInput, supports: readonly Box[], walls: readonly Box[], exterior: readonly Box[], route: readonly Point[],
+  start: number, finish: number, stride: number,
+) {
+  let feet = start;
+  let maxStep = 0;
+  let minHeadroom = Infinity;
+  const waypoints: Waypoint[] = [{ ...route[0], ground: start }];
+  for (let i = 1; i < route.length; i++) {
+    const a = route[i - 1];
+    const b = route[i];
+    const cuts = Math.ceil(Math.hypot(b.east - a.east, b.north - a.north) / stride);
+    for (let j = 1; j <= cuts; j++) {
+      const point = { east: a.east + (b.east - a.east) * j / cuts, north: a.north + (b.north - a.north) * j / cuts };
+      const height = input.heightAt(point.east, point.north);
+      if (height === undefined || !Number.isFinite(height) || input.blocked(point.east, point.north, radius)) return;
+      let next = height;
+      for (const box of supports) {
+        if (box.max[1] <= feet + stepHeight && overlaps(box, point)) next = Math.max(next, box.max[1]);
+      }
+      for (const box of walls) {
+        if (box.max[1] <= feet + .03 && overlaps(box, point)) next = Math.max(next, box.max[1]);
+      }
+      const hits = (box: Box) => next + epsilon < box.max[1] && next + bodyHeight - epsilon > box.min[1] && overlaps(box, point);
+      const change = Math.abs(next - feet);
+      if (change > stepHeight || supports.some(hits) || walls.some(hits) || exterior.some(hits)) return;
+      for (const box of exterior) {
+        if (box.min[1] >= next + bodyHeight - epsilon && overlaps(box, point)) {
+          minHeadroom = Math.min(minHeadroom, box.min[1] - next);
+        }
+      }
+      maxStep = Math.max(maxStep, change);
+      feet = next;
+    }
+    waypoints.push({ ...b, ground: feet });
+  }
+  if (Math.abs(feet - finish) > epsilon || minHeadroom <= bodyHeight + epsilon) return;
+  return { maxStep, minHeadroom, waypoints };
+}
+
+/**
+ * B-04 exceptional frontage. Call only for the surveyed high threshold after
+ * the straight porch has been rejected, and only after the exterior is cleared.
+ * The original B13 return point remains the first waypoint on raw terrain.
+ */
+export function planMarketHomeLateralPorch(
+  input: MarketHomePorchInput, exteriorCollision: readonly Box[],
+): MarketHomeLateralPorch | undefined {
+  const { east, north, angle, foundationY, entrance, heightAt, blocked } = input;
+  const { x, frontZ, width, height, floorY } = entrance;
+  const quarterTurns = Math.round(angle / (Math.PI / 2));
+  if (![east, north, angle, foundationY, x, frontZ, width, height, floorY].every(Number.isFinite) ||
+      Math.abs(angle - quarterTurns * Math.PI / 2) > 1e-6 || width < 1.25 || height < 1.85 ||
+      exteriorCollision.length === 0) return;
+  const sin = Math.round(Math.sin(angle));
+  const cos = Math.round(Math.cos(angle));
+  const halfWidth = width / 2;
+  const thresholdY = foundationY + floorY;
+  const clearance = (outsideEdge - insideEdge - 2 * railWidth) / 2 - radius;
+  for (const side of [1, -1] as const) {
+    function world(u: number, v: number): Point {
+      const localX = x + u * side;
+      const localZ = frontZ + v;
+      return { east: east + cos * localX + sin * localZ, north: north + sin * localX - cos * localZ };
+    }
+    function bounds(left: number, right: number, inner: number, outer: number, low: number, top: number): Box {
+      const a = world(left, inner);
+      const b = world(right, outer);
+      return { min: [Math.min(a.east, b.east), low, -Math.max(a.north, b.north)],
+        max: [Math.max(a.east, b.east), top, -Math.min(a.north, b.north)] };
+    }
+    function floorBox(left: number, right: number, inner: number, outer: number, top: number): Box | undefined {
+      let low = Infinity;
+      for (let a = 0; a <= 10; a++) {
+        for (let b = 0; b <= 10; b++) {
+          const point = world(left + (right - left) * a / 10, inner + (outer - inner) * b / 10);
+          const raw = heightAt(point.east, point.north);
+          if (raw === undefined || !Number.isFinite(raw) || raw > top - epsilon || blocked(point.east, point.north, .12)) return;
+          low = Math.min(low, raw);
+        }
+      }
+      return bounds(left, right, inner, outer, low - .08, top);
+    }
+    const approachPoint = world(0, originalStand);
+    const ground = heightAt(approachPoint.east, approachPoint.north);
+    if (ground === undefined || !Number.isFinite(ground) || blocked(approachPoint.east, approachPoint.north, radius)) continue;
+    const approach = { ...approachPoint, ground };
+    const landing = floorBox(-halfWidth, halfWidth, 0, outsideEdge, thresholdY);
+    if (!landing) continue;
+    const floor = bounds(-halfWidth, halfWidth, -.58, 0, thresholdY - .08, thresholdY);
+    const landingRail = (left: number, right: number, inner: number, outer: number) =>
+      bounds(left, right, inner, outer, landing.min[1], thresholdY + .9);
+    for (const count of [6, 7, 8]) {
+      const foot = halfWidth + count * treadDepth + radius + .05;
+      const lowPoint = world(foot, stairLine);
+      const low = heightAt(lowPoint.east, lowPoint.north);
+      if (low === undefined || !Number.isFinite(low)) continue;
+      const riser = (thresholdY - low) / (count + 1);
+      if (riser <= 0 || riser > .40) continue;
+      const floors = [landing];
+      const colliders = [
+        landingRail(-halfWidth, halfWidth, outsideEdge - railWidth, outsideEdge),
+        landingRail(-halfWidth, -halfWidth + railWidth, 0, outsideEdge),
+      ];
+      for (let index = 0; index < count; index++) {
+        const left = halfWidth + index * treadDepth;
+        const right = left + treadDepth;
+        const top = thresholdY - (index + 1) * riser;
+        const stair = floorBox(left, right, insideEdge, outsideEdge, top);
+        if (!stair) break;
+        floors.push(stair);
+        colliders.push(
+          bounds(left, right, insideEdge, insideEdge + railWidth, stair.min[1], top + .9),
+          bounds(left, right, outsideEdge - railWidth, outsideEdge, stair.min[1], top + .9),
+        );
+      }
+      if (floors.length !== count + 1 || [...floors, ...colliders].some(box => overlaps(box, approachPoint))) continue;
+      const route = [approachPoint, world(foot, originalStand), lowPoint, world(0, stairLine), world(0, -radius - .02)];
+      const reverse = [...route].reverse();
+      const floorsForAudit = [...floors, floor];
+      const forward = audit(input, floorsForAudit, colliders, exteriorCollision, route, ground, thresholdY, .025);
+      const backward = audit(input, floorsForAudit, colliders, exteriorCollision, reverse, thresholdY, ground, .025);
+      const sprint = audit(input, floorsForAudit, colliders, exteriorCollision, route, ground, thresholdY, 11.3 / 60);
+      const reverseSprint = audit(input, floorsForAudit, colliders, exteriorCollision, reverse, thresholdY, ground, 11.3 / 60);
+      if (!forward || !backward || !sprint || !reverseSprint) continue;
+      return {
+        floors, colliders, ramps: [], approach, side, route: forward.waypoints,
+        maximumStep: Math.max(forward.maxStep, backward.maxStep, sprint.maxStep, reverseSprint.maxStep),
+        minimumClearWidth: 2 * (clearance + radius),
+        minimumClearHeight: Math.min(height, forward.minHeadroom, backward.minHeadroom, sprint.minHeadroom, reverseSprint.minHeadroom),
+        leftClearance: clearance, rightClearance: clearance,
+      };
+    }
+  }
+}
