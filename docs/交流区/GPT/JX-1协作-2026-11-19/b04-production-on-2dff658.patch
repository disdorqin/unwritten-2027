+++ b/tests/town-blockout-market-homes.test.ts
@@ -0,0 +1,78 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, Matrix4, type InstancedMesh } from 'three';
+import { buildDistrictHousing } from '../tools/voxel-tavern/town-blockout/district-housing.ts';
+import { buildMarketHomeInterior, marketHomeIds } from '../tools/voxel-tavern/town-blockout/market-home-interior.ts';
+import { canStandInMarketHome, marketHomeWalkRoute, sampleMarketHomeWalk } from '../tools/voxel-tavern/town-blockout/market-home-walk.ts';
+
+test('the 17 original market doors have distinct furnished rooms and continuous local return loops', () => {
+  assert.equal(marketHomeIds.length, 17);
+  assert.equal(new Set(marketHomeIds).size, 17);
+  assert.throws(() => buildMarketHomeInterior('district:516:273', 10, 9), /outside the JX-1 roster/);
+  const signatures = new Set<string>();
+  for (const id of marketHomeIds) {
+    const room = buildMarketHomeInterior(id, 9.65, 9.4);
+    try {
+      assert.ok(room.categories.length >= 4, id);
+      const route = marketHomeWalkRoute(room.halfWidth, room.halfDepth);
+      assert.deepEqual(route[0], route.at(-1), id);
+      const sampled = sampleMarketHomeWalk(route, room.colliders, room.halfWidth, room.halfDepth);
+      assert.equal(sampled.blockedAt, undefined, id);
+      assert.ok(sampled.samples > 160, id);
+      signatures.add(JSON.stringify(room.colliders));
+    } finally {
+      room.dispose();
+    }
+  }
+  assert.equal(signatures.size, 17);
+});
+
+test('the rear glazing matches the market shell and keeps the rear boundary closed', () => {
+  function glazing(mesh: InstancedMesh, wallZ: number) {
+    const matrix = new Matrix4();
+    const windows = [];
+    for (let index = 0; index < mesh.count; index++) {
+      mesh.getMatrixAt(index, matrix);
+      const { elements } = matrix;
+      if (Math.abs(elements[14] - wallZ) < 1e-5) {
+        windows.push([elements[12], elements[13], elements[0], elements[5]]);
+      }
+    }
+    return windows.sort(([left], [right]) => left - right);
+  }
+
+  // Narrowest and widest surveyed JX-1 shells.
+  for (const [width, depth] of [[9.2, 8.1], [15.5, 11.85]]) {
+    const shell = buildDistrictHousing('shop', width, depth, 137, 'market');
+    const room = buildMarketHomeInterior(marketHomeIds[0], width, depth);
+    try {
+      const outside = glazing(shell.children[1] as InstancedMesh, -depth / 2 - .17);
+      const inside = glazing(room.group.children[1] as InstancedMesh, -room.halfDepth);
+      assert.equal(outside.length, 2);
+      assert.deepEqual(inside, outside);
+      for (const [x] of inside) {
+        assert.equal(canStandInMarketHome(x, -room.halfDepth + .28, room.colliders,
+          room.halfWidth, room.halfDepth), false);
+      }
+    } finally {
+      room.dispose();
+    }
+  }
+});
+
+test('a selected market room releases its geometry and leaves other scenes mounted', () => {
+  const parent = new Group();
+  const other = new Group();
+  const room = buildMarketHomeInterior(marketHomeIds[0], 10, 9.8);
+  parent.add(other, room.group);
+  const batch = room.group.children.find((child): child is InstancedMesh =>
+    'isInstancedMesh' in child && child.isInstancedMesh === true);
+  assert.ok(batch);
+  let released = 0;
+  batch.geometry.addEventListener('dispose', () => released++);
+  room.dispose();
+  room.dispose();
+  assert.deepEqual(parent.children, [other]);
+  assert.equal(room.group.children.length, 0);
+  assert.equal(released, 1);
+});
