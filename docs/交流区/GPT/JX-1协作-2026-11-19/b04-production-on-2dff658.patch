+import {
+  BoxGeometry, Color, Group, InstancedMesh, MeshBasicMaterial, MeshLambertMaterial, Object3D, type Texture,
+} from 'three';
+import type { Box } from './landmark-kit';
+import { setMarketHomeAtlas, type MarketHomeFinish } from './market-home-atlas';
+import {
+  buildMarketHomeFurnishings, type MarketHomePiece, type MarketHomeTheme,
+} from './market-home-furnishings';
+
+const profiles = {
+  'old-town:137:168': ['tea-table', '#ad6651'],
+  'old-town:158:184': ['pantry', '#648272'],
+  'old-town:179:155': ['linen', '#705b80'],
+  'old-town:173:135': ['ceramics', '#597986'],
+  'old-town:156:141': ['woodwork', '#a68059'],
+  'old-town:94:100': ['books', '#8d634e'],
+  'old-town:137:70': ['linen', '#947253'],
+  'old-town:188:65': ['tea-table', '#5e7975'],
+  'old-town:217:66': ['pantry', '#a35c63'],
+  'old-town:234:74': ['books', '#5c757c'],
+  'old-town:186:104': ['woodwork', '#7b6a8c'],
+  'old-town:206:110': ['ceramics', '#708251'],
+  'old-town:228:110': ['linen', '#a36056'],
+  'old-town:246:114': ['pantry', '#9c7553'],
+  'old-town:246:135': ['tea-table', '#88759a'],
+  'old-town:220:138': ['ceramics', '#6f8372'],
+  'old-town:197:132': ['books', '#a66e56'],
+} as const satisfies Record<string, readonly [MarketHomeTheme, string]>;
+
+export const marketHomeIds = Object.keys(profiles) as (keyof typeof profiles)[];
+export const marketHomeDoorHalfWidth = .65;
+
+type MarketHomeWindowFinish = Readonly<{ tint: string; panes: 1 | 2 | 3 | 4 }>;
+const defaultWindowFinish: MarketHomeWindowFinish = { tint: '#ffc181', panes: 4 };
+
+export function buildMarketHomeInterior(
+  id: string,
+  width: number,
+  depth: number,
+  windowFinish = defaultWindowFinish,
+  atlas?: Texture,
+) {
+  if (!Object.hasOwn(profiles, id)) throw new RangeError('The door is outside the JX-1 roster.');
+  if (![width, depth].every(value => Number.isFinite(value) && value > 0)) {
+    throw new RangeError('Market homes need the surveyed shell dimensions.');
+  }
+  const homeId = id as keyof typeof profiles;
+  const [theme, accent] = profiles[homeId];
+  const arrangement = marketHomeIds.indexOf(homeId);
+  const halfWidth = Math.max(3.6, Math.min(5.3, width / 2 - .23));
+  const halfDepth = Math.max(3.6, Math.min(5.3, depth / 2 - .23));
+  const ceiling = 3.25 + (arrangement % 3) * .15;
+  const furniture = buildMarketHomeFurnishings({ theme, arrangement, halfWidth, halfDepth, accent });
+  const solid: MarketHomePiece[] = [...furniture.solid];
+  const glow: MarketHomePiece[] = [...furniture.glow];
+  const colliders: Box[] = [...furniture.colliders];
+  const floor = { min: [-halfWidth, -.17, -halfDepth], max: [halfWidth, 0, halfDepth] };
+  const beam = '#543b32';
+  const wall = '#c9ad83';
+  const trim = '#85624d';
+  const framing = .18;
+  const doorWidth = 2 * marketHomeDoorHalfWidth;
+  const doorHeight = 2.2;
+  function put(
+    x: number, y: number, z: number, width: number, height: number, depth: number,
+    color: string, finish: MarketHomeFinish = 'wood',
+  ) {
+    solid.push({ x, y, z, width, height, depth, color, finish });
+  }
+  function wallPart(x: number, y: number, z: number, width: number, height: number, depth: number, color = wall) {
+    put(x, y, z, width, height, depth, color, color === wall ? 'plaster' : 'wood');
+    colliders.push({
+      min: [x - width / 2, y, z - depth / 2],
+      max: [x + width / 2, y + height, z + depth / 2],
+    });
+  }
+
+  put(0, -.17, 0, halfWidth * 2, .15, halfDepth * 2, '#563f36');
+  const boards = ['#996746', '#8e5e41', '#aa7951', '#9e6e48'];
+  const plankCount = Math.ceil(2 * halfDepth / .47);
+  const plankDepth = 2 * halfDepth / plankCount;
+  for (let row = 0; row < plankCount; row++) {
+    const z = -halfDepth + (row + .5) * plankDepth;
+    const cut = (row % 4 - 1.5) * .38;
+    put((cut - halfWidth) / 2, -.02, z, halfWidth + cut, .02, plankDepth - .012, boards[(row + arrangement) % 4], 'plank');
+    put((cut + halfWidth) / 2, -.02, z, halfWidth - cut, .02, plankDepth - .012, boards[(row + arrangement + 1) % 4], 'plank');
+  }
+  for (const sign of [-1, 1]) {
+    wallPart(sign * (halfWidth + framing / 2), 0, 0, framing, ceiling, 2 * halfDepth + framing);
+    put(sign * (halfWidth - .034), .02, 0, .068, .28, 2 * halfDepth, trim);
+    const span = halfWidth - marketHomeDoorHalfWidth;
+    wallPart(sign * (marketHomeDoorHalfWidth + span / 2), 0, halfDepth, span, ceiling, framing);
+    put(sign * (marketHomeDoorHalfWidth + .055), 0, halfDepth - .12, .11, doorHeight + .12, .16, beam);
+  }
+  wallPart(0, doorHeight, halfDepth, doorWidth, ceiling - doorHeight, framing, beam);
+
+  // Match the rear pair in district-housing.ts themedFacing at the surveyed shell width.
+  const windowWidth = Math.min(1.7, width * .24);
+  const windowOffset = Math.min(width * .27, halfWidth - windowWidth / 2 - .18);
+  const windowY = 2;
+  const windowHeight = 1.36;
+  const windowBottom = windowY - windowHeight / 2;
+  const windowTop = windowY + windowHeight / 2;
+  const windowZ = -halfDepth;
+  function rearWallBetween(left: number, right: number) {
+    put((left + right) / 2, 0, windowZ, right - left, ceiling, framing, wall, 'plaster');
+  }
+
+  // Glazed openings are visual; the rear wall remains a closed player boundary.
+  colliders.push({
+    min: [-halfWidth, 0, windowZ - framing / 2],
+    max: [halfWidth, ceiling, windowZ + framing / 2],
+  });
+  let wallStart = -halfWidth;
+  for (const windowX of [-windowOffset, windowOffset]) {
+    const windowMin = windowX - windowWidth / 2;
+    const windowMax = windowX + windowWidth / 2;
+    rearWallBetween(wallStart, windowMin);
+    put(windowX, 0, windowZ, windowWidth, windowBottom, framing, wall, 'plaster');
+    put(windowX, windowTop, windowZ, windowWidth, ceiling - windowTop, framing, wall, 'plaster');
+    put(windowX, windowBottom - .19, windowZ + .07, windowWidth + .36, .14, .31, trim);
+    put(windowX, windowTop - .015, windowZ + .055, windowWidth + .18, .10, .18, beam);
+    glow.push({ x: windowX, y: windowBottom, z: windowZ, width: windowWidth,
+      height: windowHeight, depth: .035, color: windowFinish.tint });
+    for (let column = 0; column <= windowFinish.panes; column++) {
+      put(windowMin + column * windowWidth / windowFinish.panes, windowBottom - .025,
+        windowZ + .055, .065, windowHeight + .05, .11, beam);
+    }
+    if (windowFinish.panes > 1) put(windowX, windowY - .08, windowZ + .055, windowWidth, .083, .11, beam);
+    wallStart = windowMax;
+  }
+  rearWallBetween(wallStart, halfWidth);
+  put(0, ceiling, 0, halfWidth * 2 + .3, .16, halfDepth * 2 + .28, beam);
+  for (const z of [-halfDepth * .72, 0, halfDepth * .72]) {
+    put(0, ceiling - .21, z, halfWidth * 2, .24, .19, trim);
+  }
+  const group = new Group();
+  group.name = id;
+  const geometry = new BoxGeometry(1, 1, 1);
+  const wood = new MeshLambertMaterial();
+  const warmGlass = new MeshBasicMaterial();
+  let released = false;
+  function applyAtlas(texture: Texture) {
+    if (released) return;
+    setMarketHomeAtlas(geometry, wood, solid.map(({ finish }) => finish ?? 'wood'), texture);
+    wood.needsUpdate = true;
+  }
+  if (atlas) applyAtlas(atlas);
+  const instance = new Object3D();
+  const paint = new Color();
+  const warmTint = new Color(windowFinish.tint);
+  function batch(pieces: MarketHomePiece[], material: MeshLambertMaterial | MeshBasicMaterial, bakeWarmth: boolean) {
+    const mesh = new InstancedMesh(geometry, material, pieces.length);
+    pieces.forEach(({ x, y, z, width, height, depth, color }, index) => {
+      instance.position.set(x, y + height / 2, z);
+      instance.scale.set(width, height, depth);
+      instance.updateMatrix();
+      mesh.setMatrixAt(index, instance.matrix);
+      paint.set(color);
+      if (bakeWarmth) {
+        // Keep the window wash on the existing solid batch; moving or switching rooms changes no scene lights.
+        const distanceSquared = (Math.abs(x) - windowOffset) ** 2 + (y + height / 2 - windowY) ** 2 + (z - windowZ) ** 2;
+        paint.lerp(warmTint, .21 / (1 + distanceSquared * .28));
+      }
+      mesh.setColorAt(index, paint);
+    });
+    mesh.computeBoundingSphere();
+    group.add(mesh);
+    return mesh;
+  }
+  const batches = [batch(solid, wood, true), batch(glow, warmGlass, false)];
+  group.userData = { colliders, floors: [floor] };
+  return {
+    group, halfWidth, halfDepth, colliders, theme, categories: furniture.categories, accent, applyAtlas,
+    dispose() {
+      if (released) return;
+      released = true;
+      group.removeFromParent();
+      group.clear();
+      for (const mesh of batches) mesh.dispose();
+      geometry.dispose();
+      wood.dispose();
+      warmGlass.dispose();
+    },
+  };
+}
