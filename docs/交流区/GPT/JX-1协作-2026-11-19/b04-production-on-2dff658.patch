+++ b/tools/voxel-tavern/town-blockout/market-home-world-geometry.ts
@@ -0,0 +1,256 @@
+import type { Box, Ramp } from './landmark-kit';
+import { marketHomeDoorHalfWidth, type buildMarketHomeInterior } from './market-home-interior';
+import { sampleMarketHomeWalk } from './market-home-walk';
+
+type Interior = ReturnType<typeof buildMarketHomeInterior>;
+type Point = readonly [x: number, y: number, z: number];
+
+export type MarketHomePlacement = Readonly<{ x: number; n: number; level: number; angle: number }>;
+export type MarketHomeWalkGeometry = Readonly<{
+  colliders?: readonly Box[];
+  floors?: readonly Box[];
+  ramps?: readonly Ramp[];
+}>;
+export type MarketHomeLocalGeometry = MarketHomeWalkGeometry;
+type WorldGeometryOptions = Readonly<{
+  shell?: MarketHomeLocalGeometry;
+  porch?: MarketHomeLocalGeometry;
+  interiorPlacement?: Readonly<{ x?: number; y?: number; z?: number }>;
+}>;
+
+const bodyRadius = .27;
+const bodyHeight = 1.8;
+const stepHeight = .43;
+const surfaceEpsilon = .025;
+const sampleSpacing = .08;
+const comparisonEpsilon = 1e-9;
+const furnishingLabels = {
+  'tea-table': '查看茶桌', pantry: '查看储物台', linen: '查看布料台',
+  ceramics: '查看陶器台', woodwork: '查看木工台', books: '查看书桌',
+} satisfies Record<Interior['theme'], string>;
+
+function boxAt(box: Box, transform: (point: Point) => Point): Box {
+  const { min, max } = box;
+  if (min.length !== 3 || max.length !== 3 ||
+      min.some((value, axis) => !Number.isFinite(value) || !Number.isFinite(max[axis]) || max[axis] < value)) {
+    throw new RangeError('Market home walk geometry needs finite, ordered bounds.');
+  }
+  const a = transform([min[0], min[1], min[2]]);
+  const b = transform([max[0], max[1], max[2]]);
+  // All approved house rotations are quarter turns, so opposite corners suffice.
+  return { min: a.map((value, axis) => Math.min(value, b[axis])),
+    max: a.map((value, axis) => Math.max(value, b[axis])) };
+}
+
+function overlapsBody(x: number, z: number, { min, max }: Box) {
+  const dx = Math.max(min[0] - x, x - max[0], 0);
+  const dz = Math.max(min[2] - z, z - max[2], 0);
+  return dx * dx + dz * dz < bodyRadius * bodyRadius;
+}
+
+function worldFeet([x, ground, z]: Point) {
+  return { x, n: -z, ground };
+}
+
+export function createMarketHomeWorldGeometry(
+  interior: Interior, placement: MarketHomePlacement, options: WorldGeometryOptions = {},
+) {
+  const { x, n, level, angle } = placement;
+  const { x: roomX = 0, y: roomY = 0, z: roomZ = 0 } = options.interiorPlacement ?? {};
+  const quarterTurn = Math.PI / 2;
+  const turns = Math.round(angle / quarterTurn);
+  if (![x, n, level, angle, roomX, roomY, roomZ].every(Number.isFinite) ||
+      Math.abs(angle - turns * quarterTurn) > comparisonEpsilon) {
+    throw new RangeError('Market homes need a finite placement and the model quarter-turn rotation.');
+  }
+  const turn = ((turns % 4) + 4) % 4;
+  const cos = [1, 0, -1, 0][turn];
+  const sin = [0, 1, 0, -1][turn];
+  function localToWorld([u, v, s]: Point): Point {
+    return [x + cos * u + sin * s, level + v, -n - sin * u + cos * s];
+  }
+  function worldToLocal([east, height, z]: Point): Point {
+    return [cos * (east - x) - sin * (z + n), height - level, sin * (east - x) + cos * (z + n)];
+  }
+  function roomToWorld([u, v, s]: Point) {
+    return localToWorld([roomX + u, roomY + v, roomZ + s]);
+  }
+  function rampToWorld(ramp: Ramp): Ramp {
+    const bounds = boxAt(ramp, localToWorld);
+    if ((ramp.axis !== 'x' && ramp.axis !== 'z') || (ramp.ascending !== 1 && ramp.ascending !== -1)) {
+      throw new RangeError('Market home ramps need a local horizontal axis and direction.');
+    }
+    const axis = ramp.axis === 'x' ? 0 : 2;
+    if (ramp.min[axis] === ramp.max[axis]) throw new RangeError('Market home ramps need a nonzero run.');
+    const alongX = ramp.axis === 'x' ? cos : sin;
+    const alongZ = ramp.axis === 'x' ? -sin : cos;
+    return { ...bounds, axis: alongX ? 'x' : 'z', ascending: alongX + alongZ > 0 ? ramp.ascending : ramp.ascending === 1 ? -1 : 1 };
+  }
+
+  const authoredFloors = interior.group.userData.floors as Box[] | undefined;
+  const floor = authoredFloors?.[0];
+  const header = interior.colliders.find(({ min, max }) =>
+    min[0] === -marketHomeDoorHalfWidth && max[0] === marketHomeDoorHalfWidth &&
+    min[2] < interior.halfDepth && max[2] > interior.halfDepth && min[1] > bodyHeight);
+  if (!floor || authoredFloors?.length !== 1 || floor.max[1] !== 0 || !header) {
+    throw new RangeError('Market home interior is missing its authored floor or front header.');
+  }
+  const ceiling = header.max[1];
+  // These dimensions match the candidate's visible ceiling slab.
+  const ceilingBox: Box = {
+    min: [-interior.halfWidth - .15, ceiling, -interior.halfDepth - .14],
+    max: [interior.halfWidth + .15, ceiling + .16, interior.halfDepth + .14],
+  };
+  const colliders = [...interior.colliders, ceilingBox].map(box => boxAt(box, roomToWorld));
+  const floors = [boxAt(floor, roomToWorld)];
+  const ramps: Ramp[] = [];
+  for (const part of [options.shell, options.porch]) {
+    colliders.push(...(part?.colliders ?? []).map(box => boxAt(box, localToWorld)));
+    floors.push(...(part?.floors ?? []).map(box => boxAt(box, localToWorld)));
+    ramps.push(...(part?.ramps ?? []).map(rampToWorld));
+  }
+
+  const { group } = interior;
+  group.position.set(...roomToWorld([0, 0, 0]));
+  group.rotation.y = turns * quarterTurn;
+  group.updateMatrix();
+
+  // The candidate's first furniture collider bounds the visibly furnished worktop.
+  const desk = interior.colliders[0];
+  const deskX = (desk.min[0] + desk.max[0]) / 2;
+  const deskZ = (desk.min[2] + desk.max[2]) / 2;
+  const standX = deskX < 0 ? desk.max[0] + .55 : desk.min[0] - .55;
+  const approach = [{ x: 0, z: interior.halfDepth - .55 }, { x: 0, z: deskZ }, { x: standX, z: deskZ }];
+  const furnishingWitness = sampleMarketHomeWalk(approach, interior.colliders, interior.halfWidth, interior.halfDepth).blockedAt
+    ? undefined
+    : {
+        ...worldFeet(roomToWorld([standX, 0, deskZ])),
+        label: furnishingLabels[interior.theme],
+        target: worldFeet(roomToWorld([deskX, desk.max[1], deskZ])),
+        route: approach.map(point => worldFeet(roomToWorld([point.x, 0, point.z]))),
+      };
+
+  return {
+    group, colliders, floors, ramps, localToWorld, worldToLocal, furnishingWitness,
+    interiorFrontZ: roomZ + interior.halfDepth,
+    interiorBackZ: roomZ - interior.halfDepth,
+    interiorFloorY: level + roomY,
+  };
+}
+
+type MarketHomeWorldGeometry = ReturnType<typeof createMarketHomeWorldGeometry>;
+type EntranceAuditOptions = Readonly<{
+  doorX: number;
+  outsideZ: number;
+  /** Feet height reached by a separately walked porch route. Verified against its physical platform. */
+  outsideGround?: number;
+  insideZ: number;
+  surfaceAt(east: number, north: number): number | undefined;
+  porch?: MarketHomeWalkGeometry;
+}>;
+
+type EntranceSample = ReturnType<typeof worldFeet> & { support: 'terrain' | 'floor' | 'ramp' | 'solid' };
+
+/** Trace the door centre in both directions using the existing town controller's contact rules. */
+export function auditMarketHomeEntrance(world: MarketHomeWorldGeometry, options: EntranceAuditOptions) {
+  const invalid = (reason: 'invalid-route' | 'no-support' | 'step' | 'obstruction' | 'room-floor' | 'clearance') =>
+    ({ ok: false as const, reason });
+  const { doorX, outsideZ, outsideGround, insideZ, surfaceAt, porch } = options;
+  if (![doorX, outsideZ, insideZ].every(Number.isFinite) || outsideZ <= world.interiorFrontZ ||
+      insideZ >= world.interiorFrontZ - bodyRadius || insideZ <= world.interiorBackZ + bodyRadius) {
+    return invalid('invalid-route');
+  }
+  if (outsideGround !== undefined) {
+    if (!Number.isFinite(outsideGround)) return invalid('invalid-route');
+    const [x, , z] = world.localToWorld([doorX, 0, outsideZ]);
+    const hasPlatform = porch?.floors?.some(({ min, max }) =>
+      Math.abs(max[1] - outsideGround) <= comparisonEpsilon &&
+      x - bodyRadius >= min[0] && x + bodyRadius <= max[0] &&
+      z - bodyRadius >= min[2] && z + bodyRadius <= max[2]);
+    if (!hasPlatform) return invalid('no-support');
+  }
+  const colliders = [...world.colliders, ...(porch?.colliders ?? [])];
+  const floors = [...world.floors, ...(porch?.floors ?? [])];
+  const ramps = [...world.ramps, ...(porch?.ramps ?? [])];
+  const bodyBoxes = [...colliders, ...floors];
+  const localBoxes = bodyBoxes.map(box => boxAt(box, world.worldToLocal));
+  let minLeftClearance = Infinity;
+  let minRightClearance = Infinity;
+  let minHeadroom = Infinity;
+  let maxStep = 0;
+
+  function trace(from: number, to: number, firstFeet?: number) {
+    const steps = Math.ceil(Math.abs(from - to) / sampleSpacing);
+    const samples: EntranceSample[] = [];
+    let previous = firstFeet;
+    for (let i = 0; i <= steps; i++) {
+      const localZ = from + (to - from) * i / steps;
+      const [x, , z] = world.localToWorld([doorX, 0, localZ]);
+      const n = -z;
+      const terrain = surfaceAt(x, n);
+      if (terrain === undefined || !Number.isFinite(terrain)) return invalid('no-support');
+      const current = previous ?? terrain;
+      let ground = terrain;
+      let support: EntranceSample['support'] = 'terrain';
+      function useSupport(top: number, limit: number, kind: typeof support) {
+        if (top <= limit + comparisonEpsilon && top >= ground - comparisonEpsilon) {
+          ground = Math.max(ground, top);
+          support = kind;
+        }
+      }
+      for (const floor of floors) {
+        if (overlapsBody(x, z, floor)) useSupport(floor.max[1], current + stepHeight, 'floor');
+      }
+      for (const ramp of ramps) {
+        if (x < ramp.min[0] || x > ramp.max[0] || z < ramp.min[2] || z > ramp.max[2]) continue;
+        const axis = ramp.axis === 'x' ? 0 : 2;
+        const fraction = ((axis === 0 ? x : z) - ramp.min[axis]) / (ramp.max[axis] - ramp.min[axis]);
+        const top = ramp.min[1] + (ramp.max[1] - ramp.min[1]) * (ramp.ascending === 1 ? fraction : 1 - fraction);
+        useSupport(top, current + stepHeight, 'ramp');
+      }
+      for (const solid of colliders) {
+        if (overlapsBody(x, z, solid)) useSupport(solid.max[1], current + .03, 'solid');
+      }
+      const step = Math.abs(ground - current);
+      if (step > stepHeight + comparisonEpsilon) return invalid('step');
+      maxStep = Math.max(maxStep, step);
+      if (bodyBoxes.some(box => ground + surfaceEpsilon < box.max[1] &&
+          ground + bodyHeight - surfaceEpsilon > box.min[1] && overlapsBody(x, z, box))) {
+        return invalid('obstruction');
+      }
+      const [, feet] = world.worldToLocal([x, ground, z]);
+      for (const box of localBoxes) {
+        const { min, max } = box;
+        if (min[1] >= feet + surfaceEpsilon && overlapsBody(doorX, localZ, box)) {
+          minHeadroom = Math.min(minHeadroom, min[1] - feet);
+        }
+        if (localZ < min[2] || localZ > max[2] || feet + surfaceEpsilon >= max[1] ||
+            feet + bodyHeight - surfaceEpsilon <= min[1]) continue;
+        if (max[0] <= doorX) minLeftClearance = Math.min(minLeftClearance, doorX - max[0] - bodyRadius);
+        if (min[0] >= doorX) minRightClearance = Math.min(minRightClearance, min[0] - doorX - bodyRadius);
+      }
+      samples.push({ x, n, ground, support });
+      previous = ground;
+    }
+    return { ok: true as const, samples };
+  }
+
+  const forward = trace(outsideZ, insideZ, outsideGround);
