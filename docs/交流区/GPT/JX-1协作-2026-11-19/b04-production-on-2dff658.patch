@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Group, Raycaster, Vector3 } from 'three';
+import {
+  buildDistrictHousing, type DistrictMarketEntrance,
+} from '../tools/voxel-tavern/town-blockout/district-housing.ts';
+import { addDistrictHousing } from '../tools/voxel-tavern/town-blockout/district-layout.ts';
+import { addScenery } from '../tools/voxel-tavern/town-blockout/scenery.ts';
+import { createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain.ts';
+import { buildPineCamp } from '../tools/voxel-tavern/town-blockout/town-pine-camp.ts';
+import { createTownRailway } from '../tools/voxel-tavern/town-blockout/town-railway.ts';
+
+test('every original market shell has a bounded walk-through opening at the existing door', t => {
+  const originalDocument = globalThis.document;
+  globalThis.document = {
+    createElement: () => ({
+      getContext: () => ({
+        createRadialGradient: () => ({ addColorStop() {} }),
+        createLinearGradient: () => ({ addColorStop() {} }),
+        fillRect() {}, strokeRect() {}, fillText() {}, drawImage() {},
+      }),
+    }),
+  } as unknown as Document;
+  t.after(() => {
+    if (originalDocument) globalThis.document = originalDocument;
+    else Reflect.deleteProperty(globalThis, 'document');
+  });
+  const grid = createTerrainGrid();
+  const landscape = new Group();
+  const scenery = addScenery(landscape, grid, buildPineCamp(grid).keepClear);
+  const railway = createTownRailway(grid, () => 0);
+  const { housePortals, sites } = addDistrictHousing(landscape, grid, scenery.blocked, railway.keepClear);
+  const market = housePortals.flatMap((portal, index) =>
+    portal.zone === 'market' ? [{ portal, site: sites[index] }] : [],
+  );
+  assert.equal(market.length, 17);
+  for (const [index, { portal, site }] of market.entries()) {
+    const closed = buildDistrictHousing(site.style, site.w, site.d, site.variant, 'market', undefined, index);
+    const open = buildDistrictHousing(site.style, site.w, site.d, site.variant, 'market', undefined, index, true);
+    const entrance = open.userData.marketEntrance as DistrictMarketEntrance;
+    assert.equal(closed.userData.marketEntrance, undefined, portal.id);
+    assert.equal(open.userData.houseDoorEast, closed.userData.houseDoorEast, portal.id);
+    const { floorY, ...aperture } = entrance;
+    assert.deepEqual(aperture, { x: open.userData.houseDoorEast, frontZ: site.d / 2, width: 1.3, height: 2.2 }, portal.id);
+    assert.ok(Math.abs(floorY - .4065) < 1e-12, portal.id);
+    const trace = (target: Group, x: number, y: number, until = entrance.frontZ + 1.5) =>
+      new Raycaster(new Vector3(entrance.x + x, entrance.floorY + y, entrance.frontZ + 1.5),
+        new Vector3(0, 0, -1), 0, until).intersectObject(target, true);
+    assert.ok(trace(closed, 0, 1.63).length, portal.id);
+    for (const x of [-.64, 0, .64]) {
+      for (const y of [.01, .44, 1.63, 1.80, 2.19]) {
+        assert.equal(trace(open, x, y).length, 0, portal.id + ' interior ray ' + [x, y]);
+      }
+    }
+    for (const x of [-.67, .67]) assert.ok(trace(open, x, 1.63, 1.8).length, portal.id);
+    assert.ok(trace(open, 0, 2.22, 1.8).length, portal.id + ' lintel');
+
+    const findFloor = (z: number) =>
+      new Raycaster(new Vector3(entrance.x, .5, z), new Vector3(0, -1, 0), 0, .6)
+        .intersectObject(open, true)[0]?.point.y;
+    assert.ok(Math.abs((findFloor(entrance.frontZ - .05) ?? Infinity) - entrance.floorY) < .0001, portal.id);
+    assert.ok(Math.abs((findFloor(0) ?? Infinity) - .36) < .0001, portal.id + ' wood-floor recess');
+    assert.equal(findFloor(entrance.frontZ + .05), undefined, portal.id + ' replacement porch clear');
+  }
+});
+
+test('market entrance opt-in leaves nonmarket housing closed', () => {
+  for (const theme of ['forest', 'lakeside', 'memorial', undefined] as const) {
+    const house = buildDistrictHousing('shop', 9.2, 8.1, 1, theme, undefined, 0, true);
+    assert.equal(house.userData.marketEntrance, undefined, theme);
+  }
+});
