@@ -0,0 +1,181 @@
+import {
+  BoxGeometry, Color, Group, InstancedMesh, MeshBasicMaterial, MeshLambertMaterial, Object3D, type Texture,
+} from 'three';
+import type { Box } from './landmark-kit';
+import { setMarketHomeAtlas, type MarketHomeFinish } from './market-home-atlas';
+import {
+  buildMarketHomeFurnishings, type MarketHomePiece, type MarketHomeTheme,
+} from './market-home-furnishings';
+
+const profiles = {
+  'old-town:137:168': ['tea-table', '#ad6651'],
+  'old-town:158:184': ['pantry', '#648272'],
+  'old-town:179:155': ['linen', '#705b80'],
+  'old-town:173:135': ['ceramics', '#597986'],
+  'old-town:156:141': ['woodwork', '#a68059'],
+  'old-town:94:100': ['books', '#8d634e'],
+  'old-town:137:70': ['linen', '#947253'],
+  'old-town:188:65': ['tea-table', '#5e7975'],
+  'old-town:217:66': ['pantry', '#a35c63'],
+  'old-town:234:74': ['books', '#5c757c'],
+  'old-town:186:104': ['woodwork', '#7b6a8c'],
+  'old-town:206:110': ['ceramics', '#708251'],
+  'old-town:228:110': ['linen', '#a36056'],
+  'old-town:246:114': ['pantry', '#9c7553'],
+  'old-town:246:135': ['tea-table', '#88759a'],
+  'old-town:220:138': ['ceramics', '#6f8372'],
+  'old-town:197:132': ['books', '#a66e56'],
+} as const satisfies Record<string, readonly [MarketHomeTheme, string]>;
+
+export const marketHomeIds = Object.keys(profiles) as (keyof typeof profiles)[];
+export const marketHomeDoorHalfWidth = .65;
+export const isMarketHomeDoor = (id: string): id is keyof typeof profiles => Object.hasOwn(profiles, id);
+
+type MarketHomeWindowFinish = Readonly<{ tint: string; panes: 1 | 2 | 3 | 4 }>;
+const defaultWindowFinish: MarketHomeWindowFinish = { tint: '#ffc181', panes: 4 };
+
+export function buildMarketHomeInterior(
+  id: string,
+  width: number,
+  depth: number,
+  windowFinish = defaultWindowFinish,
+  atlas?: Texture,
+) {
+  if (!isMarketHomeDoor(id)) throw new RangeError('The door is outside the JX-1 roster.');
+  if (![width, depth].every(value => Number.isFinite(value) && value > 0)) {
+    throw new RangeError('Market homes need the surveyed shell dimensions.');
+  }
+  const [theme, accent] = profiles[id];
+  const arrangement = marketHomeIds.indexOf(id);
+  const halfWidth = Math.max(3.6, Math.min(5.3, width / 2 - .23));
+  const halfDepth = Math.max(3.6, Math.min(5.3, depth / 2 - .23));
+  const ceiling = 3.25 + (arrangement % 3) * .15;
+  const furniture = buildMarketHomeFurnishings({ theme, arrangement, halfWidth, halfDepth, accent });
+  const solid: MarketHomePiece[] = [...furniture.solid];
+  const glow: MarketHomePiece[] = [...furniture.glow];
+  const colliders: Box[] = [...furniture.colliders];
+  const floor = { min: [-halfWidth, -.17, -halfDepth], max: [halfWidth, 0, halfDepth] };
+  const beam = '#543b32';
+  const wall = '#c9ad83';
+  const trim = '#85624d';
+  const framing = .18;
+  const doorWidth = 2 * marketHomeDoorHalfWidth;
+  const doorHeight = 2.2;
+  function put(
+    x: number, y: number, z: number, width: number, height: number, depth: number,
+    color: string, finish: MarketHomeFinish = 'wood',
+  ) {
+    solid.push({ x, y, z, width, height, depth, color, finish });
+  }
+  function wallPart(x: number, y: number, z: number, width: number, height: number, depth: number, color = wall) {
+    put(x, y, z, width, height, depth, color, color === wall ? 'plaster' : 'wood');
+    colliders.push({
+      min: [x - width / 2, y, z - depth / 2],
+      max: [x + width / 2, y + height, z + depth / 2],
+    });
+  }
+
+  put(0, -.17, 0, halfWidth * 2, .15, halfDepth * 2, '#563f36');
+  const boards = ['#996746', '#8e5e41', '#aa7951', '#9e6e48'];
+  const plankCount = Math.ceil(2 * halfDepth / .47);
+  const plankDepth = 2 * halfDepth / plankCount;
+  for (let row = 0; row < plankCount; row++) {
+    const z = -halfDepth + (row + .5) * plankDepth;
+    const cut = (row % 4 - 1.5) * .38;
+    put((cut - halfWidth) / 2, -.02, z, halfWidth + cut, .02, plankDepth - .012, boards[(row + arrangement) % 4], 'plank');
+    put((cut + halfWidth) / 2, -.02, z, halfWidth - cut, .02, plankDepth - .012, boards[(row + arrangement + 1) % 4], 'plank');
+  }
+  for (const sign of [-1, 1]) {
+    wallPart(sign * (halfWidth + framing / 2), 0, 0, framing, ceiling, 2 * halfDepth + framing);
+    put(sign * (halfWidth - .034), .02, 0, .068, .28, 2 * halfDepth, trim);
+    const span = halfWidth - marketHomeDoorHalfWidth;
+    wallPart(sign * (marketHomeDoorHalfWidth + span / 2), 0, halfDepth, span, ceiling, framing);
+    put(sign * (marketHomeDoorHalfWidth + .055), 0, halfDepth - .12, .11, doorHeight + .12, .16, beam);
+  }
+  wallPart(0, doorHeight, halfDepth, doorWidth, ceiling - doorHeight, framing, beam);
+
+  // Match the rear pair in district-housing.ts themedFacing at the surveyed shell width.
+  const windowWidth = Math.min(1.7, width * .24);
+  const windowOffset = Math.min(width * .27, halfWidth - windowWidth / 2 - .18);
+  const windowY = 2;
+  const windowHeight = 1.36;
+  const windowBottom = windowY - windowHeight / 2;
+  const windowTop = windowY + windowHeight / 2;
+  const windowZ = -halfDepth;
+  function rearWallBetween(left: number, right: number) {
+    put((left + right) / 2, 0, windowZ, right - left, ceiling, framing, wall, 'plaster');
+  }
+
+  // Glazed openings are visual; the rear wall remains a closed player boundary.
+  colliders.push({
+    min: [-halfWidth, 0, windowZ - framing / 2],
+    max: [halfWidth, ceiling, windowZ + framing / 2],
+  });
+  let wallStart = -halfWidth;
+  for (const windowX of [-windowOffset, windowOffset]) {
+    const windowMin = windowX - windowWidth / 2;
+    const windowMax = windowX + windowWidth / 2;
+    rearWallBetween(wallStart, windowMin);
+    put(windowX, 0, windowZ, windowWidth, windowBottom, framing, wall, 'plaster');
+    put(windowX, windowTop, windowZ, windowWidth, ceiling - windowTop, framing, wall, 'plaster');
+    put(windowX, windowBottom - .19, windowZ + .07, windowWidth + .36, .14, .31, trim);
+    put(windowX, windowTop - .015, windowZ + .055, windowWidth + .18, .10, .18, beam);
+    glow.push({ x: windowX, y: windowBottom, z: windowZ, width: windowWidth,
+      height: windowHeight, depth: .035, color: windowFinish.tint });
+    for (let column = 0; column <= windowFinish.panes; column++) {
+      put(windowMin + column * windowWidth / windowFinish.panes, windowBottom - .025,
+        windowZ + .055, .065, windowHeight + .05, .11, beam);
+    }
+    if (windowFinish.panes > 1) put(windowX, windowY - .08, windowZ + .055, windowWidth, .083, .11, beam);
+    wallStart = windowMax;
+  }
+  rearWallBetween(wallStart, halfWidth);
+  put(0, ceiling, 0, halfWidth * 2 + .3, .16, halfDepth * 2 + .28, beam);
+  for (const z of [-halfDepth * .72, 0, halfDepth * .72]) {
+    put(0, ceiling - .21, z, halfWidth * 2, .24, .19, trim);
+  }
+  const group = new Group();
+  group.name = id;
+  const geometry = new BoxGeometry(1, 1, 1);
+  const wood = new MeshLambertMaterial();
+  const warmGlass = new MeshBasicMaterial();
+  if (atlas) setMarketHomeAtlas(geometry, wood, solid.map(({ finish }) => finish ?? 'wood'), atlas);
+  const instance = new Object3D();
+  const paint = new Color();
+  const warmTint = new Color(windowFinish.tint);
+  function batch(pieces: MarketHomePiece[], material: MeshLambertMaterial | MeshBasicMaterial, bakeWarmth: boolean) {
+    const mesh = new InstancedMesh(geometry, material, pieces.length);
+    pieces.forEach(({ x, y, z, width, height, depth, color }, index) => {
+      instance.position.set(x, y + height / 2, z);
+      instance.scale.set(width, height, depth);
+      instance.updateMatrix();
+      mesh.setMatrixAt(index, instance.matrix);
+      paint.set(color);
+      if (bakeWarmth) {
+        // Keep the window wash on the existing solid batch; moving or switching rooms changes no scene lights.
+        const distanceSquared = (Math.abs(x) - windowOffset) ** 2 + (y + height / 2 - windowY) ** 2 + (z - windowZ) ** 2;
+        paint.lerp(warmTint, .21 / (1 + distanceSquared * .28));
+      }
+      mesh.setColorAt(index, paint);
+    });
+    mesh.computeBoundingSphere();
+    group.add(mesh);
+    return mesh;
+  }
+  const batches = [batch(solid, wood, true), batch(glow, warmGlass, false)];
+  group.userData = { colliders, floors: [floor] };
+  let released = false;
+  return {
+    group, halfWidth, halfDepth, colliders, theme, categories: furniture.categories, accent,
+    dispose() {
+      if (released) return;
+      released = true;
+      group.removeFromParent();
+      group.clear();
+      for (const mesh of batches) mesh.dispose();
+      geometry.dispose();
+      wood.dispose();
+      warmGlass.dispose();
+    },
+  };
+}
diff --git a/tools/voxel-tavern/town-blockout/market-home-porch.ts b/tools/voxel-tavern/town-blockout/market-home-porch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f8430a2cf266c209ff5928a07568647513fc6ea9
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/market-home-porch.ts
@@ -0,0 +1,119 @@
+import type { Box } from './landmark-kit';
+import { townPhysicsDelta } from './town-physics-clock';
+
+const playerRadius = .27;
+const playerHeight = 1.8;
+const stepHeight = .43;
+const surfaceTolerance = .025;
+const treadRise = .40;
+const maximumStride = 11.3 * townPhysicsDelta;
+const minimumTreadRun = maximumStride + .001;
+const sweepSpacing = .045;
+
+type PorchSpec = {
+  doorX: number;
+  doorwayWidth: number;
+  wallZ: number;
+  streetZ: number;
+  insideZ: number;
+  floorY: number;
+  terrainAt(x: number, z: number): number;
+};
+
+type FootSample = {
+  z: number;
+  y: number;
+  support: 'terrain' | 'porch';
+};
+
+// Boxes are the actual solid meshes as well as the floors supplied to the town walk solver.
+// The porch is in house-local coordinates, with +Z facing the street.
+export function planMarketHomePorch({
+  doorX, doorwayWidth, wallZ, streetZ, insideZ, floorY, terrainAt,
+}: PorchSpec) {
+  if (![doorX, doorwayWidth, wallZ, streetZ, insideZ, floorY].every(Number.isFinite)) return;
+  if (doorwayWidth <= 2 * (playerRadius + surfaceTolerance) || insideZ >= wallZ) return;
+  const outerZ = streetZ - playerRadius - 2 * surfaceTolerance;
+  const run = outerZ - wallZ;
+  if (run < minimumTreadRun) return;
+  const entranceY = terrainAt(doorX, outerZ + playerRadius);
+  if (!Number.isFinite(entranceY) || entranceY > floorY + surfaceTolerance) return;
+  const risers = Math.max(1, Math.ceil((floorY - entranceY) / treadRise));
+  const interval = run / Math.max(1, risers - 1);
+  if (risers > 1 && interval < minimumTreadRun) return;
+  const left = doorX - doorwayWidth / 2;
+  const right = doorX + doorwayWidth / 2;
+  const floors: Box[] = [];
+  for (let i = 0; i < risers; i++) {
+    const highZ = outerZ - i * interval;
+    const lowZ = i === risers - 1 ? insideZ : outerZ - (i + 1) * interval;
+    const top = i === risers - 1 ? floorY : entranceY + (floorY - entranceY) * (i + 1) / risers;
+    // Let the visible block reach the site's lowest sampled ground rather than floating.
+    const ground = [left, doorX, right].flatMap(x =>
+      [lowZ, (lowZ + highZ) / 2, highZ].map(z => terrainAt(x, z)));
+    if (!ground.every(Number.isFinite)) return;
+    floors.push({ min: [left, Math.min(top - .12, ...ground) - .035, lowZ], max: [right, top, highZ] });
+  }
+
+  const distance = streetZ - insideZ;
+  const samples = Math.ceil(distance / sweepSpacing);
+  const path = Array.from({ length: samples + 1 }, (_, i) => streetZ - distance * i / samples);
+  // A foot disk starts and stops contacting each step at these exact transitions.
+  for (const { min, max } of floors) {
+    for (const contact of [min[2] - playerRadius, max[2] + playerRadius]) {
+      for (const offset of [-.00001, .00001]) {
+        const z = contact + offset;
+        if (z > insideZ && z < streetZ) path.push(z);
+      }
+    }
+  }
+  path.sort((a, b) => b - a);
+  function sweep(zs: number[], footX: number, startY: number, support: FootSample['support']) {
+    if (!Number.isFinite(startY)) return;
+    const trace: FootSample[] = [{ z: zs[0], y: startY, support }];
+    for (const z of zs.slice(1)) {
+      const previousY = trace.at(-1)!.y;
+      const terrain = terrainAt(footX, z);
+      const overlaps = floors.filter(({ min, max }) =>
+        Math.max(min[2] - z, z - max[2], 0) < playerRadius);
+      let y = terrain;
+      let source: FootSample['support'] = 'terrain';
+      for (const { max } of overlaps) {
+        if (max[1] <= previousY + stepHeight && max[1] >= y) {
+          y = max[1];
+          source = 'porch';
+        }
+      }
+      if (!Number.isFinite(y) || Math.abs(y - previousY) > stepHeight || overlaps.some(({ min, max }) =>
+        min[1] < y + playerHeight - surfaceTolerance && max[1] > y + surfaceTolerance)) return;
+      trace.push({ z, y, support: source });
+    }
+    return trace;
+  }
+
+  function walkBothWays(incoming: number[], outgoing: number[], footX: number) {
+    const streetY = terrainAt(footX, streetZ);
+    const inward = sweep(incoming, footX, streetY, 'terrain');
+    const outward = sweep(outgoing, footX, floorY, 'porch');
+    if (inward && outward && Math.abs(inward.at(-1)!.y - floorY) <= surfaceTolerance &&
+        Math.abs(outward.at(-1)!.y - streetY) <= surfaceTolerance) return { inward, outward };
+  }
+  const paths = walkBothWays(path, [...path].reverse(), doorX);
+  if (!paths) return;
+
+  // Recheck the center and nearby lanes against the largest normal physics update.
+  // A phase offset catches two stair nosings falling into the same update.
+  const offset = Math.min(.12, doorwayWidth / 2 - playerRadius - surfaceTolerance);
+  for (const phase of [.25, .5, .75, 1]) {
+    const strides = [0];
+    for (let traveled = maximumStride * phase; traveled < distance; traveled += maximumStride) strides.push(traveled);
+    strides.push(distance);
+    const incoming = strides.map(traveled => streetZ - traveled);
+    const outgoing = strides.map(traveled => insideZ + traveled);
+    for (const footX of [doorX - offset, doorX, doorX + offset]) {
+      if (!walkBothWays(incoming, outgoing, footX)) return;
+    }
+  }
+
+  return { floors, paths, streetY: paths.inward[0].y, floorY };
+}
diff --git a/tools/voxel-tavern/town-blockout/market-home-visit.ts b/tools/voxel-tavern/town-blockout/market-home-visit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2139b9ffec5d50eadde1005a4e8b1cde8b8e9995
--- /dev/null
+++ b/tools/voxel-tavern/town-blockout/market-home-visit.ts
@@ -0,0 +1,61 @@
+import { BoxGeometry, Group, InstancedMesh, MeshLambertMaterial, Object3D, type Texture } from 'three';
+import { marketVisitDoorway } from './district-housing';
+import type { DistrictMarketHomeAnchor, DistrictMarketHomeDoorway, DistrictMarketHomeLot } from './district-layout';
+import type { Box } from './landmark-kit';
+import { buildMarketHomeInterior } from './market-home-interior';
+import { planMarketHomePorch } from './market-home-porch';
+
+// Add a survey here after the house passes the B-04 first-person and clearance checks.
+export const verifiedMarketHomes: readonly DistrictMarketHomeAnchor[] = [];
+
+function buildMarketHomeVisit(lot: DistrictMarketHomeLot, atlas?: Texture) {
+  const { x, n, w, d, level, angle, portal, windowFinish, toWorldBox } = lot;
+  const room = buildMarketHomeInterior(portal.id, w, d, windowFinish, atlas);
+  const sine = Math.round(Math.sin(angle));
+  const cosine = Math.round(Math.cos(angle));
+  const wallZ = d / 2;
+  const plan = planMarketHomePorch({
+    doorX: 0,
+    doorwayWidth: marketVisitDoorway.halfWidth * 2,
+    wallZ,
+    streetZ: wallZ + 1.42,
+    insideZ: room.halfDepth - .12,
+    floorY: marketVisitDoorway.floorY,
+    terrainAt: (localX, localZ) => lot.heightAt(x + localX * cosine + localZ * sine,
+      n + localX * sine - localZ * cosine) - level,
+  });
+  if (!plan) {
+    room.dispose();
+    return undefined;
+  }
+
+  const group = new Group();
+  group.name = `market-home-visit:${portal.id}`;
+  group.position.set(x, level, -n);
+  group.rotation.y = angle;
+  group.add(room.group);
+
+  const step = new Object3D();
+  const treads = new InstancedMesh(new BoxGeometry(1, 1, 1), new MeshLambertMaterial({ color: '#716b69' }), plan.floors.length);
+  for (const [index, { min, max }] of plan.floors.entries()) {
+    step.position.set((min[0] + max[0]) / 2, (min[1] + max[1]) / 2, (min[2] + max[2]) / 2);
+    step.scale.set(max[0] - min[0], max[1] - min[1], max[2] - min[2]);
+    step.updateMatrix();
+    treads.setMatrixAt(index, step.matrix);
+  }
+  treads.computeBoundingSphere();
+  group.add(treads);
+  const roomFloors = room.group.userData.floors as Box[];
+  return {
+    group,
+    floors: [...plan.floors, ...roomFloors].map(toWorldBox),
+    colliders: room.colliders.map(toWorldBox),
+  };
+}
+
+export function createMarketHomeDoorways(homes: readonly DistrictMarketHomeAnchor[], atlas?: Texture) {
+  return new Map<string, DistrictMarketHomeDoorway>(homes.map(expected => [expected.portal.id, {
+    expected,
+    build: lot => buildMarketHomeVisit(lot, atlas),
+  }]));
+}
