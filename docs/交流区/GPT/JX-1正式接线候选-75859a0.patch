diff --git a/tests/town-blockout-market-home-porch.test.ts b/tests/town-blockout-market-home-porch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..002c4fd8f8be4bd8dc7f4e047afa08281f9a5241
--- /dev/null
+++ b/tests/town-blockout-market-home-porch.test.ts
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createTerrainGrid } from '../tools/voxel-tavern/town-blockout/terrain.ts';
+import { planMarketHomePorch } from '../tools/voxel-tavern/town-blockout/market-home-porch.ts';
+
+const fixture = { doorX: 0, doorwayWidth: 1.3, wallZ: 4, streetZ: 5.42, insideZ: 3.34, floorY: 0 };
+
+test('a measured steep market lot keeps its original street feet and reaches the existing floor', () => {
+  const { heightAt } = createTerrainGrid();
+  const width = 9.2;
+  const depth = 8.1;
+  const terrain = (x: number, z: number) => heightAt(137 + z, 168 + x);
+  const levels = [-1, 0, 1].flatMap(x =>
+    [-1, 0, 1].map(z => terrain(x * (width / 2 + 1), z * (depth / 2 + 1))));
+  const base = Math.max(...levels) + .14;
+  const wallZ = depth / 2;
+  const streetZ = wallZ + 1.42;
+  const porch = planMarketHomePorch({
+    ...fixture, wallZ, streetZ, terrainAt: (x, z) => terrain(x, z) - base,
+  });
+  assert.ok(porch);
+  assert.equal(+(porch.streetY + base).toFixed(4), 13.5213);
+  assert.equal(porch.floors.length, 6);
+  for (const [index, { min, max }] of porch.floors.entries()) {
+    assert.deepEqual([min[0], max[0]], [-.65, .65]);
+    assert.ok(max[2] - min[2] >= .19);
+    assert.ok(min[1] < max[1]);
+    assert.ok(max[2] <= streetZ - .27);
+    if (index) assert.equal(max[2], porch.floors[index - 1].min[2]);
+  }
+  assert.equal(porch.floors.at(-1)!.min[2], fixture.insideZ);
+  assert.equal(porch.paths.inward[0].support, 'terrain');
+  assert.equal(porch.paths.inward.at(-1)!.support, 'porch');
+  assert.equal(porch.paths.inward.at(-1)!.y, 0);
+  assert.equal(porch.paths.outward.at(-1)!.y, porch.streetY);
+  for (const trace of [porch.paths.inward, porch.paths.outward]) {
+    for (let i = 1; i < trace.length; i++) {
+      assert.ok(Math.abs(trace[i].y - trace[i - 1].y) < .34);
+    }
+  }
+});
+
+test('a level short staircase uses a single visible landing bridging a clipped room floor', () => {
+  const porch = planMarketHomePorch({ ...fixture, terrainAt: () => -.18 });
+  assert.ok(porch);
+  assert.equal(porch.floors.length, 1);
+  assert.equal(porch.floors[0].min[2], fixture.insideZ);
+  assert.equal(porch.floors[0].max[1], fixture.floorY);
+  assert.equal(porch.paths.outward[0].y, fixture.floorY);
+  assert.equal(porch.paths.outward.at(-1)!.y, -.18);
+});
+
+test('the porch stays closed when even the largest legal steps cannot cover the street drop', () => {
+  assert.equal(planMarketHomePorch({ ...fixture, terrainAt: () => -5 }), undefined);
+  assert.equal(planMarketHomePorch({ ...fixture, doorwayWidth: .59, terrainAt: () => -.18 }), undefined);
+  assert.equal(planMarketHomePorch({ ...fixture, terrainAt: () => Number.NaN }), undefined);
+});
+
+test('an intervening terrain ridge rejects an otherwise small street to floor difference', () => {
+  const terrainAt = (_: number, z: number) => -.28 + .8 * Math.max(0, 1 - 10 * Math.abs(z - 4.7));
+  assert.equal(planMarketHomePorch({ ...fixture, terrainAt }), undefined);
+});
