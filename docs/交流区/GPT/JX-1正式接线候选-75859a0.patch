@@ -0,0 +1,70 @@
+import {
+  CanvasTexture, InstancedBufferAttribute, NearestFilter, ShaderChunk, SRGBColorSpace,
+  type BoxGeometry, type MeshLambertMaterial, type Texture,
+} from 'three';
+import { makeVoxelTexture } from '../textures';
+
+const surfaceFinishes = ['plaster', 'plank', 'wood'] as const;
+const finishes = [...surfaceFinishes, 'cloth', 'ceramic', 'book'] as const;
+export type MarketHomeFinish = typeof finishes[number];
+const tileSize = 16;
+const gutter = 1;
+const stride = tileSize + 2 * gutter;
+const atlasWidth = finishes.length * stride;
+
+export async function createMarketHomeAtlas() {
+  const images = await Promise.all(finishes.map(finish => makeVoxelTexture(finish, '#dedede')));
+  const canvas = document.createElement('canvas');
+  canvas.width = atlasWidth;
+  canvas.height = stride;
+  const ink = canvas.getContext('2d');
+  if (!ink) throw new Error('Could not create the market home material atlas.');
+  ink.imageSmoothingEnabled = false;
+  for (const [index, image] of images.entries()) {
+    ink.drawImage(image, index * stride + gutter, gutter);
+  }
+  const atlas = new CanvasTexture(canvas);
+  atlas.colorSpace = SRGBColorSpace;
+  atlas.magFilter = atlas.minFilter = NearestFilter;
+  atlas.generateMipmaps = false;
+  return atlas;
+}
+
+/** The host owns the atlas. A room only owns its instance attribute and material. */
+export function setMarketHomeAtlas(
+  geometry: BoxGeometry,
+  material: MeshLambertMaterial,
+  pieceFinishes: readonly MarketHomeFinish[],
+  atlas: Texture,
+) {
+  geometry.setAttribute('marketHomeTile', new InstancedBufferAttribute(
+    Float32Array.from(pieceFinishes, finish => finishes.indexOf(finish)),
+    1,
+  ));
+  material.map = atlas;
+  material.onBeforeCompile = shader => {
+    const varying = 'varying vec3 vMarketHomeTileAndRepeat;\n';
+    // BoxGeometry aligns U with Z on X faces and V with Z on Y faces.
+    shader.vertexShader = 'attribute float marketHomeTile;\n' + varying + shader.vertexShader.replace(
+      '#include <uv_vertex>', `#include <uv_vertex>
+#ifdef USE_MAP
+  vec3 size = vec3(length(instanceMatrix[0].xyz), length(instanceMatrix[1].xyz), length(instanceMatrix[2].xyz));
+  vec2 faceSize = vec2(normal.x == 0.0 ? size.x : size.z, normal.y == 0.0 ? size.y : size.z);
+  vec2 repeat = marketHomeTile < ${surfaceFinishes.length.toFixed(1)} ? max(faceSize / 2.0, vec2(1.0)) : vec2(1.0);
+  vMarketHomeTileAndRepeat = vec3(marketHomeTile, repeat);
+#endif`,
+    );
+    shader.fragmentShader = varying + shader.fragmentShader.replace(
+      '#include <map_fragment>', `#ifdef USE_MAP
+  vec2 repeat = vMarketHomeTileAndRepeat.yz;
+  vec2 scaled = clamp(vMapUv, 0.0, 1.0) * repeat;
+  vec2 tileUV = mix(scaled, fract(scaled), step(vec2(1.001), repeat));
+  vec2 tilePixel = vec2(vMarketHomeTileAndRepeat.x * ${stride.toFixed(1)}, 0.0)
+    + vec2(${(gutter + .5).toFixed(1)}) + tileUV * ${(tileSize - 1).toFixed(1)};
+  vec2 marketHomeMapUv = tilePixel / vec2(${atlasWidth.toFixed(1)}, ${stride.toFixed(1)});
+#endif
+${ShaderChunk.map_fragment.replace('vMapUv', 'marketHomeMapUv')}`,
+    );
+  };
+  material.customProgramCacheKey = () => 'market-home-material-atlas-surface-repeat';
+}
diff --git a/tools/voxel-tavern/town-blockout/market-home-furnishings.ts b/tools/voxel-tavern/town-blockout/market-home-furnishings.ts
